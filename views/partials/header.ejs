<header class="py-2 mb-4">
  <%- include('brandData') %>
  <%- include('roleData') %>
  <nav class="navbar navbar-expand-lg navbar-light site-navbar shadow-sm">
    <div class="container-fluid">

      <!-- Brand — always far left -->
      <a class="navbar-brand d-flex align-items-center" href="/">
        <i class="fa-solid fa-car-side me-1"></i>
        <%= brand.siteName %>
      </a>

      <!-- Mobile: banner sits here, outside the collapse, below brand row -->
      <% const navState = nav || {}; %>
      <% if (navState.showDraftBanner) { %>
        <div class="draft-banner-nav d-lg-none w-100 mt-1 mb-1 order-3">
          <a href="/continue-registration/auto" class="draft-banner-link">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            Unfinished profile — click here
          </a>
        </div>
      <% } %>

      <!-- Hamburger -->
      <button class="navbar-toggler order-2" type="button"
              data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Collapsible content -->
      <div class="collapse navbar-collapse" id="mainNav">
        <%
          const showUpgrade         = navState.canUpgrade;
          const showContinueReg     = navState.showContinueRegistration;
          // Shared counting accounts get /counts only (phase 3d-6: by permission, not role).
          const isCounting          = navState.isCountingAccount === true;
          const showMyAccount       = navState.isLoggedIn && !isCounting;
          const showAccountDropdown = showUpgrade || showContinueReg || showMyAccount;

          // Every menu item shows when the person holds the permission its page needs
          // (res.locals.can, the person's positions, fresh on every page load; phase 3d).
          const has             = (key) => typeof can === 'function' && can(key);
          const hasAny          = (...keys) => keys.some((k) => has(k));

          // One flag per Operations group; the Operations menu shows when any group does.
          const navDocs         = hasAny('maps.view', 'schedules.view', 'lessons.viewAll');
          const navComms        = hasAny('campaigns.send', 'volunteers.sendSignInLinks');
          const navVolunteers   = hasAny('volunteers.edit', 'volunteers.create', 'positions.assign', 'notes.view');
          const navConvention   = has('lessons.submit');
          const navReports      = has('volunteers.viewReports');
          const navSigns        = hasAny('signs.view', 'signs.manage');
          const navScheduling   = hasAny('shifts.manage', 'locations.manage', 'eventTypes.manage',
                                         'crews.assign', 'scheduler.use', 'scheduler.manageRules',
                                         'alerts.manageShiftAlerts', 'alerts.manageCapacityAlerts');
          const navAttendance   = hasAny('attendance.checkIn', 'attendance.viewReports');
          const navCounts       = has('counts.log');
          const navDecently     = has('decently.run');
          const navSystemVars   = has('systemVariables.manage');
          const navAdmin        = hasAny('positions.manage', 'structure.manage') || navSystemVars;
          const navOperations   = navDocs || navComms || navVolunteers || navConvention || navReports || navSigns
                                  || navScheduling || navAttendance || navCounts || navDecently || navAdmin;
        %>

        <!-- Nav items — left side, spread with auto margins -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="fa-solid fa-house me-1"></i>
              Home
            </a>
          </li>

          <% if (navState.isLoggedIn && !isCounting) { %>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="resourcesDropdown"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-folder-open me-1"></i>
                Resources
              </a>
              <ul class="dropdown-menu" aria-labelledby="resourcesDropdown">
                <% if (has('self.viewSchedule')) { %>
                <li>
                  <a class="dropdown-item" href="/my-schedule">
                    <i class="fa-solid fa-calendar-check me-1"></i>
                    My Schedule
                  </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <% } %>
                <% if (has('maps.view')) { %>
                <li>
                  <a class="dropdown-item" href="/maps">
                    <i class="fa-solid fa-map me-1"></i>
                    Maps
                  </a>
                </li>
                <% } %>

                <% if (has('signs.view')) { %>
                <li>
                  <a class="dropdown-item" href="/signs">
                    <i class="fa-solid fa-signs-post me-1"></i>
                    Sign Library
                  </a>
                </li>
                <% } %>
                <% if (has('schedules.view')) { %>
                <li>
                  <a class="dropdown-item" href="/schedules">
                    <i class="fa-regular fa-calendar-days me-1"></i>
                    Schedules
                  </a>
                </li>
                <% } %>
                <% if (navCounts) { %>
                <li>
                  <a class="dropdown-item" href="/counts">
                    <i class="fa-solid fa-hand-pointer me-1"></i>
                    Parking Counter
                  </a>
                </li>
                <% } %>
                <% if (has('lessons.viewAll')) { %>
                <li><hr class="dropdown-divider" /></li>
                <li>
                  <a class="dropdown-item" href="/lessons-learned">
                    <i class="fa-solid fa-lightbulb me-1"></i>
                    Lessons Learned
                  </a>
                </li>
                <% } %>
              </ul>
            </li>

            

            <% if (navOperations) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="oversightDropdown"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false"
                 data-bs-auto-close="outside">
                <i class="fa-solid fa-screwdriver-wrench me-1"></i>
                Operations
              </a>
              <ul class="dropdown-menu ot-nav-dropdown" aria-labelledby="oversightDropdown">

                <%# ── All Tools ─────────────────────────────────── %>
                <li>
                  <a class="dropdown-item ot-nav-all-tools" href="/oversight/tools">
                    <i class="fa-solid fa-table-cells-large me-2"></i>All Tools
                  </a>
                </li>

                <% if (navDocs) { %>
                <%# ── Docs ────────────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavDocs" aria-expanded="false">
                    <span><i class="fa-solid fa-folder-open me-2"></i>Docs</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavDocs">
                    <ul class="ot-nav-items">
                      <% if (has('maps.view')) { %>
                        <li><a class="ot-nav-item" href="/maps">
                          <i class="fa-solid fa-map"></i>Maps
                        </a></li>
                      <% } %>
                      <% if (has('schedules.view')) { %>
                        <li><a class="ot-nav-item" href="/schedules">
                          <i class="fa-solid fa-calendar-check"></i>Schedules
                        </a></li>
                      <% } %>
                      <% if (has('lessons.viewAll')) { %>
                        <li><a class="ot-nav-item" href="/lessons-learned">
                          <i class="fa-solid fa-lightbulb"></i>Lessons Learned
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navComms) { %>
                <%# ── Communications ─────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavComms" aria-expanded="false">
                    <span><i class="fa-solid fa-paper-plane me-2"></i>Communications</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavComms">
                    <ul class="ot-nav-items">
                      <% if (has('campaigns.send')) { %>
                      <li><a class="ot-nav-item" href="/oversight/tools/campaigns">
                        <i class="fa-solid fa-envelope-open-text"></i>Campaign Center
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/campaigns/tracker">
                        <i class="fa-solid fa-chart-gantt"></i>Invitation Tracker
                      </a></li>
                      <% } %>
                      <% if (has('volunteers.sendSignInLinks')) { %>
                      <li><a class="ot-nav-item" href="/oversight/tools/send-reset">
                        <i class="fa-solid fa-link"></i>Send Reset Link
                      </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navVolunteers) { %>
                <%# ── Volunteer Management ────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavVolunteers" aria-expanded="false">
                    <span><i class="fa-solid fa-users me-2"></i>Volunteer Management</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavVolunteers">
                    <ul class="ot-nav-items">
                      <% if (has('volunteers.edit')) { %>
                        <li><a class="ot-nav-item" href="/editVolunteer">
                          <i class="fa-solid fa-id-card"></i>Edit Volunteer
                        </a></li>
                      <% } %>
                      <% if (has('volunteers.create')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/create-volunteer">
                          <i class="fa-solid fa-user-plus"></i>Create Volunteer
                        </a></li>
                      <% } %>
                      <% if (has('positions.assign')) { %>
                        <li><a class="ot-nav-item" href="/oversight/roles">
                          <i class="fa-solid fa-user-shield"></i>Role Management
                        </a></li>
                      <% } %>
                      <% if (has('notes.view')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/notes-report">
                          <i class="fa-solid fa-note-sticky"></i>Notes Report
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

<% if (navConvention) { %>
                <%# ── Convention ─────────────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavConvention" aria-expanded="false">
                    <span><i class="fa-solid fa-book-open me-2"></i>Convention</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavConvention">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/lessons-learned">
                        <i class="fa-solid fa-book-open"></i>Lessons Learned
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

<% if (navReports) { %>
                <%# ── Reports ─────────────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavReports" aria-expanded="false">
                    <span><i class="fa-solid fa-chart-bar me-2"></i>Reports</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavReports">
                    <ul class="ot-nav-items">
                      <li class="ot-nav-group-label">Volunteers</li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=app-status">
                        <i class="fa-solid fa-clipboard-list"></i>Application Status
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=demographics">
                        <i class="fa-solid fa-chart-pie"></i>Demographics
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=target-levels">
                        <i class="fa-solid fa-bullseye"></i>Target Levels
                      </a></li>
                      <li class="ot-nav-group-label">Crews</li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=staff-usage">
                        <i class="fa-solid fa-layer-group"></i>Staff Usage
                      </a></li>
                      <li class="ot-nav-group-label">Event Day</li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=crew-attendance">
                        <i class="fa-solid fa-clipboard-check"></i>Crew Attendance
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=day-staffing">
                        <i class="fa-solid fa-people-arrows"></i>Day Staffing
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/reports?tab=garage-capacity">
                        <i class="fa-solid fa-warehouse"></i>Garage Capacity
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navSigns) { %>
                <%# ── Signs %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavSigns" aria-expanded="false">
                    <span><i class="fa-solid fa-signs-post me-2"></i>Signs</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavSigns">
                    <ul class="ot-nav-items">
                      <% if (has('signs.view')) { %>
                        <li><a class="ot-nav-item" href="/signs">
                          <i class="fa-solid fa-table-list"></i>Sign Library
                        </a></li>
                      <% } %>
                      <% if (has('signs.manage')) { %>
                        <li><a class="ot-nav-item" href="/signs/builder">
                          <i class="fa-solid fa-pen-to-square"></i>Sign Builder
                        </a></li>
                      <% } %>
                      <% if (has('signs.view')) { %>
                        <li><a class="ot-nav-item" href="/signs/map">
                          <i class="fa-solid fa-map-location-dot"></i>Sign Map
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navScheduling) { %>
                <%# ── Scheduling ──────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavScheduling" aria-expanded="false">
                    <span><i class="fa-regular fa-calendar-days me-2"></i>Scheduling</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavScheduling">
                    <ul class="ot-nav-items">
                      <% if (has('shifts.manage')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/timelines">
                          <i class="fa-regular fa-clock"></i>Timelines
                        </a></li>
                      <% } %>
                      <% if (has('locations.manage')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/locationsAndTasks">
                          <i class="fa-solid fa-map-pin"></i>Locations
                        </a></li>
                      <% } %>
                      <% if (has('eventTypes.manage')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/timelines/event-types">
                          <i class="fa-solid fa-tags"></i>Event Types
                        </a></li>
                      <% } %>
                      <% if (has('crews.assign')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/crew-assignments">
                          <i class="fa-solid fa-people-group"></i>Crew Assignments
                        </a></li>
                      <% } %>
                      <% if (has('scheduler.use')) { %>
                       <li><a class="ot-nav-item" href="/oversight/tools/scheduler">
                        <i class="fa-solid fa-calendar-days"></i>Scheduler
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/conflict-grid">
                        <i class="fa-solid fa-table-cells"></i>Conflict Grid
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/volunteer-schedule">
                        <i class="fa-solid fa-calendar-check"></i>Volunteer Schedule
                      </a></li>
                      <% } %>
                      <% if (has('scheduler.manageRules')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/schedule-rules">
                          <i class="fa-solid fa-list-check"></i>Schedule Analysis Rules
                        </a></li>
                      <% } %>
                      <% if (has('alerts.manageShiftAlerts')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/shift-alerts">
                          <i class="fa-solid fa-bell"></i>Shift Alerts
                        </a></li>
                      <% } %>
                      <% if (has('alerts.manageCapacityAlerts')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/capacity-alerts">
                          <i class="fa-solid fa-warehouse"></i>Capacity Alerts
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navAttendance) { %>
                <%# ── Attendance ───────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavAttendance" aria-expanded="false">
                    <span><i class="fa-solid fa-clipboard-check me-2"></i>Attendance</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavAttendance">
                    <ul class="ot-nav-items">
                      <% if (has('attendance.checkIn')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/attendance/checkin">
                          <i class="fa-solid fa-clipboard-check"></i>Check-In Tool
                        </a></li>
                      <% } %>
                      <% if (has('attendance.viewReports')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/attendance/report">
                          <i class="fa-solid fa-chart-bar"></i>Attendance Report
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navCounts) { %>
                <%# ── Counts ──────────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavCounts" aria-expanded="false">
                    <span><i class="fa-solid fa-car me-2"></i>Counts</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavCounts">
                    <ul class="ot-nav-items">
                      <% if (navCounts) { %>
                        <li><a class="ot-nav-item" href="/counts">
                          <i class="fa-solid fa-hand-pointer"></i>Parking Counter
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navDecently) { %>
                <%# ── Decently Sync ───────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavDecently" aria-expanded="false">
                    <span><i class="fa-solid fa-rotate me-2"></i>Decently Sync</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavDecently">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/decently-export">
                        <i class="fa-solid fa-file-export"></i>Export to Decently
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/decently-import">
                        <i class="fa-solid fa-file-import"></i>Import from Decently
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (navAdmin) { %>
                <%# ── Administration ─────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavAdmin" aria-expanded="false">
                    <span><i class="fa-solid fa-gear me-2"></i>Administration</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse" id="otNavAdmin">
                    <ul class="ot-nav-items">
                      <% if (has('positions.manage')) { %>
                      <li><a class="ot-nav-item" href="/oversight/tools/permissions">
                        <i class="fa-solid fa-sliders"></i>Permission Matrix
                      </a></li>
                      <% } %>
                      <% if (has('structure.manage')) { %>
                      <li><a class="ot-nav-item" href="/oversight/tools/oversightstructure">
                        <i class="fa-solid fa-sitemap"></i>Oversight Structure
                      </a></li>
                      <% } %>
                      <% if (navSystemVars) { %>
                      <li><a class="ot-nav-item" href="/oversight/tools/system-variables">
                        <i class="fa-solid fa-database"></i>System Variables
                      </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

              </ul>
            </li>
            <% } %>

          <% } %>

        </ul>

        <!-- Desktop banner — between nav items and right controls -->
        <% if (navState.showDraftBanner) { %>
          <div class="draft-banner-nav d-none d-lg-flex me-3">
            <a href="/continue-registration/auto" class="draft-banner-link">
              <i class="fa-solid fa-triangle-exclamation me-1"></i>
              Unfinished profile — click here
            </a>
          </div>
        <% } %>

        <!-- Right-aligned nav: My Account dropdown + logout + avatar -->
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center nav-cta-container">

          <% if (!navState.isLoggedIn) { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">
                <i class="fa-solid fa-right-to-bracket"></i>
                Login
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/create-profile">
                <i class="fa-solid fa-user-plus me-1"></i>Create Profile
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/upgrade">
                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                Upgrade Account
              </a>
            </li>
          <% } %>

          <% if (navState.isLoggedIn) { %>

            <%- include('departmentSwitcher') %>

            <% if (showAccountDropdown) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="accountDropdownRight"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-user me-1"></i>
                My Account
              </a>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdownRight">
                <% if (showContinueReg) { %>
                  <li>
                    <a class="dropdown-item" href="/continue-registration/auto">
                      <i class="fa-solid fa-forward-step me-1"></i>
                      Continue Registration
                    </a>
                  </li>
                <% } %>
                <% if (showMyAccount) { %>
                  <li>
                    <a class="dropdown-item" href="/my-account">
                      <i class="fa-solid fa-id-card me-1"></i>
                      My Account
                    </a>
                  </li>
                  <% if (has('self.viewSchedule')) { %>
                  <li>
                    <a class="dropdown-item" href="/my-schedule">
                      <i class="fa-solid fa-calendar-check me-1"></i>
                      My Schedule
                    </a>
                  </li>
                  <% } %>
                <% } %>
              </ul>
            </li>
            <% } %>

            <li class="nav-item">
              <form action="/logout" method="POST" class="d-inline">
                <button type="submit" class="nav-link btn btn-link p-0">
                  <i class="fa-solid fa-right-from-bracket"></i>
                  Logout
                </button>
              </form>
            </li>

          <% } %>

          <li class="nav-item ms-2 d-none" id="tourTriggerItem">
            <button type="button" class="btn btn-sm ajwp-tour-trigger" id="tourTriggerBtn">
              <i class="fa-solid fa-circle-question me-1"></i>Tour
            </button>
          </li>

          <li class="nav-item ms-2">
            <div class="nav-avatar"
