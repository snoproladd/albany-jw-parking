<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Review Your Information</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css">

    <!-- Site styles -->
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    >
  </head>

  <!-- Centered card, no site header -->
  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary">

    <main class="container" id="formSummaryRoot">

      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">

          <section id="summary-card" class="card shadow-lg mx-auto">

            <header class="card-header text-center">
              <h1 class="h2 my-2">Review Your Information</h1>
              <p class="mb-0">
                Edit any section below, then confirm to finish your registration.
              </p>
            </header>

            <div class="card-body">

              <% if (!volunteer) { %>
                <div class="alert alert-warning" role="alert">
                  We couldn't find registration data for your session. Please restart the registration.
                </div>
                <a href="/email-password" class="btn btn-primary">
                  Restart Registration
                </a>

              <% } else { %>

                <% 
                  // Parse congregation if not assigned
                  let visitingCity = '';
                  let visitingState = '';
                  let visitingLang = '';
                  if (volunteer.assignedToConv === false && volunteer.congregation) {
                    const raw = volunteer.congregation;
                    const dashIndex = raw.lastIndexOf('-');
                    if (dashIndex !== -1) {
                      const left = raw.slice(0, dashIndex).trim();
                      visitingLang = raw.slice(dashIndex + 1).trim();
                      const commaIndex = left.lastIndexOf(',');
                      if (commaIndex !== -1) {
                        visitingCity = left.slice(0, commaIndex).trim();
                        visitingState = left.slice(commaIndex + 1).trim();
                      } else {
                        visitingCity = left;
                      }
                    }
                  }

                  // DOB <input type="date">
                  let dobValue = '';
                  if (volunteer.dobirth) {
                    const d = new Date(volunteer.dobirth);
                    if (!isNaN(d.valueOf())) {
                      const y = d.getFullYear();
                      const m = String(d.getMonth() + 1).padStart(2, '0');
                      const day = String(d.getDate()).padStart(2, '0');
                      dobValue = `${y}-${m}-${day}`;
                    }
                  }
                %>

                <!-- Entire summary form -->
                <form action="/submitSummary" id="summary-form" method="POST" novalidate>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" id="summary-csrf" value="<%= csrfToken %>">
                  <input type="hidden" id="summary-gender" value="<%= gender || (volunteer.gender || '') %>">

                  <!-- Privilege rule JSON -->
                  <% if (privilegeRulesJSON) { %>
                    <script id="privilege-rules-json" type="application/json">
                      <%- privilegeRulesJSON %>
                    </script>
                  <% } %>

                  <!-- Accordion -->
                  <div class="accordion" id="summaryAccordion">

                    <!-- CONTACT -->
                    <div class="accordion-item">
                      <h2 class="accordion-header" id="headingContact">
                        <button class="accordion-button"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapseContact"
                          aria-expanded="true"
                          aria-controls="collapseContact">
                          Contact
                        </button>
                      </h2>

                      <div id="collapseContact" class="accordion-collapse collapse show">
                        <div class="accordion-body">

                          <div class="d-flex justify-content-end mb-2">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm summary-edit-btn"
                              data-section="contact">
                              EDIT
                            </button>
                          </div>

                          <div class="row row-cols-1 row-cols-md-2 g-3">
                            <!-- firstName -->
                            <div class="col">
                              <label class="form-label small">First Name</label>
                              <input type="text" 
                                name="firstName"
                                id="firstName"
                                class="form-control"
                                value="<%= volunteer.firstName || '' %>"
                                readonly>
                            </div>

                            <!-- lastName -->
                            <div class="col">
                              <label class="form-label small">Last Name</label>
                              <input type="text" 
                                name="lastName"
                                id="lastName"
                                class="form-control"
                                value="<%= volunteer.lastName || '' %>"
                                readonly>
                            </div>

                            <!-- suffix -->
                            <div class="col">
                              <label class="form-label small">Suffix</label>
                              <input type="text"
                                name="suffix"
                                id="suffix"
                                class="form-control"
                                value="<%= volunteer.suffix || '' %>"
                                readonly>
                            </div>

                            <!-- email -->
                            <div class="col">
                              <label class="form-label small">Email</label>
                              <input type="email"
                                class="form-control"
                                value="<%= volunteer.email || '' %>"
                                readonly>
                              <div class="form-text">
                                Email changes must be handled through the initial sign-in step.
                              </div>
                            </div>

                            <!-- password placeholder -->
                            <div class="col">
                              <label class="form-label small">Password</label>
                              <input type="password" class="form-control" value="********" readonly>
                              <div class="form-text">Password is securely stored and not displayed.</div>
                            </div>

                            <!-- phone -->
                            <div class="col">
                              <label class="form-label small">Phone</label>
                              <input type="text" 
                                id="phone"
                                name="phone"
                                class="form-control"
                                value="<%= volunteer.phone || '' %>"
                                readonly>
                            </div>
                            <!-- SMS capable -->
                            <div class="col">
                              <fieldset class="border-0 p-0 mt-1">
                                <legend class="form-label small mb-1">
                                  Can you receive text messages?
                                </legend>

                                <div class="d-flex gap-3">
                                  <div class="form-check">
                                    <input class="form-check-input"
                                      type="radio"
                                      name="SMSCapable"
                                      id="sms-yes"
                                      value="yes"
                                      <%= volunteer.smsCapable ? 'checked' : '' %>>
                                    <label class="form-check-label" for="sms-yes">Yes</label>
                                  </div>

                                  <div class="form-check">
                                    <input class="form-check-input"
                                      type="radio"
                                      name="SMSCapable"
                                      id="sms-no"
                                      value="no"
                                      <%= !volunteer.smsCapable ? 'checked' : '' %>>
                                    <label class="form-check-label" for="sms-no">No</label>
                                  </div>
                                </div>
                              </fieldset>
                            </div>
                              <!-- WhatsApp ID -->
                            <div class="col">
                              <label class="form-label small">WhatsApp ID</label>
                              <input
                                type="text"
                                class="form-control"
                                value="<%= volunteer.whatsappid || '' %>"
                                readonly
                              >
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- PERSONAL INFO -->
                    <div class="accordion-item">
                      <h2 class="accordion-header" id="headingPersonal">
                        <button class="accordion-button collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapsePersonal">
                          Personal Info
                        </button>
                      </h2>

                      <div id="collapsePersonal" class="accordion-collapse collapse">
                        <div class="accordion-body">

                          <div class="d-flex justify-content-end mb-2">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm summary-edit-btn"
                              data-section="personal">
                              EDIT
                            </button>
                          </div>

                          <div class="row row-cols-1 row-cols-md-2 g-3">

                            <!-- dob -->
                            <div class="col">
                              <label class="form-label small">Date of Birth</label>
                              <input type="date"
                                id="dobirthRaw"
                                name="dobirthRaw"
                                class="form-control"
                                value="<%= dobValue %>">
                            </div>

                            <!-- gender -->
                            <div class="col">
                              <label class="form-label small">Gender</label>
                              <select id="genderRaw" name="genderRaw" class="form-select">
                                <option value="" <%= !volunteer.gender ? 'selected' : '' %>>Select…</option>
                                <option value="male" <%= (volunteer.gender || '').toLowerCase() === 'male' ? 'selected' : '' %>>Male</option>
                                <option value="female" <%= (volunteer.gender || '').toLowerCase() === 'female' ? 'selected' : '' %>>Female</option>
                              </select>
                            </div>

                            <!-- stamina -->
                            <div class="col">
                              <label class="form-label small">Stamina (1–10)</label>
                              <select id="staminaRaw" name="staminaRaw" class="form-select">
                                <option value="">Rate your stamina</option>

                                <% const values = ["Poor","Fair","Average","Good","Excellent"]; %>
                                <% for (let i=0; i < values.length; i++) { %>
                                  <option
                                    value="<%= i+1 %>"
                                    <%= volunteer.stamina === (i+1) ? "selected" : "" %>>
                                    <%= `${i+1} - ${values[i]}` %>
                                  </option>
                                <% } %>
                              </select>
                            </div>

                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- CONGREGATION INFO -->
                    <div class="accordion-item" id="summary-congregation">
                      <h2 class="accordion-header" id="headingCong">
                        <button class="accordion-button collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapseCong">
                          Congregation Info
                        </button>
                      </h2>

                      <div id="collapseCong" class="accordion-collapse collapse">
                        <div class="accordion-body">

                          <div class="d-flex justify-content-end mb-2">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm summary-edit-btn"
                              data-section="congregation">
                              EDIT
                            </button>
                          </div>

                          <!-- Assigned? -->
                          <fieldset class="mb-3">
                            <legend class="form-label small mb-1">
                              Congregation assigned to this convention?
                            </legend>

                            <div class="d-flex gap-3">
                              <div class="form-check">
                                <input
                                  class="form-check-input"
                                  type="radio"
                                  name="congAssigned"
                                  id="congAssigned-yes"
                                  value="yes"
                                  <%= volunteer.assignedToConv ? 'checked' : '' %>>
                                <label class="form-check-label" for="congAssigned-yes">Yes</label>
                              </div>

                              <div class="form-check">
                                <input
                                  class="form-check-input"
                                  type="radio"
                                  name="congAssigned"
                                  id="congAssigned-no"
                                  value="no"
                                  <%= !volunteer.assignedToConv ? 'checked' : '' %>>
                                <label class="form-check-label" for="congAssigned-no">No</label>
                              </div>
                            </div>
                          </fieldset>
                         <!-- Assigned congregation list -->
                          <div id="cong-assigned-block" class="mb-3">
                            <label class="form-label small">Congregation belonging to</label>

                            <select id="congregation" name="congregation" class="form-select" required>

                              <!-- Disabled placeholder: cannot be re-selected -->
                              <option value="" disabled 
                                <%= !volunteer.congregation || volunteer.congregation.trim() === "" ? "selected" : "" %>>
                                Select congregation...
                              </option>

                              <% if (Array.isArray(congregations)) { %>
                                <% congregations
                                    .filter(c => c && c.trim() !== "")  // REMOVE blanks
                                    .forEach(c => { %>
                                      <option value="<%= c %>" 
                                        <%= volunteer.assignedToConv && volunteer.congregation === c ? 'selected' : '' %>>
                                        <%= c %>
                                      </option>
                                <% }) %>
                              <% } %>

                            </select>
                          </div>

                          <!-- Visiting -->
                          <div id="cong-visiting-block" class="mb-3">

                            <div class="row row-cols-1 row-cols-md-3 g-3">

                              <div class="col">
                                <label class="form-label small">Visiting City</label>
                                <input type="text"
                                  name="congregationOtherCity"
                                  id="congregationOtherCity"
                                  class="form-control"
                                  value="<%= visitingCity %>">
                              </div>

                              <div class="col">
                                <label class="form-label small">State</label>
                                <input type="text"
                                  name="congregationOtherState"
                                  id="congregationOtherState"
                                  maxlength="2"
                                  class="form-control"
                                  value="<%= visitingState %>">
                              </div>

                              <div class="col">
                                <label class="form-label small">Language</label>
                                <input type="text"
                                  name="congregationOtherLang"
                                  id="congregationOtherLang"
                                  class="form-control"
                                  value="<%= visitingLang %>">
                              </div>

                            </div>

                            <div class="form-text mt-1">
                              Used when you are attending from another congregation.
                            </div>
                          </div>

                          <!-- Extra session -->
                          <fieldset class="mb-2">
                            <legend class="form-label small mb-1">Attending another session?</legend>

                            <div class="d-flex gap-3">
                              <div class="form-check">
                                <input
                                  class="form-check-input"
                                  type="radio"
                                  name="extraAttend"
                                  id="extraAttend-yes"
                                  value="yes"
                                  <%= volunteer.attendExtra ? 'checked' : '' %>>
                                <label class="form-check-label" for="extraAttend-yes">Yes</label>
                              </div>

                              <div class="form-check">
                                <input
                                  class="form-check-input"
                                  type="radio"
                                  name="extraAttend"
                                  id="extraAttend-no"
                                  value="no"
                                  <%= !volunteer.attendExtra ? 'checked' : '' %>>
                                <label class="form-check-label" for="extraAttend-no">No</label>
                              </div>

                            </div>
                          </fieldset>

                        </div>
                      </div>
                    </div>

                    <!-- SPIRITUAL INFO -->
                    <div class="accordion-item">
                      <h2 class="accordion-header" id="headingSpiritual">
                        <button class="accordion-button collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapseSpiritual">
                          Spiritual Info
                        </button>
                      </h2>

                      <div id="collapseSpiritual" class="accordion-collapse collapse">
                        <div class="accordion-body">

                          <div class="d-flex justify-content-end mb-2">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm summary-edit-btn"
                              data-section="spiritual">
                              EDIT
                            </button>
                          </div>

                          <!-- 3-column layout -->
                          <div class="row row-cols-1 row-cols-md-3 g-4">

                            <!-- Ministry -->
                            <div class="col">
                              <h3 class="h6 text-uppercase text-muted mb-2">Ministry</h3>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="auxPioneer"
                                  id="priv-auxPioneer"
                                  <%= volunteer.auxPioneer ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-auxPioneer">
                                  Auxiliary Pioneer
                                </label>
                              </div>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="regPioneer"
                                  id="priv-regPioneer"
                                  <%= volunteer.regPioneer ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-regPioneer">
                                  Regular Pioneer
                                </label>
                              </div>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="specPioneer"
                                  id="priv-specPioneer"
                                  <%= volunteer.specPioneer ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-specPioneer">
                                  Special Pioneer / Missionary
                                </label>
                              </div>
                            </div>

                            <!-- Congregation -->
                            <div class="col">
                              <h3 class="h6 text-uppercase text-muted mb-2">Congregation</h3>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="minServ"
                                  id="priv-minServ"
                                  <%= volunteer.minServ ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-minServ">
                                  Ministerial Servant
                                </label>
                              </div>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="elder"
                                  id="priv-elder"
                                  <%= volunteer.elder ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-elder">
                                  Elder
                                </label>
                              </div>
                            </div>

                            <!-- SFTS -->
                            <div class="col">
                              <h3 class="h6 text-uppercase text-muted mb-2">Special Full-Time</h3>

                              <div class="form-check">
                                <input class="form-check-input privilege-checkbox"
                                  type="checkbox"
                                  name="privileges"
                                  value="sfs"
                                  id="priv-sfs"
                                  <%= volunteer.sfs ? 'checked' : '' %>>
                                <label class="form-check-label" for="priv-sfs">
                                  Special Full-Time Service
                                </label>
                              </div>
                            </div>

                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- NOTES -->
                    <div class="accordion-item">
                      <h2 class="accordion-header" id="headingNotes">
                        <button class="accordion-button collapsed"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#collapseNotes">
                          Additional Notes
                        </button>
                      </h2>

                      <div id="collapseNotes" class="accordion-collapse collapse">
                        <div class="accordion-body">

                          <div class="d-flex justify-content-end mb-2">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm summary-edit-btn"
                              data-section="notes">
                              EDIT
                            </button>
                          </div>

                          <div class="mb-3">
                            <label class="form-label small">Additional Notes</label>
                            <textarea
                              id="notes"
                              name="notes"
                              class="form-control"
                              rows="4"><%= volunteer.notes || '' %></textarea>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  
              </form>

              <div class="sticky-action text-end mt-4">
                <button
                  type="button"
                  id="print-summary"
                  class="btn btn-outline-secondary me-2">
                  <i class="fa fa-print me-2"></i>Print
                </button>
                <button
                  type="button"
                  id="final-submit"
                  class="btn btn-success">
                  Confirm &amp; Finish
                </button>
                <div id="submitStatus" class="mt-3"></div>
              </div>
              <% } %>            
            </div> <!-- /card-body -->
          </section>

        </div>

      </div>

    </main>

    <!-- Confirm Modal (FINAL) -->
    <div class="modal fade"
      id="summaryConfirmModal"
      tabindex="-1"
      aria-labelledby="summaryConfirmLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

          <div class="modal-header">
            <h5 class="modal-title fw-semibold" id="summaryConfirmLabel">Confirm Profile Save</h5>
            
          </div>

          <div class="modal-body">
            You are about to save your profile and finish your registration.
            Are you sure you want to continue?
          </div>

          <div class="modal-footer">
            <button type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal">Go Back to Edit</button>

            <button type="button"
              class="btn btn-success"
              id="yesSaveBtn">Yes, Save &amp; Finish</button>
          </div>

        </div>
      </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade"
      id="summarySuccessModal"
      tabindex="-1"
      aria-labelledby="summarySuccessLabel"
      aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border border-success">

          <div class="modal-header bg-success text-white">
            <h5 class="modal-title fw-semibold" id="summarySuccessLabel">
              Registration Completed
            </h5>
          </div>

          <div class="modal-body">
            Your registration has been successfully submitted.<br>
            You will be redirected to the home page in 5 seconds.
          </div>

        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/mobileDropdownSafety.js"></script>
    <script src="/js/formSummary.js" nonce="<%= nonce %>"></script>
    <script src="/js/formListeners.js"></script>
    <script src="/js/privilegeEnforcer.js"></script>

  </body>
</html>
