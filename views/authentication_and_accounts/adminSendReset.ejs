<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Send Reset Links — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>

  <body class="min-vh-100 bg-body-tertiary">
    <%- include('../partials/header') %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 admin-console-card">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header text-center">
              <h1 class="h2 my-2">
                <i class="fa-solid fa-paper-plane me-2"></i>Send Reset Links
              </h1>
              <p class="mb-0">
                Volunteers below have incomplete registrations.
                Send them a link to set their password and finish signing up.
              </p>
            </header>

            <div class="card-body">

              <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  <i class="fa-solid fa-circle-check me-2"></i><%= success %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% } %>

              <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% } %>

              <div class="mb-3">
                <input
                  type="text"
                  id="draftSearch"
                  class="form-control"
                  placeholder="Search by name or email..."
                  autocomplete="off"
                />
              </div>

              <% if (drafts.length === 0) { %>
                <div class="alert alert-info">
                  <i class="fa-solid fa-circle-info me-2"></i>
                  No incomplete registrations found. Everyone is fully signed up!
                </div>
              <% } else { %>

              <div class="table-responsive">
                <table class="table table-hover align-middle" id="draftTable">
                  <thead class="table-light">
                    <tr>
                      <th>Name</th>
                      <th>Last step</th>
                      <th>Email</th>
                      <th>Phone</th>
                      <th>Last updated</th>
                      <th>Send via</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% drafts.forEach(v => { %>
                      <%
                        const name = [v.lastName, v.firstName].filter(Boolean).join(', ') || '—';
                        const lastUpdated = v.last_updated
                          ? new Date(v.last_updated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                          : '—';
                        const stepLabel = {
                          emailPass:        'Email/password',
                          volunteerIn:      'Phone',
                          personalInfo:     'Personal info',
                          congregationInfo: 'Congregation',
                          spiritualInfo:    'Spiritual info',
                          notes:            'Notes',
                          formSummary:      'Summary',
                        }[v.last_step] || v.last_step || '—';
                      %>
                      <tr class="draft-row">
                        <td><strong><%= name %></strong></td>
                        <td>
                          <span class="badge bg-warning text-dark"><%= stepLabel %></span>
                        </td>
                        <td class="text-muted small"><%= v.email || '—' %></td>
                        <td class="text-muted small"><%= v.phone || '—' %></td>
                        <td class="text-muted small"><%= lastUpdated %></td>
                        <td>
                          <div class="d-flex gap-2 flex-wrap">
                            <% if (v.email) { %>
                              <form action="/admin/tools/send-reset" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <input type="hidden" name="targetId" value="<%= v.id %>" />
                                <input type="hidden" name="method" value="email" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                  <i class="fa-solid fa-envelope me-1"></i>Email
                                </button>
                              </form>
                            <% } %>
                            <% if (v.phone) { %>
                              <form action="/admin/tools/send-reset" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <input type="hidden" name="targetId" value="<%= v.id %>" />
                                <input type="hidden" name="method" value="phone" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                  <i class="fa-solid fa-comment-sms me-1"></i>SMS
                                </button>
                              </form>
                            <% } %>
                            <% if (!v.email && !v.phone) { %>
                              <span class="text-muted small">No contact info</span>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <p class="text-muted small mt-2">
                <i class="fa-solid fa-circle-info me-1"></i>
                <%= drafts.length %> incomplete registration<%= drafts.length !== 1 ? 's' : '' %> found.
              </p>

              <% } %>

              <div class="mt-3">
                <a href="/admin/tools" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i>Back to Admin Tools
                </a>
              </div>

            </div>
          </section>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script nonce="<%= nonce %>">
      document.getElementById('draftSearch').addEventListener('input', function () {
        const term = this.value.toLowerCase();
        document.querySelectorAll('.draft-row').forEach(row => {
          row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
        });
      });
    </script>
  </body>
</html>