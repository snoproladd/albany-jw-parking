<!DOCTYPE html>
<html lang="en">
<head>
    <title>Attendance Check-In — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/attendance.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shepherd.js@15.2.2/dist/css/shepherd.css" />
    <link rel="stylesheet" href="/css/tours.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary" data-authed="true">

    <%- include('../partials/header') %>

    <%
        const _ROLE_ORDER = ['NON_REGISTERED','REGISTERED','DESK','KEYMAN','OVERSEER','ASSISTANT_ADMIN','ADMIN'];
        const _role       = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
        const _perms      = typeof userPermissions !== 'undefined' ? userPermissions : {};
        const roleLevel   = _ROLE_ORDER.indexOf(_role);
        const isAtLeast   = (r) => roleLevel >= _ROLE_ORDER.indexOf(r);
        const can         = (permission) => !!(_perms[_role] && _perms[_role][permission]);
    %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10 col-xxl-9">

          <section class="card shadow-lg admin-console-card mb-4">
            <header class="card-header">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h1 class="h4 mb-0">
                  <i class="fa-solid fa-clipboard-check me-2"></i>Attendance Check-In
                </h1>
                <div class="d-flex gap-2 flex-wrap">                  <% if (can('viewAttendance')) { %>
                    <a href="/oversight/tools/attendance/report" class="btn btn-primary btn-sm">
                      <i class="fa-solid fa-chart-bar me-1"></i>View Report
                    </a>
                  <% } %>
                  <a href="/oversight/tools" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Oversight Tools
                  </a>
                </div>
              </div>
            </header>
            <div class="card-body py-4 px-4">

        <%# ── Shift picker ──────────────────────────────────────────────── %>
        <div class="card shadow-sm mb-4 at-picker-card">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap gap-3 align-items-end">

                    <div>
                        <label class="form-label form-label-sm mb-1" for="atDaySelect">Convention Day</label>
                        <select class="form-select form-select-sm at-day-select" id="atDaySelect">
                            <option value="">— Select a day —</option>
                            <% days.forEach(function(day) { %>
                                <option value="<%= day.id %>">
                                    <%= day.label %> —
                                    <%= new Date(day.convention_date).toLocaleDateString('en-US', {
                                        weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC'
                                    }) %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="form-label form-label-sm mb-1" for="atShiftSelect">Shift</label>
                        <select class="form-select form-select-sm at-shift-select" id="atShiftSelect"
                                disabled>
                            <option value="">— Select a shift —</option>
                        </select>
                    </div>

                    <div id="atShiftMeta" class="text-muted small d-none align-self-center"></div>

                </div>
            </div>
        </div>

        <%# ── Stat cards (hidden until shift loaded) ───────────────────── %>
        <div class="row g-3 mb-4 d-none" id="atStatsRow">
            <div class="col-6 col-sm-3">
                <div class="at-stat-card at-stat-card--invited">
                    <div class="at-stat-value" id="atStatInvited">0</div>
                    <div class="at-stat-label">Invited</div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="at-stat-card at-stat-card--rsvp">
                    <div class="at-stat-value" id="atStatRsvp">0</div>
                    <div class="at-stat-label">RSVP Yes</div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="at-stat-card at-stat-card--attended">
                    <div class="at-stat-value" id="atStatAttended">0</div>
                    <div class="at-stat-label">Attended</div>
                </div>
            </div>
            <div class="col-6 col-sm-3">
                <div class="at-stat-card at-stat-card--noshow">
                    <div class="at-stat-value" id="atStatNoShow">0</div>
                    <div class="at-stat-label">No-Show</div>
                </div>
            </div>
        </div>

        <%# ── Volunteer table ───────────────────────────────────────────── %>
        <div class="card shadow-sm d-none" id="atTableCard">
            <div class="card-header py-2">
                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <span class="fw-semibold small" id="atTableTitle">Volunteers</span>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <input type="text" class="form-control form-control-sm at-search-input"
                               id="atSearch" placeholder="Find volunteer…"
                               autocomplete="off" />
                        <span class="text-muted small" id="atRowCount"></span>
                        <button type="button" class="btn btn-outline-info btn-sm" id="atWalkInBtn">
                            <i class="fa-solid fa-person-walking-arrow-right me-1"></i>Walk-In
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="atTableLoader" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                </div>
                <div class="table-responsive" id="atTableWrap">
                    <table class="table table-hover table-sm at-table mb-0" id="atTable">
                        <thead class="table-light">
                            <tr>
                                <th class="at-col-name">Volunteer</th>
                                <th class="at-col-badge">Type</th>
                                <th class="at-col-rsvp">RSVP</th>
                                <th class="at-col-attended">Attended</th>
                                <th class="at-col-notes">Notes</th>
                                <th class="at-col-recorded">Recorded</th>
                            </tr>
                        </thead>
                        <tbody id="atTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </div><%# /.card-body %>
          </section>

        </div>
      </div>
    </main>

    <%# ── Walk-In Modal ─────────────────────────────────────────────────── %>
    <div class="modal fade" id="atWalkInModal" tabindex="-1"
         aria-labelledby="atWalkInModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="atWalkInModalLabel">
                        <i class="fa-solid fa-person-walking-arrow-right me-2"></i>Add Walk-In
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control mb-3" id="atWalkInSearch"
                           placeholder="Search by last or first name…" autocomplete="off" />
                    <div id="atWalkInList" class="at-walkin-list">
                        <p class="text-muted small mb-0">Start typing to search volunteers.</p>
                    </div>
                    <div id="atWalkInError" class="alert alert-danger mt-2 d-none"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <%# ── Error toast ───────────────────────────────────────────────────── %>
    <div class="position-fixed bottom-0 end-0 p-3 at-toast-container">
        <div id="atErrorToast" class="toast align-items-center text-bg-danger border-0"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="atErrorToastBody">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Save failed — please try again.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <%# ── Embedded data ─────────────────────────────────────────────────── %>
    <script id="at-days-data" type="application/json"><%- JSON.stringify(days) %></script>
    <script id="at-volunteers-data" type="application/json"><%- JSON.stringify(volunteers) %></script>
    <input type="hidden" id="atCsrfToken" value="<%= csrfToken %>" />

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/attendanceCheckin.js"></script>
    <script type="module" src="/js/tours/attendanceCheckinTour.js"></script>

</body>
</html>
