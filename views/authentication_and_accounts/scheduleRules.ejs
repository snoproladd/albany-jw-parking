<!DOCTYPE html>
<html lang="en">
<head>
    <title>Schedule Analysis Rules — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="stylesheet" type="text/css" href="/styles/scheduleRules.css" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
</head>

<body data-authed="true" class="bg-body-tertiary">

    <%- include('../partials/header') %>

    <main class="container py-4 px-3 px-md-4" id="scheduleRulesRoot">

        <%# ── Header ── %>
        <div class="d-flex align-items-center gap-2 mb-4">
            <a href="/oversight/tools/conflict-grid" class="btn btn-sm btn-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>Conflict Grid
            </a>
            <div>
                <h1 class="h3 mb-0 fw-bold">
                    <i class="fa-solid fa-list-check me-2 text-primary"></i>Schedule Analysis Rules
                </h1>
                <p class="text-muted small mb-0 mt-1">
                    Rules are injected into the AI system prompt on every schedule analysis run.
                    The AI applies them when assessing violation severity and suggesting resolutions.
                </p>
            </div>
        </div>

        <%# ── Rule list ── %>
        <div class="sar-card mb-4">
            <div class="sar-card-header">
                <span class="sar-card-title">
                    <i class="fa-solid fa-shield-halved me-1"></i>Active Rules
                </span>
                <span class="badge bg-secondary" id="sarActiveCount">—</span>
            </div>

            <div id="sarLoading" class="sar-loading">
                <span class="spinner-border spinner-border-sm me-2"></span>Loading rules…
            </div>
            <div id="sarError" class="sar-error d-none">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                Failed to load rules.
            </div>
            <div id="sarEmpty" class="sar-empty d-none">
                <i class="fa-solid fa-inbox me-1"></i>No rules defined yet. Add one below.
            </div>
            <div id="sarList" class="sar-list d-none"></div>
        </div>

        <%# ── Add rule form ── %>
        <div class="sar-card">
            <div class="sar-card-header">
                <span class="sar-card-title">
                    <i class="fa-solid fa-plus me-1"></i>Add Rule
                </span>
            </div>
            <div class="sar-add-form">
                <textarea
                    id="sarNewRuleText"
                    class="sar-textarea"
                    rows="3"
                    placeholder="Enter a scheduling rule the AI should apply when analyzing the schedule…"
                    maxlength="2000"
                ></textarea>
                <div class="sar-add-footer">
                    <span class="sar-char-count" id="sarCharCount">0 / 2000</span>
                    <div id="sarAddError" class="sar-inline-error d-none"></div>
                    <button type="button" class="sar-add-btn" id="sarAddBtn">
                        <i class="fa-solid fa-plus me-1"></i>Add Rule
                    </button>
                </div>
            </div>
        </div>

    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/scheduleRules.js" type="module"></script>
</body>
</html>
