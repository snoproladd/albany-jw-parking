<!DOCTYPE html>
<html lang="en">

<head>
    <title>Access Denied — Albany JW Parking</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css">
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<body>
    <main>
        <div class="error-page d-flex align-items-center justify-content-center">
            <div class="error-container text-center p-4">

                <i class="fa-solid fa-lock fa-3x mb-3 text-warning"></i>

                <h1 class="error-code mb-0">403</h1>
                <h2 class="display-6 error-message mb-3">Access Denied</h2>
                <p class="lead error-message mb-2">
                    You don't have permission to view this page.
                </p>
                <p class="error-message mb-5">
                    If you think this is a mistake, contact your parking overseer or admin.
                </p>

                <% if (typeof userRole !== 'undefined' && userRole) { %>
                <p class="text-muted small mb-4">
                    Signed in as <strong><%= userRole %></strong>
                </p>
                <% } %>

                <div class="d-flex justify-content-center gap-3">
                    <% if (typeof nav !== 'undefined' && nav.isLoggedIn) { %>
                        <a href="/my-account" class="btn btn-glass px-4 py-2">
                            <i class="fa-solid fa-id-card me-1"></i>
                            My Account
                        </a>
                    <% } %>
                    <a href="/" class="btn btn-glass px-4 py-2">
                        <i class="fa-solid fa-house me-1"></i>
                        Return Home
                    </a>
                </div>

            </div>
        </div>
    </main>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>