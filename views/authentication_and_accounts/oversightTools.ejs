<!DOCTYPE html>
<html lang="en">

<head>
  <title>Oversight Tools — Albany JW Parking</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary">
  <%- include('../partials/header') %>
    <% const _ROLE_ORDER=['NON_REGISTERED','REGISTERED','KEYMAN','OVERSEER','ASSISTANT_ADMIN','ADMIN']; const
      _role=typeof userRole !=='undefined' ? userRole : 'NON_REGISTERED' ; const _perms=typeof userPermissions
      !=='undefined' ? userPermissions : {}; const roleLevel=_ROLE_ORDER.indexOf(_role); const isAtLeast=(r)=> roleLevel
      >= _ROLE_ORDER.indexOf(r);
      const can = (permission) => !!(_perms[_role] && _perms[_role][permission]);
      %>

      <main class="container py-4">
        <div class="row justify-content-center">
          <div class="col-12 admin-console-card">

            <section class="card shadow-lg admin-console-card">
              <header class="card-header text-center">
                <h1 class="h2 my-2">
                  <i class="fa-solid fa-screwdriver-wrench me-2"></i>Oversight Tools
                </h1>
                <p class="mb-0">Tools available based on your role.</p>
              </header>

              <div class="card-body py-4">

                <%# ── Volunteer Management ─────────────────────────────────── %>
                  <% if (can('manageRoles') || can('editVolunteerInfo') || can('createVolunteerAccounts') ||
                    isAtLeast('OVERSEER')) { %>
                    <h2 class="tools-group-heading">
                      <i class="fa-solid fa-users me-2"></i>Volunteer Management
                    </h2>
                    <div class="row g-4 mb-5">
                      <% if (can('createVolunteerAccounts')) { %>
                        <div class="col-12 col-sm-6 col-lg-4">
                          <div class="admin-tool-card h-100">
                            <div class="admin-tool-icon text-info">
                              <i class="fa-solid fa-user-plus"></i>
                            </div>
                            <h3 class="admin-tool-title">Create Volunteer</h3>
                            <p class="admin-tool-desc">Manually create a new volunteer account. A temporary
                              password will be set automatically.</p>
                            <a href="/oversight/tools/create-volunteer" class="btn btn-info admin-tool-btn">
                              Open <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                          </div>
                        </div>
                        <% } %>

                          <% if (can('editVolunteerInfo')) { %>
                            <div class="col-12 col-sm-6 col-lg-4">
                              <div class="admin-tool-card h-100">
                                <div class="admin-tool-icon text-success">
                                  <i class="fa-solid fa-id-card"></i>
                                </div>
                                <h3 class="admin-tool-title">Edit Volunteer</h3>
                                <p class="admin-tool-desc">View and edit volunteer account information including
                                  contact, congregation, and spiritual info.</p>
                                <a href="/editVolunteer" class="btn btn-success admin-tool-btn">
                                  Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                              </div>
                            </div>
                            <% } %>
                              <% if (can('manageRoles') || isAtLeast('OVERSEER')) { %>
                                <div class="col-12 col-sm-6 col-lg-4">
                                  <div class="admin-tool-card h-100">
                                    <div class="admin-tool-icon text-primary">
                                      <i class="fa-solid fa-user-shield"></i>
                                    </div>
                                    <h3 class="admin-tool-title">Role Management</h3>
                                    <p class="admin-tool-desc">Assign and update volunteer roles. Roles control what
                                      each user
                                      can see and do.</p>
                                    <a href="/oversight/roles" class="btn btn-primary admin-tool-btn">
                                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                  </div>
                                </div>
                                <% } %>
                                  <%# Hierarchy — coming soon %>
                                    <% if (isAtLeast('OVERSEER')) { %>
                                      <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="admin-tool-card admin-tool-card--soon h-100">
                                          <div class="admin-tool-icon text-secondary">
                                            <i class="fa-solid fa-sitemap"></i>
                                          </div>
                                          <h3 class="admin-tool-title">Hierarchy</h3>
                                          <p class="admin-tool-desc">Visualize the full role hierarchy and crew
                                            structure across all registered volunteers.</p>
                                          <span class="badge bg-secondary admin-tool-soon">Coming soon</span>
                                        </div>
                                      </div>
                                      <% } %>
                    </div>
                    <% } %>

                      <%# ── Communications ───────────────────────────────────────── %>
                        <% if (can('accessAdminConsole')) { %>
                          <h2 class="tools-group-heading">
                            <i class="fa-solid fa-paper-plane me-2"></i>Communications
                          </h2>
                          <div class="row g-4 mb-5">

                            <div class="col-12 col-sm-6 col-lg-4">
                              <div class="admin-tool-card h-100">
                                <div class="admin-tool-icon text-warning">
                                  <i class="fa-solid fa-paper-plane"></i>
                                </div>
                                <h3 class="admin-tool-title">Send Reset Link</h3>
                                <p class="admin-tool-desc">Send password reset or account completion links to volunteers
                                  with incomplete registrations.</p>
                                <a href="/oversight/tools/send-reset" class="btn btn-warning admin-tool-btn">
                                  Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                              </div>
                            </div>

                          </div>
                          <% } %>

                            <%# ── Downloads ────────────────────────────────────────────── %>
                              <% if (can('accessAdminConsole')) { %>
                                <h2 class="tools-group-heading">
                                  <i class="fa-solid fa-download me-2"></i>Downloads
                                </h2>
                                <div class="row g-4 mb-5">

                                  <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="admin-tool-card h-100">
                                      <div class="admin-tool-icon text-secondary">
                                        <i class="fa-solid fa-terminal"></i>
                                      </div>
                                      <h3 class="admin-tool-title">Decently Export</h3>
                                      <p class="admin-tool-desc">Export volunteers to Decently scheduling. Downloads a
                                        CSV and marks records as exported.</p>
                                      <a href="/oversight/tools/decently-export"
                                        class="btn btn-secondary admin-tool-btn">
                                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                      </a>
                                    </div>
                                  </div>
                                  <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="admin-tool-card h-100">
                                      <div class="admin-tool-icon text-success">
                                        <i class="fa-solid fa-file-import"></i>
                                      </div>
                                      <h3 class="admin-tool-title">Decently Import</h3>
                                      <p class="admin-tool-desc">Upload an approved volunteer CSV from Decently. Matches records, sets active status, and flags unrecognised volunteers for creation.</p>
                                      <a href="/oversight/tools/decently-import" class="btn btn-success admin-tool-btn">
                                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                      </a>
                                    </div>
                                  </div>

                                </div>
                                <% } %>

                                  <%# ── Scheduling ───────────────────────────────────────────── %>
                                    <% if (can('manageShifts') || can('printSchedules') || isAtLeast('REGISTERED')) { %>
                                      <h2 class="tools-group-heading">
                                        <i class="fa-regular fa-calendar-days me-2"></i>Scheduling
                                      </h2>
                                      <div class="row g-4 mb-5">

                                        <% if (can('manageShifts')) { %>
                                          <div class="col-12 col-sm-6 col-lg-4">
                                            <div class="admin-tool-card admin-tool-card--soon h-100">
                                              <div class="admin-tool-icon text-secondary">
                                                <i class="fa-regular fa-calendar-days"></i>
                                              </div>
                                              <h3 class="admin-tool-title">Schedules</h3>
                                              <p class="admin-tool-desc">Create and manage volunteer parking schedules
                                                by session and assignment.</p>
                                              <span class="badge bg-secondary admin-tool-soon">Coming soon</span>
                                            </div>
                                          </div>
                                          <% } %>

                                            <% if (can('printSchedules')) { %>
                                              <div class="col-12 col-sm-6 col-lg-4">
                                                <div class="admin-tool-card admin-tool-card--soon h-100">
                                                  <div class="admin-tool-icon text-secondary">
                                                    <i class="fa-solid fa-print"></i>
                                                  </div>
                                                  <h3 class="admin-tool-title">Print Schedules</h3>
                                                  <p class="admin-tool-desc">Generate printable schedule sheets for
                                                    distribution at the convention.</p>
                                                  <span class="badge bg-secondary admin-tool-soon">Coming soon</span>
                                                </div>
                                              </div>
                                              <% } %>

                                                <%# Conflicts & Blackouts — coming soon %>
                                                  <% if (can('manageShifts')) { %>
                                                    <div class="col-12 col-sm-6 col-lg-4">
                                                      <div class="admin-tool-card admin-tool-card--soon h-100">
                                                        <div class="admin-tool-icon text-secondary">
                                                          <i class="fa-solid fa-triangle-exclamation"></i>
                                                        </div>
                                                        <h3 class="admin-tool-title">Conflicts &amp; Blackouts</h3>
                                                        <p class="admin-tool-desc">Review scheduling conflicts and
                                                          define blackout windows when volunteers are unavailable.</p>
                                                        <span class="badge bg-secondary admin-tool-soon">Coming
                                                          soon</span>
                                                      </div>
                                                    </div>
                                                    <% } %>

                                      </div>
                                      <% } %>

                                        <%# ── Administration ───────────────────────────────────────── %>
                                          <% if (can('manageRoles') && isAtLeast('ADMIN')) { %>
                                            <h2 class="tools-group-heading">
                                              <i class="fa-solid fa-gear me-2"></i>Administration
                                            </h2>
                                            <div class="row g-4 mb-2">

                                              <div class="col-12 col-sm-6 col-lg-4">
                                                <div class="admin-tool-card h-100">
                                                  <div class="admin-tool-icon text-danger">
                                                    <i class="fa-solid fa-sliders"></i>
                                                  </div>
                                                  <h3 class="admin-tool-title">Permission Matrix</h3>
                                                  <p class="admin-tool-desc">Override default role permissions at
                                                    runtime. Changes take effect on next login.</p>
                                                  <a href="/oversight/tools/permissions"
                                                    class="btn btn-danger admin-tool-btn">
                                                    Open <i class="fa-solid fa-arrow-right ms-1"></i>
                                                  </a>
                                                </div>
                                              </div>

                                            </div>
                                            <% } %>

              </div><!-- /.card-body -->
            </section>
          </div>
        </div>
      </main>

      <%- include('../partials/footer') %>

        <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>