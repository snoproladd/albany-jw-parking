
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Convention Volunteer Home Page</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css">
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>     
<div class="container">
    <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4">
        <div class="col-md-3 mb-2 mb-md-0">
            <a href="/" class="d-inline-flex link-body-emphasis text-decoration-none">
                <svg class="bi" width="40" height="32" role="img" aria-label="Bootstrap">
                    <use xlink:href="#bootstrap"></use>
                </svg>
            </a>
        </div>

      <!-- Nav: centered, items can wrap; link text does NOT wrap -->
        <nav class="w-100 w-md-auto order-2 order-md-2">
          <ul class="nav justify-content-center flex-wrap mx-md-auto">

            <li class="nav-item">
              <a href="/" class="nav-link px-2 header-link text-nowrap">Home</a>
            </li>

            <li class="nav-item">
              <a href="/schedules" class="nav-link px-2 header-link text-nowrap">
                Schedules
              </a>
            </li>

            <li class="nav-item">
              <a href="/maps" class="nav-link px-2 header-link text-nowrap">
                Maps
              </a>
            </li>

            <li class="nav-item">
              <a href="/my-account" class="nav-link px-2 header-link text-nowrap">
                My Account
              </a>
            </li>

            <li class="nav-item">
              <a href="/contact" class="nav-link px-2 header-link text-nowrap">
                Contact
              </a>
            </li>

            <!-- ⭐ NEW — Upgrade Account link -->
            <li class="nav-item">
              <a href="/upgrade" class="nav-link px-2 header-link text-nowrap text-success fw-semibold">
                Upgrade Account
              </a>
            </li>

          </ul>
        </nav>

      <!-- Buttons: centered on small, right-aligned on md+ -->
      <div class="d-flex flex-wrap justify-content-center justify-content-md-end w-100 w-md-auto gap-2 order-3 order-md-3">
        <a href="/login" class="btn btn-outline-primary" role="button">Login</a>
        <a href="/email-pass" class="btn btn-primary" role="button">Sign-up</a>
        <a href="/nonProfile" class="btn btn-secondary" role="button">Enter Info Only</a>
      </div>
    </div>
  </div>
</header>



  

 
</body>
</html>
