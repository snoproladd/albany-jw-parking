<!DOCTYPE html>
<html lang="en">
<head>
    <title>Attendance Report — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/attendance.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shepherd.js@15.2.2/dist/css/shepherd.css" />
    <link rel="stylesheet" href="/css/tours.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary" data-authed="true">

    <%- include('../partials/header') %>

    <%
        const _ROLE_ORDER = ['NON_REGISTERED','REGISTERED','DESK','KEYMAN','OVERSEER','ASSISTANT_ADMIN','ADMIN'];
        const _role       = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
        const _perms      = typeof userPermissions !== 'undefined' ? userPermissions : {};
        const roleLevel   = _ROLE_ORDER.indexOf(_role);
        const isAtLeast   = (r) => roleLevel >= _ROLE_ORDER.indexOf(r);
        const can         = (permission) => !!(_perms[_role] && _perms[_role][permission]);
    %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10 col-xxl-9">

          <section class="card shadow-lg admin-console-card mb-4">
            <header class="card-header">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h1 class="h4 mb-0">
                  <i class="fa-solid fa-chart-bar me-2"></i>Attendance Report
                </h1>
                <div class="d-flex gap-2 flex-wrap">
                  <button type="button" class="btn btn-outline-secondary btn-sm ajwp-tour-trigger" id="tourTriggerBtn">
                    <i class="fa-solid fa-circle-question me-1"></i>Tour
                  </button>
                  <% if (can('logAttendance')) { %>
                    <a href="/oversight/tools/attendance/checkin" class="btn btn-info btn-sm">
                      <i class="fa-solid fa-clipboard-check me-1"></i>Check-In Tool
                    </a>
                  <% } %>
                  <a href="/oversight/tools" class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i>Oversight Tools
                  </a>
                </div>
              </div>
            </header>
            <div class="card-body py-4 px-4">

        <%# ── Day picker ────────────────────────────────────────────────── %>
        <div class="card shadow-sm mb-4 at-picker-card">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap gap-3 align-items-end">
                    <div>
                        <label class="form-label form-label-sm mb-1" for="arDaySelect">Convention Day</label>
                        <select class="form-select form-select-sm ar-day-select" id="arDaySelect">
                            <option value="">— Select a day —</option>
                            <% conventionDays.forEach(function(day) { %>
                                <option value="<%= day.id %>">
                                    <%= day.label %> —
                                    <%= new Date(day.convention_date).toLocaleDateString('en-US', {
                                        weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC'
                                    }) %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                    <div id="arDaySummary" class="d-none">
                        <span class="at-stat-card at-stat-card--invited d-inline-flex align-items-center gap-2 px-3 py-2">
                            <strong id="arSumAttended">0</strong>
                            <span class="at-stat-label mb-0">attended across all shifts</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <%# ── Filter bar (hidden until day loaded) ──────────────────────── %>
        <div class="card shadow-sm mb-4 d-none" id="arFilterBar">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap gap-3 align-items-end">

                    <div>
                        <label class="form-label form-label-sm mb-1" for="arFilterType">Type</label>
                        <select class="form-select form-select-sm ar-filter-type" id="arFilterType">
                            <option value="">All</option>
                            <option value="invited">Invited</option>
                            <option value="walkin">Walk-In</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label form-label-sm mb-1" for="arFilterRsvp">RSVP</label>
                        <select class="form-select form-select-sm ar-filter-rsvp" id="arFilterRsvp">
                            <option value="">All</option>
                            <option value="yes">Yes</option>
                            <option value="maybe">Maybe</option>
                            <option value="no">No</option>
                            <option value="pending">Pending</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label form-label-sm mb-1" for="arFilterAttended">Attended</label>
                        <select class="form-select form-select-sm ar-filter-attended" id="arFilterAttended">
                            <option value="">All</option>
                            <option value="yes">Attended</option>
                            <option value="no">Not Recorded</option>
                        </select>
                    </div>

                    <div class="ms-auto">
                        <label class="form-label form-label-sm mb-1" for="arFilterName">Search name</label>
                        <input type="text" class="form-control form-control-sm ar-filter-name" id="arFilterName"
                               placeholder="Last, First…" autocomplete="off" />
                    </div>

                    <div class="align-self-end">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="arFilterReset">
                            <i class="fa-solid fa-xmark me-1"></i>Reset
                        </button>
                    </div>

                    <div class="align-self-end text-muted small" id="arFilterCount"></div>

                </div>
            </div>
        </div>

        

        <%# ── Loader ────────────────────────────────────────────────────── %>
        <div id="arLoader" class="text-center py-5 d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading…</span>
            </div>
        </div>

        <%# ── Report accordion ──────────────────────────────────────────── %>
        <div id="arAccordion" class="accordion d-none"></div>

        <%# ── Empty state ───────────────────────────────────────────────── %>
        <div id="arEmpty" class="at-empty-state d-none">
            <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block"></i>
            No shifts found for this day.
        </div>

    </div><%# /.card-body %>
          </section>

        </div>
      </div>
    </main>



    <input type="hidden" id="arCsrfToken" value="<%= csrfToken %>" />

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/attendanceReport.js"></script>
    <script type="module" src="/js/tours/attendanceReportTour.js"></script>

</body>
</html>
