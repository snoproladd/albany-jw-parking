<!DOCTYPE html>
<html lang="en">
<head>
    <title>Campaign Center — <%= brand.siteName %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include('../partials/metaDescription') %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/campaignCenter.css" />
    <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/georama-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/fonts.css" />
</head>

<body class="min-vh-100 bg-body-tertiary" data-authed="true">

    <%- include('../partials/header') %>


    <%# ── Desktop-only alert ──────────────────────────────────────────────── %>
    <div class="mc-mobile-alert d-flex align-items-center gap-2">
        <i class="fa-solid fa-desktop fa-lg"></i>
        <span>The Campaign Center is designed for desktop use. Some features may not work well on a touch screen.</span>
    </div>

    <%# ── Main layout wrapper ─────────────────────────────────────────────── %>
    <div class="mc-layout" id="messagingCenterRoot">

        <%# ══════════════════════════════════════════════════════════════════ %>
        <%# ASIDE — Volunteer selector                                         %>
        <%# ══════════════════════════════════════════════════════════════════ %>
        <aside class="mc-aside" id="mcAside">

            <div class="mc-aside-header">
                <h2 class="mc-aside-title">
                    <i class="fa-solid fa-users me-2"></i>Volunteers
                </h2>
                <span class="badge bg-secondary" id="mcSelectionCount">0 selected</span>
            </div>

            <%# ── Filters ──────────────────────────────────────────────────── %>
            <div class="mc-filters">

                <div class="mc-filter-group">
                    <label class="mc-filter-label">Status</label>
                    <div class="mc-filter-btns" role="group">
                        <button type="button" class="mc-filter-btn active" data-filter-status="all">All</button>
                        <button type="button" class="mc-filter-btn" data-filter-status="draft">Draft</button>
                        <button type="button" class="mc-filter-btn" data-filter-status="completed">Completed</button>
                    </div>
                </div>

                <div class="mc-filter-group">
                    <label class="mc-filter-label">Active</label>
                    <div class="mc-filter-btns" role="group">
                        <button type="button" class="mc-active-btn active" data-filter-active="all">All</button>
                        <button type="button" class="mc-active-btn" data-filter-active="true">Active</button>
                        <button type="button" class="mc-active-btn" data-filter-active="false">Inactive</button>
                    </div>
                </div>

                <div class="mc-filter-group">
                    <label class="mc-filter-label">Gender</label>
                    <div class="mc-filter-btns" role="group">
                        <button type="button" class="mc-gender-btn active" data-filter-gender="all">All</button>
                        <button type="button" class="mc-gender-btn" data-filter-gender="male">Male</button>
                        <button type="button" class="mc-gender-btn" data-filter-gender="female">Female</button>
                    </div>
                </div>

                <div class="mc-filter-group">
                    <%# Position filter (phase 3d-8c; was role): the positions people in
                        this list hold, plus "Overseer and up" (tier 3+). %>
                    <% const _mcPositions = [...new Set(volunteers.flatMap((v) =>
                           (v.positions || '').split(', ').filter(Boolean)))].sort(); %>
                    <label class="mc-filter-label" for="mcRoleFilter">Position</label>
                    <select id="mcRoleFilter" class="form-select form-select-sm">
                        <option value="">All</option>
                        <% _mcPositions.forEach(function (name) { %>
                            <option value="pos:<%= name %>"><%= name %></option>
                        <% }) %>
                        <option value="tier3">Overseer and up</option>
                    </select>
                </div>

                <div class="mc-filter-group">
                    <label class="mc-filter-label" for="mcCrewFilter">Crew</label>
                    <select id="mcCrewFilter" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="lots_and_garages">Lots &amp; Garages</option>
                        <option value="signs">Signs</option>
                        <option value="security">Security</option>
                        <option value="dropoff_pickup">Dropoff / Pickup</option>
                        <option value="mobile_support">Mobile Support</option>
                        <option value="desk">Desk</option>
                    </select>
                </div>

                <div class="mc-filter-group">
                    <label class="mc-filter-label" for="mcSearch">Search</label>
                    <input
                        type="text"
                        id="mcSearch"
                        class="form-control form-control-sm"
                        placeholder="Name…"
                        autocomplete="off"
                    />
                </div>

            </div>

            <%# ── Select all / count ───────────────────────────────────────── %>
            <div class="mc-list-controls">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="mcSelectAll">
                    Select all visible
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="mcClearAll">
                    Clear
                </button>
                <span class="mc-visible-count" id="mcVisibleCount"></span>
            </div>

            <%# ── Volunteer list ───────────────────────────────────────────── %>
            <ul class="mc-volunteer-list" id="mcVolunteerList" role="listbox" aria-multiselectable="true" aria-label="Volunteers">
                <% volunteers.forEach(function(v) { %>
                    <%
                        const displayName = v.lastName + ', ' + v.firstName + (v.suffix ? ' ' + v.suffix : '');
                        const hasEmail    = !!v.email;
                        const hasSms      = !!v.phone && v.smsCapable;
                        const smsConsent  = hasSms && v.smsOptedIn;
                        const crewKeys    = [
                            v.crew_lots_garages   ? 'lots_and_garages' : null,
                            v.crew_signs          ? 'signs'            : null,
                            v.crew_security       ? 'security'         : null,
                            v.crew_dropoff_pickup ? 'dropoff_pickup'   : null,
                            v.crew_mobile_support ? 'mobile_support'   : null,
                            v.crew_desk           ? 'desk'             : null,
                        ].filter(Boolean).join(',');
                    %>
                    <li
                        class="mc-volunteer-item"
                        role="option"
                        aria-selected="false"
                        data-id="<%= v.id %>"
                        data-name="<%= displayName.toLowerCase() %>"
                        data-status="<%= v.registration_status %>"
                        data-active="<%= v.active_current_year %>"
                        data-gender="<%= v.gender || '' %>"
                        data-positions="|<%= (v.positions || '').split(', ').filter(Boolean).join('|') %>|"
                        data-tier="<%= v.tier || 0 %>"
                        data-crews="<%= crewKeys %>"
                        data-has-email="<%= hasEmail %>"
                        data-has-sms="<%= hasSms %>"
                        data-sms-opted-in="<%= smsConsent ? '1' : '0' %>"
                    >
                        <input
                            type="checkbox"
                            class="mc-checkbox"
                            aria-hidden="true"
                            tabindex="-1"
                            id="mcVol_<%= v.id %>"
                        />
                        <label class="mc-volunteer-name" for="mcVol_<%= v.id %>">
                            <%= displayName %>
                        </label>
                        <span class="mc-channel-icons">
                            <% if (hasEmail) { %>
                                <i class="fa-solid fa-envelope mc-icon-email" title="Has email"></i>
                            <% } %>
                            <% if (smsConsent) { %>
                                <i class="fa-solid fa-comment-sms mc-icon-sms" title="Can receive texts"></i>
                            <% } else if (hasSms) { %>
                                <i class="fa-solid fa-comment-slash mc-icon-sms-off" title="Texts off: not opted in"></i>
                            <% } %>
                        </span>
                    </li>
                <% }); %>
            </ul>

        </aside>

        <%# ══════════════════════════════════════════════════════════════════ %>
        <%# MAIN — Compose + Send                                              %>
        <%# ══════════════════════════════════════════════════════════════════ %>
        <main class="mc-main">

            <%# ── Page header ──────────────────────────────────────────────── %>
            <div class="mc-main-header">
                <h1 class="mc-main-title">
                    <i class="fa-solid fa-paper-plane me-2"></i>Campaign Center
                </h1>
                <div class="d-flex gap-2 align-items-center">                    <a href="/oversight/tools/campaigns/tracker" class="btn btn-success btn-sm">
                        <i class="fa-solid fa-chart-gantt me-1"></i>Invitation Tracker
                    </a>
                    <a href="/oversight/tools" class="btn btn-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i>Tools
                    </a>
                </div>
            </div>

            <%# ══ Step 1 — What are you sending? ══════════════════════════════ %>
            <section class="mc-card mc-step" id="mcStepPurpose" aria-labelledby="mcStepPurposeTitle">
                <h2 class="mc-step-title" id="mcStepPurposeTitle"><span class="mc-step-num" aria-hidden="true">1</span>What are you sending?</h2>
                <div class="mc-purposes" role="group" aria-label="What are you sending?">
                        <button type="button" class="mc-purpose" data-purpose="invite" aria-pressed="false">
                            <i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i>
                            <span class="mc-purpose-title">New invitation</span>
                            <span class="mc-purpose-desc">Ask people to reply</span>
                        </button>
                        <button type="button" class="mc-purpose" data-purpose="add" aria-pressed="false"
                            <%= batches.length === 0 ? 'disabled' : '' %>>
                            <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                            <span class="mc-purpose-title">Add people</span>
                            <span class="mc-purpose-desc">Send a campaign to more people</span>
                        </button>
                        <button type="button" class="mc-purpose" data-purpose="remind" aria-pressed="false"
                            <%= batches.length === 0 ? 'disabled' : '' %>>
                            <i class="fa-solid fa-bell" aria-hidden="true"></i>
                            <span class="mc-purpose-title">Reminder</span>
                            <span class="mc-purpose-desc">Re-send to people who haven't answered</span>
                        </button>
                        <button type="button" class="mc-purpose" data-purpose="followup" aria-pressed="false"
                            <%= batches.length === 0 ? 'disabled' : '' %>>
                            <i class="fa-solid fa-reply" aria-hidden="true"></i>
                            <span class="mc-purpose-title">Follow-up</span>
                            <span class="mc-purpose-desc">New message linked to a campaign</span>
                        </button>
                        <button type="button" class="mc-purpose" data-purpose="announce" aria-pressed="false">
                            <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
                            <span class="mc-purpose-title">Announcement</span>
                            <span class="mc-purpose-desc">No reply needed</span>
                        </button>
                </div>
                <% if (batches.length === 0) { %>
                    <p class="text-muted small mt-2 mb-0">Add people, Reminder and Follow-up open once a campaign has been sent.</p>
                <% } %>

                <div class="mc-purpose-fields mt-3">
                    <%# Campaign name (New invitation, Follow-up, Announcement) %>
                    <div class="mb-3" id="mcCampaignNameWrap">
                        <label class="form-label" for="mcCampaignName">
                            Campaign name
                            <span class="text-muted small fw-normal ms-1">— how it's listed in the tracker</span>
                        </label>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" id="mcCampaignName"
                                placeholder="e.g. Friday · Jul 18 · Ingress" maxlength="150" />
                            <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" id="mcSuggestNameBtn"
                                title="Suggest a name from the event in step 2">
                                <i class="fa-solid fa-wand-magic-sparkles me-1" aria-hidden="true"></i>Suggest
                            </button>
                        </div>
                    </div>

                    <%# Campaign picker (Add people, Reminder) %>
                    <div class="mb-3 d-none" id="mcExistingBatchWrap">
                        <label class="form-label" for="mcExistingBatch">Which campaign?</label>
                    <select class="form-select" id="mcExistingBatch">
                        <option value="">— Choose a campaign —</option>
                        <% batches.forEach(function(b) { %>
                            <option
                                value="<%= b.id %>"
                                data-subject="<%= b.message_subject || '' %>"
                                data-body="<%= b.message_body || '' %>"
                                data-day-id="<%= b.convention_day_id || '' %>"
                                data-shift-id="<%= b.shift_id || '' %>"
                                data-type="<%= b.message_type || 'invitation' %>"
                                data-response-needed="<%= b.response_needed ? '1' : '0' %>"
                            >
                                <%= b.parent_batch_id ? '↳ ' : '' %><%= b.name %>
                                <% if (b.day_label) { %> — <%= b.day_label %><% } %>
                                (<%= b.volunteer_count %> sent)
                            </option>
                        <% }); %>
                    </select>
                    <div class="mc-batch-preview mt-2 d-none" id="mcBatchPreview">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <i class="fa-solid fa-circle-info text-info"></i>
                            <span id="mcBatchPreviewText"></span>
                            <a href="#" class="small" id="mcBatchTrackerLink" target="_blank">
                                View in tracker <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                            </a>
                            <button type="button" class="btn btn-link btn-sm p-0 small" id="mcToggleOrigMsg">
                                View original message
                            </button>
                        </div>
                        <div class="d-none mt-2" id="mcOrigMsgPreview">
                            <div class="small fw-semibold mb-1 d-none" id="mcOrigMsgSubject"></div>
                            <pre class="mc-orig-msg-body mb-0" id="mcOrigMsgBody"></pre>
                        </div>
                    </div>
                </div>


                    <%# Parent picker (Follow-up) %>
                    <div class="mb-3 d-none" id="mcParentBatchWrap">
                        <label class="form-label" for="mcParentBatch">Follow-up to</label>
                    <select class="form-select" id="mcParentBatch">
                        <option value="">— Choose a parent campaign —</option>
                        <% batches.forEach(function(b) { %>
                            <option
                                value="<%= b.id %>"
                                data-subject="<%= b.message_subject || '' %>"
                                data-body="<%= b.message_body || '' %>"
                                data-name="<%= b.name %>"
                                data-day-id="<%= b.convention_day_id || '' %>"
                            >
                                <%= b.parent_batch_id ? '↳ ' : '' %><%= b.name %>
                                <% if (b.day_label) { %> — <%= b.day_label %><% } %>
                                (<%= b.volunteer_count %> sent)
                            </option>
                        <% }); %>
                    </select>
                </div>


                <%# ── Response needed (new + follow-up modes only) ──────────── %>
                <div class="mb-3" id="mcResponseNeededWrap">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="mcResponseNeeded" checked />
                        <label class="form-check-label" for="mcResponseNeeded">
                            Response needed
                            <span class="text-muted small fw-normal ms-1">— volunteers will be prompted to RSVP</span>
                        </label>
                    </div>
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="mcIsRecruitment" />
                        <label class="form-check-label" for="mcIsRecruitment">
                            Recruitment campaign
                            <span class="text-muted small fw-normal ms-1">— Yes and Maybe replies go to the Decently export</span>
                        </label>
                    </div>
                </div>

                <%# ── Response config builder (shown when response needed is checked) ── %>
                <div class="mb-3 ms-3 ps-2 border-start border-2" id="mcResponseConfigWrap">

                    <%# Respond-by date (optional) %>
                    <div class="mb-2">
                        <label class="mc-filter-label mb-1" for="mcRespondBy">Respond by <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="date" class="form-control form-control-sm mc-respond-by" id="mcRespondBy" aria-describedby="mcRespondByHelp" />
                        <div class="form-text" id="mcRespondByHelp">Shown on the RSVP page. Volunteers can change their answer until this date; later answers are still taken.</div>
                    </div>

                    <%# Response type selector %>
                    <div class="mb-2">
                        <label class="mc-filter-label mb-1" for="mcResponseType">Response type</label>
                        <select class="form-select form-select-sm" id="mcResponseType">
                            <option value="standard">Standard — Yes / No / Maybe</option>
                            <option value="custom">Custom choices</option>
                            <option value="poll">Poll</option>
                        </select>
                    </div>

                    <%# Standard options — checkboxes to include/exclude %>
                    <div id="mcResponseStandardWrap" class="mb-2">
                        <label class="mc-filter-label mb-1 small text-muted">Include options</label>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mcOptYes" checked />
                                <label class="form-check-label" for="mcOptYes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mcOptNo" checked />
                                <label class="form-check-label" for="mcOptNo">No</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mcOptMaybe" checked />
                                <label class="form-check-label" for="mcOptMaybe">Maybe</label>
                            </div>
                        </div>
                    </div>

                    <%# Poll question (shown for poll type only) %>
                    <div id="mcResponsePollWrap" class="mb-2 d-none">
                        <label class="mc-filter-label mb-1 small text-muted" for="mcPollQuestion">Poll question</label>
                        <input type="text" class="form-control form-control-sm" id="mcPollQuestion"
                               placeholder="e.g. Which shirt size?" maxlength="200" />
                    </div>

                    <%# Custom options (shown for custom + poll types) %>
                    <div id="mcResponseOptionsWrap" class="mb-2 d-none">
                        <label class="mc-filter-label mb-1 small text-muted">Options <span class="fw-normal">(one per line)</span></label>
                        <textarea class="form-control form-control-sm" id="mcResponseOptions"
                                  rows="3" placeholder="Friday Only&#10;Saturday Only&#10;All Three Days"
                                  maxlength="500"></textarea>
                    </div>

                    <%# Allow other — shown for all types %>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="mcAllowOther" />
                        <label class="form-check-label small" for="mcAllowOther">
                            Allow "Other" with free-text input
                        </label>
                    </div>

                </div>

                </div>
            </section>

            <%# ══ Step 2 — Which event? ═══════════════════════════════════════ %>
            <section class="mc-card mc-step" id="mcStepEvent" aria-labelledby="mcStepEventTitle">
                <h2 class="mc-step-title" id="mcStepEventTitle"><span class="mc-step-num" aria-hidden="true">2</span>Which event? <span class="mc-step-optional">optional</span></h2>
                <p class="text-muted small mb-0 d-none" id="mcEventInherited"></p>
                <div class="mc-event-picker" id="mcEventPickerWrap">
                    <% if (conventionDays.length === 0) { %>
                        <p class="text-muted small mb-0">
                            <i class="fa-solid fa-triangle-exclamation me-1 text-warning"></i>
                            No invitable shifts defined yet.
                            <a href="/oversight/tools/timelines">Set shifts as invitable in Timelines.</a>
                        </p>
                    <% } else { %>
                        <div class="d-flex gap-2 flex-wrap">
                            <select class="form-select form-select-sm mc-event-day-select" id="mcEventDay" aria-label="Link to event">
                                <option value="">— No event —</option>
                                <% conventionDays.forEach(function(day) { %>
                                    <option value="<%= day.id %>"
                                        data-label="<%= day.label %>"
                                        data-date="<%= day.convention_date %>">
                                        <%= day.label %> — <%= new Date(day.convention_date).toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric', timeZone:'UTC' }) %>
                                    </option>
                                <% }); %>
                            </select>
                            <select class="form-select form-select-sm mc-event-shift-select d-none" id="mcEventShift">
                                <option value="">— All shifts —</option>
                            </select>
                        </div>
                        <div class="mc-event-preview mt-2 d-none" id="mcEventPreview">
                            <i class="fa-solid fa-circle-info me-1 text-info"></i>
                            <span id="mcEventPreviewText"></span>
                        </div>
                    <% } %>
                </div>
            </section>

            <%# ══ Step 3 — Who gets it? ═══════════════════════════════════════ %>
            <section class="mc-card mc-step" id="mcSendListCard" aria-labelledby="mcStepWhoTitle">
                <div class="mc-card-header">
                    <h2 class="mc-step-title mb-0" id="mcStepWhoTitle"><span class="mc-step-num" aria-hidden="true">3</span>Who gets it?
                        <span class="badge bg-primary ms-2" id="mcSendListCount">0</span>
                    </h2>
                    <button type="button" class="btn btn-link btn-sm text-danger p-0" id="mcClearSendList">
                        Clear all
                    </button>
                </div>
                <div class="mc-chip-area" id="mcChipArea">
                    <span class="mc-empty-hint" id="mcEmptyHint">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>
                        Select volunteers from the list to add them here.
                    </span>
                </div>
                <p class="text-muted small mt-2 mb-0" id="mcWhoNote"></p>
            </section>

            <%# ══ Step 4 — Message ════════════════════════════════════════════ %>
            <section class="mc-card mc-step" id="mcComposeCard" aria-labelledby="mcStepMessageTitle">
                <h2 class="mc-step-title" id="mcStepMessageTitle"><span class="mc-step-num" aria-hidden="true">4</span>Message</h2>

                <%# Channels first, on their own line, so they are seen %>
                <fieldset class="mc-channel-row mb-3">
                    <legend class="mc-channel-legend">Send by</legend>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="mcSendEmail" checked />
                        <label class="form-check-label" for="mcSendEmail">
                            <i class="fa-solid fa-envelope me-1" aria-hidden="true"></i>Email
                        </label>
                    </div>
                    <div class="form-check form-check-inline me-0">
                        <input class="form-check-input" type="checkbox" id="mcSendSms" />
                        <label class="form-check-label" for="mcSendSms">
                            <i class="fa-solid fa-comment-sms me-1" aria-hidden="true"></i>Text
                        </label>
                    </div>
                </fieldset>

                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <label class="visually-hidden" for="mcTemplateSelect">Start from a template</label>
                        <select class="form-select form-select-sm mc-template-select" id="mcTemplateSelect">
                            <option value="">Start from a template…</option>
                            <% templates.forEach(function(t) { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }); %>
                        </select>
                        <button type="button" class="btn btn-link btn-sm p-0 text-nowrap" id="mcManageTemplatesBtn"
                            aria-expanded="false" aria-controls="mcTemplatesCard">Manage templates</button>
                    </div>

                <%# Template manager (collapsed until "Manage templates") %>
                <div class="mc-template-manager d-none" id="mcTemplatesCard">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold small">Saved templates</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="mcNewTemplateBtn">
                            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>New template
                        </button>
                    </div>
                <div class="mc-template-list" id="mcTemplateList">
                    <% if (templates.length === 0) { %>
                        <p class="text-muted small mb-0" id="mcNoTemplates">No saved templates yet.</p>
                    <% } else { %>
                        <% templates.forEach(function(t) { %>
                            <div class="mc-template-row" data-template-id="<%= t.id %>">
                                <button
                                    type="button"
                                    class="mc-template-load btn btn-link btn-sm p-0 text-start"
                                    data-id="<%= t.id %>"
                                    data-name="<%= t.name %>"
                                    data-subject="<%= t.subject || '' %>"
                                    data-body="<%= t.body %>"
                                    title="Load this template into the compose area"
                                >
                                    <i class="fa-regular fa-file-lines me-1"></i><%= t.name %>
                                </button>
                                <div class="mc-template-actions">
                                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary mc-template-edit" data-id="<%= t.id %>" aria-label="Edit template <%= t.name %>">
                                        <i class="fa-solid fa-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-danger mc-template-delete" data-id="<%= t.id %>" data-name="<%= t.name %>" aria-label="Delete template <%= t.name %>">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>

                <div class="mc-template-editor d-none" id="mcTemplateEditor">
                    <hr class="my-3" />
                    <div class="mb-2">
                        <label class="form-label form-label-sm" for="mcTplName">Template name</label>
                        <input type="text" class="form-control form-control-sm" id="mcTplName" placeholder="e.g. Convention Invite" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label form-label-sm" for="mcTplSubject">Subject <span class="text-muted">(email only)</span></label>
                        <input type="text" class="form-control form-control-sm" id="mcTplSubject" placeholder="e.g. You're invited — {year} <%= brand.conventionLabel %>" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label form-label-sm" for="mcTplBody">Body</label>
                        <div class="mc-merge-chips mb-1">
                            <span class="mc-merge-label">Insert:</span>
                            <button type="button" class="mc-merge-chip" data-field="{firstName}"       data-target="mcTplBody">First Name</button>
                            <button type="button" class="mc-merge-chip" data-field="{lastName}"        data-target="mcTplBody">Last Name</button>
                            <button type="button" class="mc-merge-chip" data-field="{fullName}"        data-target="mcTplBody">Full Name</button>
                            <button type="button" class="mc-merge-chip mc-link-chip" data-field="{link}"            data-target="mcTplBody">RSVP Link</button>
                            <button type="button" class="mc-merge-chip mc-link-chip" data-field="{respondBy}"       data-target="mcTplBody">Respond By</button>
                            <button type="button" class="mc-merge-chip" data-field="{year}"            data-target="mcTplBody">Convention Year</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftDate}"       data-target="mcTplBody">Shift Date</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftDay}"        data-target="mcTplBody">Shift Day</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftStart}"      data-target="mcTplBody">Shift Start Time</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftEnd}"        data-target="mcTplBody">Shift End Time</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftType}"       data-target="mcTplBody">Shift Type</button>
                            <button type="button" class="mc-merge-chip" data-field="{shiftLabel}"      data-target="mcTplBody">Shift</button>
                            <button type="button" class="mc-merge-chip" data-field="{locationName}"    data-target="mcTplBody">Location</button>
                            <button type="button" class="mc-merge-chip" data-field="{locationAddress}" data-target="mcTplBody">Address</button>
                            <button type="button" class="mc-merge-chip" data-field="{locationMapsUrl}" data-target="mcTplBody">Google Maps Link</button>
                        </div>
                        <textarea class="form-control form-control-sm mc-tpl-body" id="mcTplBody" rows="14" placeholder="Hi {firstName}, …"></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="mcTplCancelBtn">Cancel</button>
                        <button type="button" class="btn btn-primary btn-sm" id="mcTplSaveBtn">Save template</button>
                    </div>
                    <div class="mt-2" id="mcTplStatus"></div>
                </div>

                </div>

                <%# Subject (email only) %>
                <div class="mb-3" id="mcSubjectWrap">
                    <label class="form-label" for="mcSubject">Subject <span class="text-muted small fw-normal">(email)</span></label>
                    <div class="mc-merge-chips mb-1">
                        <span class="mc-merge-label">Insert:</span>
                        <button type="button" class="mc-merge-chip" data-field="{firstName}" data-target="mcSubject">First Name</button>
                        <button type="button" class="mc-merge-chip" data-field="{lastName}"  data-target="mcSubject">Last Name</button>
                        <button type="button" class="mc-merge-chip" data-field="{fullName}"  data-target="mcSubject">Full Name</button>
                        <button type="button" class="mc-merge-chip" data-field="{year}"      data-target="mcSubject">Convention Year</button>
                    </div>
                    <input type="text" class="form-control" id="mcSubject" placeholder="e.g. You're invited — {year} <%= brand.conventionLabel %>" />
                </div>

                <%# Body %>
                <div class="mb-1">
                    <label class="form-label" for="mcBody">Message</label>
                    <div class="mc-merge-chips mb-1">
                        <span class="mc-merge-label">Insert:</span>
                        <button type="button" class="mc-merge-chip" data-field="{firstName}"       data-target="mcBody">First Name</button>
                        <button type="button" class="mc-merge-chip" data-field="{lastName}"        data-target="mcBody">Last Name</button>
                        <button type="button" class="mc-merge-chip" data-field="{fullName}"        data-target="mcBody">Full Name</button>
                        <button type="button" class="mc-merge-chip mc-link-chip" data-field="{link}"            data-target="mcBody">RSVP Link</button>
                        <button type="button" class="mc-merge-chip mc-link-chip" data-field="{respondBy}"       data-target="mcBody">Respond By</button>
                        <button type="button" class="mc-merge-chip" data-field="{year}"            data-target="mcBody">Convention Year</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftDate}"       data-target="mcBody">Shift Date</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftDay}"        data-target="mcBody">Shift Day</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftStart}"      data-target="mcBody">Shift Start Time</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftEnd}"        data-target="mcBody">Shift End Time</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftType}"       data-target="mcBody">Shift Type</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{shiftLabel}"      data-target="mcBody">Shift</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{locationName}"    data-target="mcBody">Location</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{locationAddress}" data-target="mcBody">Address</button>
                        <button type="button" class="mc-merge-chip mc-event-chip" data-field="{locationMapsUrl}" data-target="mcBody">Google Maps Link</button>
                    </div>
                    <textarea class="form-control" id="mcBody" rows="8" placeholder="Hi {firstName}, …" aria-describedby="mcSmsCounter"></textarea>
                </div>
                <p class="mc-sms-counter small text-muted mb-0 d-none" id="mcSmsCounter" aria-live="polite"></p>
            </section>

            <%# ══ Step 5 — Review and send ════════════════════════════════════ %>
            <section class="mc-card mc-step" id="mcStepReview" aria-labelledby="mcStepReviewTitle">
                <h2 class="mc-step-title" id="mcStepReviewTitle"><span class="mc-step-num" aria-hidden="true">5</span>Review and send</h2>

                <div class="mc-preview-wrap mb-3">
                    <div class="text-muted small mb-1" id="mcPreviewLabel">Preview</div>
                    <div class="mc-preview" id="mcPreview" aria-live="polite">
                        <span class="text-muted">Pick recipients and write a message to see it here.</span>
                    </div>
                </div>

                <dl class="mc-review-counts mb-3" id="mcReviewCounts"></dl>

                <div class="mc-send-bar">
                    <button type="button" class="btn btn-primary" id="mcSendBtn" disabled>
                        <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>
                        Send to <span id="mcSendBtnCount">0</span> <span id="mcSendBtnPlural">people</span>
                    </button>
                    <span class="mc-send-hint text-muted small" id="mcSendHint">Select recipients and compose a message to send.</span>
                </div>
            </section>

            <%# ── Results log ───────────────────────────────────────────────── %>
            <section class="mc-card d-none" id="mcResultsCard">
                <div class="mc-card-header">
                    <h2 class="mc-card-title">
                        <i class="fa-solid fa-circle-check me-2"></i>Send Results
                    </h2>
                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary" id="mcResultsDismiss">
                        Dismiss
                    </button>
                </div>
                <div id="mcResultsBody"></div>
            </section>

        </main>

    </div><!-- /.mc-layout -->

    <%# ── Hidden inputs ────────────────────────────────────────────────────── %>
    <input type="hidden" id="mcCsrfToken" value="<%= csrfToken %>" />

    <%# ── Embedded JSON data ────────────────────────────────────────────────── %>
    <script id="mc-volunteer-data" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(volunteers) %>
    </script>
    <script id="mc-template-data" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(templates) %>
    </script>
    <script id="mc-convention-days-data" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(conventionDays) %>
    </script>
    <script id="mc-batches-data" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(batches) %>
    </script>
    <script id="mc-preselected-batch" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(preselectedBatch) %>
    </script>
    <script id="mc-pending-volunteer-ids" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(pendingVolunteerIds) %>
    </script>
    <script id="mc-select-pending" type="application/json" nonce="<%= nonce %>">
        <%- jsonForScript(!!selectPending) %>
    </script>

    <%# ── Type / behavior confirmation modal ───────────────────────────────── %>
    <div class="modal fade" id="mcConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h2 class="modal-title h6" id="mcConfirmTitle">Heads up</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body small" id="mcConfirmBody"></div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" id="mcConfirmCancelBtn" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="mcConfirmOkBtn">Continue</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/campaignCenter.js"></script>
    <script type="module" src="/js/tours/campaignTour.js"></script>

</body>
</html>