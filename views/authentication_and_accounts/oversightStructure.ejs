<!DOCTYPE html>
<html lang="en">
<head>
  <title>Oversight Structure — Albany JW Parking</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
  <link rel="stylesheet" type="text/css" href="/styles/oversightStructure.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shepherd.js@15.2.2/dist/css/shepherd.css" />
  <link rel="stylesheet" href="/css/tours.css" />
</head>
<body class="min-vh-100 bg-body-tertiary" data-authed="true">
  <%- include('../partials/header') %>

  <main class="container-fluid py-4 px-4">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-9">

        <section class="card shadow-lg admin-console-card">
          <header class="card-header">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
              <h1 class="h4 mb-0">
                <i class="fa-solid fa-sitemap me-2"></i>Oversight Structure
              </h1>
              <a href="/oversight/tools" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i>Oversight Tools
              </a>
            </div>
            <p class="text-muted small mb-0 mt-1">
              Define the oversight structure shown on volunteers' home pages.
              Drag rows to reorder. Use ← → to change the oversight structure level.
            </p>
          </header>

          <div class="card-body">

            <%# Volunteer data for JS %>
            <script id="ch-volunteers-data" type="application/json">
              <%- JSON.stringify(volunteers.map(v => ({
                id: v.id,
                name: v.lastName + ', ' + v.firstName + (v.suffix ? ' ' + v.suffix : '')
              }))) %>
            </script>
            <script id="ch-oversightstructure-data" type="application/json">
              <%- JSON.stringify(rawOversightStructure) %>
            </script>
            <input type="hidden" id="ch-csrf" value="<%= csrfToken %>" />

            <%# Toolbar %>
            <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
              <button type="button" class="btn btn-outline-primary btn-sm" id="chAddRootBtn">
                <i class="fa-solid fa-plus me-1"></i>Add root node
              </button>
              <button type="button" class="btn btn-primary btn-sm" id="chSaveBtn">
                <i class="fa-solid fa-floppy-disk me-1"></i>Save order
              </button>
              <span class="text-muted small" id="chSaveStatus"></span>
            </div>

            <%# Tree editor — populated by JS %>
            <div id="chTree" class="ch-tree"></div>

          </div>
        </section>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/js/oversightStructure.js"></script>
  <script type="module" src="/js/tours/oversightStructureTour.js"></script>
</body>
</html>
