<header class="py-2 mb-4">
  <nav class="navbar navbar-expand-lg navbar-light site-navbar shadow-sm">
    <div class="container-fluid">

      <!-- Brand — always far left -->
      <a class="navbar-brand d-flex align-items-center" href="/">
        <i class="fa-solid fa-car-side me-1"></i>
        Albany JW Parking
      </a>

      <!-- Mobile: banner sits here, outside the collapse, below brand row -->
      <% const navState = nav || {}; %>
      <% if (navState.showDraftBanner) { %>
        <div class="draft-banner-nav d-lg-none w-100 mt-1 mb-1 order-3">
          <a href="/continue-registration/auto" class="draft-banner-link">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            Unfinished profile — click here
          </a>
        </div>
      <% } %>

      <!-- Hamburger -->
      <button class="navbar-toggler order-2" type="button"
              data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Collapsible content -->
      <div class="collapse navbar-collapse" id="mainNav">
        <%
          const showUpgrade         = navState.canUpgrade;
          const showContinueReg     = navState.showContinueRegistration;
          const showMyAccount       = navState.isLoggedIn;
          const showAccountDropdown = showUpgrade || showContinueReg || showMyAccount;

          const _ROLE_ORDER_NAV = ['NON_REGISTERED','REGISTERED', 'DESK', 'KEYMAN','OVERSEER','ASSISTANT_ADMIN','ADMIN'];
          const _navRole        = navState.userRole || 'NON_REGISTERED';
          const _navRoleLevel   = _ROLE_ORDER_NAV.indexOf(_navRole);
          const isAtLeast       = (r) => _navRoleLevel >= _ROLE_ORDER_NAV.indexOf(r);
          const can             = (permission) => !!(userPermissions && userPermissions[_navRole] && userPermissions[_navRole][permission]);
        %>

        <!-- Nav items — left side, spread with auto margins -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

          <li class="nav-item">
            <a class="nav-link" href="/">
              <i class="fa-solid fa-house me-1"></i>
              Home
            </a>
          </li>

          <% if (navState.isLoggedIn && isAtLeast('REGISTERED')) { %>

            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="resourcesDropdown"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-folder-open me-1"></i>
                Resources
              </a>
              <ul class="dropdown-menu" aria-labelledby="resourcesDropdown">
                <li>
                  <a class="dropdown-item" href="/maps">
                    <i class="fa-solid fa-map me-1"></i>
                    Maps
                  </a>
                </li>
                <% if (can('viewSigns')) { %>
                <li>
                  <a class="dropdown-item" href="/signs">
                    <i class="fa-solid fa-signs-post me-1"></i>
                    Sign Library
                  </a>
                </li>
                <% } %>
                <li>
                  <a class="dropdown-item" href="/schedules">
                    <i class="fa-regular fa-calendar-days me-1"></i>
                    Schedules
                  </a>
                </li>
              </ul>
            </li>

            

            <% if (can('viewSigns') || isAtLeast('KEYMAN') || _navRole === 'DESK'){ %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="oversightDropdown"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false"
                 data-bs-auto-close="outside">
                <i class="fa-solid fa-screwdriver-wrench me-1"></i>
                Operations
              </a>
              <ul class="dropdown-menu ot-nav-dropdown" aria-labelledby="oversightDropdown">

                <%# ── All Tools ─────────────────────────────────── %>
                <li>
                  <a class="dropdown-item ot-nav-all-tools" href="/oversight/tools">
                    <i class="fa-solid fa-table-cells-large me-2"></i>All Tools
                  </a>
                </li>

                <% if (can('accessAdminConsole')) { %>
                <%# ── Communications ─────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavComms">
                    <span><i class="fa-solid fa-paper-plane me-2"></i>Communications</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavComms">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/campaigns">
                        <i class="fa-solid fa-envelope-open-text"></i>Campaign Center
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/campaigns/tracker">
                        <i class="fa-solid fa-chart-gantt"></i>Invitation Tracker
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/send-reset">
                        <i class="fa-solid fa-link"></i>Send Reset Link
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('manageRoles') || can('editVolunteerInfo') || can('createVolunteerAccounts') || isAtLeast('OVERSEER')) { %>
                <%# ── Volunteer Management ────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavVolunteers">
                    <span><i class="fa-solid fa-users me-2"></i>Volunteer Management</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavVolunteers">
                    <ul class="ot-nav-items">
                      <% if (can('editVolunteerInfo')) { %>
                        <li><a class="ot-nav-item" href="/editVolunteer">
                          <i class="fa-solid fa-id-card"></i>Edit Volunteer
                        </a></li>
                      <% } %>
                      <% if (can('createVolunteerAccounts')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/create-volunteer">
                          <i class="fa-solid fa-user-plus"></i>Create Volunteer
                        </a></li>
                      <% } %>
                      <% if (can('manageRoles') || isAtLeast('OVERSEER')) { %>
                        <li><a class="ot-nav-item" href="/oversight/roles">
                          <i class="fa-solid fa-user-shield"></i>Role Management
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (isAtLeast('OVERSEER')) { %>
                <%# ── Reports ─────────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavReports">
                    <span><i class="fa-solid fa-chart-bar me-2"></i>Reports</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavReports">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/reports">
                        <i class="fa-solid fa-clipboard-list"></i>Application Status
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('viewSigns') || can('manageSigns')) { %>
                <%# ── Signs %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavSigns">
                    <span><i class="fa-solid fa-signs-post me-2"></i>Signs</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavSigns">
                    <ul class="ot-nav-items">
                      <% if (can('viewSigns')) { %>
                        <li><a class="ot-nav-item" href="/signs">
                          <i class="fa-solid fa-table-list"></i>Sign Library
                        </a></li>
                      <% } %>
                      <% if (can('manageSigns')) { %>
                        <li><a class="ot-nav-item" href="/signs/builder">
                          <i class="fa-solid fa-pen-to-square"></i>Sign Builder
                        </a></li>
                      <% } %>
                      <% if (can('viewSigns')) { %>
                        <li><a class="ot-nav-item" href="/signs/map">
                          <i class="fa-solid fa-map-location-dot"></i>Sign Map
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('manageShifts') || can('accessAdminConsole')) { %>
                <%# ── Scheduling ──────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavScheduling">
                    <span><i class="fa-regular fa-calendar-days me-2"></i>Scheduling</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavScheduling">
                    <ul class="ot-nav-items">
                      <% if (can('manageShifts')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/timelines">
                          <i class="fa-regular fa-clock"></i>Timelines
                        </a></li>
                        <li><a class="ot-nav-item" href="/oversight/tools/locationsAndTasks">
                          <i class="fa-solid fa-map-pin"></i>Locations
                        </a></li>
                      <% } %>
                      <% if (can('accessAdminConsole')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/timelines/event-types">
                          <i class="fa-solid fa-tags"></i>Event Types
                        </a></li>
                      <% } %>
                      <% if (can('createAssignments')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/crew-assignments">
                          <i class="fa-solid fa-people-group"></i>Crew Assignments
                        </a></li>
                        <li><a class="ot-nav-item" href="/oversight/tools/scheduler">
                          <i class="fa-solid fa-calendar-days"></i>Scheduler
                        </a></li>
                      <% } %>
                      <% if (can('accessAdminConsole')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/shift-alerts">
                          <i class="fa-solid fa-bell"></i>Shift Alerts
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('logAttendance') || can('viewAttendance')) { %>
                <%# ── Attendance ───────────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavAttendance">
                    <span><i class="fa-solid fa-clipboard-check me-2"></i>Attendance</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavAttendance">
                    <ul class="ot-nav-items">
                      <% if (can('logAttendance')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/attendance/checkin">
                          <i class="fa-solid fa-clipboard-check"></i>Check-In Tool
                        </a></li>
                      <% } %>
                      <% if (can('viewAttendance')) { %>
                        <li><a class="ot-nav-item" href="/oversight/tools/attendance/report">
                          <i class="fa-solid fa-chart-bar"></i>Attendance Report
                        </a></li>
                      <% } %>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('accessAdminConsole')) { %>
                <%# ── Decently Sync ───────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavDecently">
                    <span><i class="fa-solid fa-rotate me-2"></i>Decently Sync</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavDecently">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/decently-export">
                        <i class="fa-solid fa-file-export"></i>Export to Decently
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/decently-import">
                        <i class="fa-solid fa-file-import"></i>Import from Decently
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

                <% if (can('manageRoles') && isAtLeast('ADMIN')) { %>
                <%# ── Administration ─────────────────────────────── %>
                <li>
                  <button class="ot-nav-category" type="button"
                          data-bs-toggle="collapse"
                          data-bs-target="#otNavAdmin">
                    <span><i class="fa-solid fa-gear me-2"></i>Administration</span>
                    <i class="fa-solid fa-chevron-down ot-nav-chevron"></i>
                  </button>
                </li>
                <li>
                  <div class="collapse show" id="otNavAdmin">
                    <ul class="ot-nav-items">
                      <li><a class="ot-nav-item" href="/oversight/tools/permissions">
                        <i class="fa-solid fa-sliders"></i>Permission Matrix
                      </a></li>
                      <li><a class="ot-nav-item" href="/oversight/tools/oversightstructure">
                        <i class="fa-solid fa-sitemap"></i>Oversight Structure
                      </a></li>
                    </ul>
                  </div>
                </li>
                <% } %>

              </ul>
            </li>
            <% } %>

          <% } %>

        </ul>

        <!-- Desktop banner — between nav items and right controls -->
        <% if (navState.showDraftBanner) { %>
          <div class="draft-banner-nav d-none d-lg-flex me-3">
            <a href="/continue-registration/auto" class="draft-banner-link">
              <i class="fa-solid fa-triangle-exclamation me-1"></i>
              Unfinished profile — click here
            </a>
          </div>
        <% } %>

        <!-- Right-aligned nav: My Account dropdown + logout + avatar -->
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center nav-cta-container">

          <% if (!navState.isLoggedIn) { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">
                <i class="fa-solid fa-right-to-bracket"></i>
                Login
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/create-profile">
                <i class="fa-solid fa-user-plus me-1"></i>Create Profile
              </a>
            </li>
          <% } %>

          <% if (navState.isLoggedIn) { %>

            <% if (showAccountDropdown) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="accountDropdownRight"
                 role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-user me-1"></i>
                My Account
              </a>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdownRight">
                <% if (showUpgrade) { %>
                  <li>
                    <a class="dropdown-item" href="/upgrade">
                      <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                      Upgrade Account
                    </a>
                  </li>
                <% } %>
                <% if (showContinueReg) { %>
                  <li>
                    <a class="dropdown-item" href="/continue-registration/auto">
                      <i class="fa-solid fa-forward-step me-1"></i>
                      Continue Registration
                    </a>
                  </li>
                <% } %>
                <% if (showMyAccount) { %>
                  <li>
                    <a class="dropdown-item" href="/my-account">
                      <i class="fa-solid fa-id-card me-1"></i>
                      My Account
                    </a>
                  </li>
                <% } %>
              </ul>
            </li>
            <% } %>

            <li class="nav-item">
              <form action="/logout" method="POST" class="d-inline">
                <button type="submit" class="nav-link btn btn-link p-0">
                  <i class="fa-solid fa-right-from-bracket"></i>
                  Logout
                </button>
              </form>
            </li>

          <% } %>

          <li class="nav-item ms-2 d-none" id="tourTriggerItem">
            <button type="button" class="btn btn-sm ajwp-tour-trigger" id="tourTriggerBtn">
              <i class="fa-solid fa-circle-question me-1"></i>Tour
            </button>
          </li>

          <li class="nav-item ms-2">
            <div class="nav-avatar"
                 title="<%= navState.isLoggedIn ? 'Registered User' : 'Guest User' %>">
              <svg viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <polygon points="18,6 25,22 11,22" fill="#fb8500"/>
                <polygon points="15.5,10 20.5,10 22.5,16 13.5,16" fill="white" opacity="0.9"/>
                <polygon points="13,18 23,18 25,22 11,22" fill="white" opacity="0.9"/>
                <rect x="10" y="22" width="16" height="3" rx="1" fill="#fb8500"/>
                <% if (navState.isLoggedIn && navState.userInitials) { %>
                  <text x="18" y="32"
                        text-anchor="middle"
                        dominant-baseline="central"
                        class="nav-avatar-initials">
                    <%= navState.userInitials %>
                  </text>
                <% } %>
              </svg>
            </div>
          </li>

        </ul>
      </div>
    </div>
  </nav>
</header>