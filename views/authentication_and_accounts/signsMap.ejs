<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sign Map — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/signs.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary signs-map-body" data-authed="true">
    <%- include('../partials/header') %>

    <%
        // Role helpers must be inlined per template — variables inside
        // include() partials are not in scope here.
        const _role     = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
        const _perms    = typeof userPermissions !== 'undefined' ? userPermissions : {};
        const can       = (permission) => !!(_perms[_role] && _perms[_role][permission]);
        const canManage = can('manageSigns');
    %>

    <main class="container-fluid py-3">
        <div class="row g-3 signs-map-row"
             id="signsMapRoot"
             data-can-manage="<%= canManage ? '1' : '0' %>"
             data-api-key="<%= googleMapsApiKey %>"
             data-center-lat="<%= defaultMapCenter.lat %>"
             data-center-lng="<%= defaultMapCenter.lng %>"
             data-center-zoom="<%= defaultMapCenter.zoom %>">

            <%# ──────────────────────────────────────────────────────────
                LEFT COLUMN: filters + placement list
            ────────────────────────────────────────────────────────── %>
            <aside class="col-12 col-lg-4 col-xl-3">
                <section class="card shadow-sm admin-console-card signs-map-side">
                    <header class="card-header d-flex align-items-center justify-content-between">
                        <h1 class="h5 mb-0">
                            <i class="fa-solid fa-map-location-dot me-2"></i>Sign Map
                        </h1>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-muted d-lg-none"
                                    id="sidebarFiltersToggle"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#sidebarFiltersBody"
                                    aria-expanded="false"
                                    aria-controls="sidebarFiltersBody"
                                    aria-label="Toggle filters">
                                <i class="fa-solid fa-filter me-1"></i>Filters
                                <i class="fa-solid fa-chevron-down signs-sidebar-chevron ms-1"></i>
                            </button>
                            <a href="/signs" class="btn btn-link btn-sm p-0">
                                <i class="fa-solid fa-arrow-left me-1"></i>Library
                            </a>
                        </div>
                    </header>

                    <div class="collapse show" id="sidebarFiltersBody">
                    <div class="card-body">

                        <%# Filters %>
                        <h6 class="text-muted mb-2">
                            <i class="fa-solid fa-filter me-1"></i>Filter placements
                        </h6>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase text-muted mb-1">
                                Status
                            </label>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="Status filter">
                                <input type="radio" class="btn-check" name="statusFilter" id="statusAll" value="" checked />
                                <label class="btn btn-outline-secondary" for="statusAll">All</label>

                                <input type="radio" class="btn-check" name="statusFilter" id="statusPlanned" value="planned" />
                                <label class="btn btn-outline-secondary" for="statusPlanned">Planned</label>

                                <input type="radio" class="btn-check" name="statusFilter" id="statusInstalled" value="installed" />
                                <label class="btn btn-outline-secondary" for="statusInstalled">Installed</label>

                                <input type="radio" class="btn-check" name="statusFilter" id="statusRemoved" value="removed" />
                                <label class="btn btn-outline-secondary" for="statusRemoved">Removed</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="signTemplateFilter" class="form-label small text-uppercase text-muted mb-1">
                                Sign template
                            </label>
                            <select class="form-select form-select-sm" id="signTemplateFilter">
                                <option value="">All templates</option>
                                <%
                                    // Arrow direction → Unicode glyph for <option> display.
                                    // <select> elements can't render HTML, so we use Unicode
                                    // characters here even though the destination pin is a
                                    // FontAwesome icon everywhere else on the page.
                                    const arrowGlyphForOption = (dir) => {
                                        switch (dir) {
                                            case 'up':            return '↑';
                                            case 'down':          return '↓';
                                            case 'left':          return '←';
                                            case 'right':         return '→';
                                            case 'up-left':       return '↖';
                                            case 'up-right':      return '↗';
                                            case 'down-left':     return '↙';
                                            case 'down-right':    return '↘';
                                            case 'up-then-left':  return '↰';
                                            case 'up-then-right': return '↱';
                                            case 'destination':   return '📍';
                                            default:              return '';
                                        }
                                    };
                                    const optionLabel = (s) => {
                                        const glyph = arrowGlyphForOption(s.arrow_direction);
                                        const arrowPart = glyph ? ` ${glyph}` : '';
                                        const descPart  = s.description ? ` — ${s.description}` : '';
                                        return `${s.sign_text}${arrowPart}${descPart} (#${s.sign_id})`;
                                    };
                                %>
                                <% signs.forEach(s => { %>
                                    <option value="<%= s.sign_id %>"><%= optionLabel(s) %></option>
                                <% }); %>
                            </select>
                        </div>

                        <% if (canManage) { %>
                            <hr class="my-2" />
                            <div class="d-flex gap-2 mb-3">
                                <button type="button" class="btn btn-primary btn-sm flex-fill" id="addPlacementBtn">
                                    <i class="fa-solid fa-plus me-1"></i>Add placement
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="geotagNewBtn"
                                        title="Place at my current GPS location">
                                    <i class="fa-solid fa-location-crosshairs"></i>
                                </button>
                            </div>
                            <p class="small text-muted mb-3" id="addPlacementHelp" hidden>
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Click anywhere on the map to drop a placement.
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1" id="cancelAddBtn">Cancel</button>
                            </p>
                        <% } %>

                        <div class="signs-placement-list" id="placementList">
                            <%# Filled by JS so search/filter stays in one place. %>
                        </div>

                        <hr class="my-2" />

                        <%# ── Legend (collapsible) ─────────────────────────────── %>
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small text-uppercase text-muted fw-semibold">
                                <i class="fa-solid fa-circle-info me-1"></i>Legend &amp; Shortcuts
                            </span>
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-muted"
                                    id="legendToggleBtn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#mapLegendPanel"
                                    aria-expanded="false"
                                    aria-controls="mapLegendPanel">
                                <i class="fa-solid fa-chevron-down signs-legend-chevron"></i>
                            </button>
                        </div>

                        <div class="collapse" id="mapLegendPanel">
                            <%# Status ─────────────────────────────────────────── %>
                            <p class="small text-muted mb-1 fw-semibold">Status</p>
                            <ul class="signs-legend-list mb-2">
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-planned signs-legend-dot"></span>
                                    Planned
                                </li>
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-installed signs-legend-dot"></span>
                                    Installed
                                </li>
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-removed signs-legend-dot"></span>
                                    Removed
                                </li>
                            </ul>

                            <%# Marker colours ───────────────────────────────── %>
                            <p class="small text-muted mb-1 fw-semibold">Marker colours</p>
                            <div class="signs-legend-swatches mb-2">
                                <span class="signs-legend-swatch" style="background:#6c757d" title="Default (status)"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-red"    title="Red"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-orange" title="Orange"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-yellow" title="Yellow"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-green"  title="Green"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-teal"   title="Teal"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-blue"   title="Blue"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-purple" title="Purple"></span>
                                <span class="signs-legend-swatch signs-legend-swatch-pink"   title="Pink"></span>
                            </div>

                            <%# Keyboard shortcuts ───────────────────────────── %>
                            <p class="small text-muted mb-1 fw-semibold">Keyboard shortcuts</p>
                            <ul class="signs-legend-list signs-legend-shortcuts mb-0">
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys">
                                        <kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd>
                                    </span>
                                    Nudge selected marker 0.5 m
                                </li>
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys">
                                        <kbd>Shift</kbd>+<kbd>arrow</kbd>
                                    </span>
                                    Nudge 5 m (coarse)
                                </li>
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys">
                                        <kbd>Shift</kbd>+drag marker
                                    </span>
                                    Move marker on map
                                </li>
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys">
                                        <kbd>Shift</kbd>+drag handle
                                    </span>
                                    Rotate direction of travel
                                </li>
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys"><kbd>Esc</kbd></span>
                                    Deselect / close overlay
                                </li>
                                <li class="d-none d-lg-flex">
                                    <span class="signs-legend-keys">Right-click</span>
                                    Context menu
                                </li>
                                <li class="d-lg-none">
                                    <span class="signs-legend-keys">Tap marker</span>
                                    View details &amp; actions
                                </li>
                            </ul>

                            <%# Travel direction handle ───────────────────────── %>
                            <p class="small text-muted mb-1 fw-semibold mt-2 d-none d-lg-block">Direction of travel arrow</p>
                            <ul class="signs-legend-list mb-0 d-none d-lg-flex flex-column">
                                <li>
                                    <span class="signs-legend-keys"><kbd>Shift</kbd>+drag handle</span>
                                    Set direction drivers travel toward sign
                                </li>
                                <li>
                                    <span class="signs-legend-keys">Dashed arrow</span>
                                    No direction set yet
                                </li>
                            </ul>
                        </div>

                    </div>
                    </div>  
                </section>
            </aside>

            <%# ──────────────────────────────────────────────────────────
                RIGHT COLUMN: the map
            ────────────────────────────────────────────────────────── %>
            <div class="col-12 col-lg-8 col-xl-9">
                <section class="card shadow-sm admin-console-card signs-map-wrapper">

                    <% if (!googleMapsApiKey) { %>
                        <div class="signs-map-missing-key p-5 text-center">
                            <i class="fa-solid fa-key fa-2x mb-3 text-warning"></i>
                            <h2 class="h5">Google Maps API key not configured</h2>
                            <p class="text-muted mb-0">
                                Set <code>GOOGLE_MAPS_API_KEY</code> in the environment
                                (or <code>GoogleMapsApiKey</code> in Key Vault) and restart the server.
                            </p>
                        </div>
                    <% } else { %>
                        <div id="googleMap" class="signs-map-canvas">
                            <div class="signs-map-loading">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading…</span>
                                </div>
                            </div>
                        </div>
                    <% } %>

                </section>
            </div>

        </div>
    </main>

    <%# ──────────────────────────────────────────────────────────
        INFO SHEET: tap-to-peek card (slides up from bottom)
        Populated entirely by JS; shown on marker tap for all users.
        On desktop, also available from the placement list.
    ────────────────────────────────────────────────────────── %>
    <div class="signs-info-sheet d-none" id="signsInfoSheet" aria-modal="true" role="dialog" aria-label="Placement details">
        <div class="signs-info-sheet-handle" id="signsInfoSheetHandle" aria-hidden="true"></div>
        <div class="signs-info-sheet-header" id="signsInfoSheetHeader">
            <%# JS populates: sign preview + status badge + close button %>
        </div>
        <div class="signs-info-sheet-body" id="signsInfoSheetBody">
            <%# JS populates: details dl, thumbnail, action buttons %>
        </div>
    </div>
    <div class="signs-info-sheet-backdrop d-none" id="signsInfoSheetBackdrop"></div>

    <%# ──────────────────────────────────────────────────────────
        OFFCANVAS: placement editor (slides in from the right)
    ────────────────────────────────────────────────────────── %>
    <div class="offcanvas offcanvas-end signs-placement-offcanvas"
         tabindex="-1"
         id="placementEditor"
         aria-labelledby="placementEditorTitle">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5 mb-0" id="placementEditorTitle">Placement</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">

            <%# Sign template picker (only for new placements) %>
            <div class="mb-3" id="editorSignTemplateRow" hidden>
                <label for="editorSignTemplate" class="form-label">
                    Sign template <span class="text-danger">*</span>
                </label>
                <select class="form-select" id="editorSignTemplate">
                    <option value="">Pick a sign…</option>
                    <% signs.forEach(s => { %>
                        <option value="<%= s.sign_id %>"
                                data-text="<%= s.sign_text %>"
                                data-arrow="<%= s.arrow_direction || '' %>">
                            <%= optionLabel(s) %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <%# Preview of selected sign %>
            <div class="mb-3 text-center">
                <p class="text-muted small mb-2">Sign preview</p>
                <div class="sign-preview mx-auto" id="editorPreview">
                    <span class="sign-preview-text" id="editorPreviewText">—</span>
                    <span class="sign-preview-arrow" id="editorPreviewArrow"></span>
                </div>
            </div>

            <%# Arrow direction (per-placement) %>
            <div class="mb-3" id="editorArrowRow">
                <label class="form-label">Direction</label>
                <div class="arrow-picker arrow-picker-sm" role="radiogroup" aria-label="Arrow direction">
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-left" aria-label="Up-left">↖</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up" aria-label="Up">↑</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-right" aria-label="Up-right">↗</button>

                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="left" aria-label="Left">←</button>
                    <button type="button" class="arrow-btn arrow-btn-sm arrow-btn-none" data-arrow="" aria-label="No arrow">
                        <i class="fa-solid fa-ban"></i>
                    </button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="right" aria-label="Right">→</button>

                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down-left" aria-label="Down-left">↙</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down" aria-label="Down">↓</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down-right" aria-label="Down-right">↘</button>

                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-then-left" aria-label="Up then left">↰</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-then-right" aria-label="Up then right">↱</button>
                    <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="destination" aria-label="Destination pin">
                        <i class="fa-solid fa-location-dot"></i>
                    </button>
                </div>
                <input type="hidden" id="editorArrowDirection" value="" />
                <div class="form-text small">Direction for this specific placement.</div>
            </div>

            <%# Coordinates %>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="editorLat" class="form-label small">Latitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm" id="editorLat"
                           <%= canManage ? '' : 'readonly' %> />
                </div>
                <div class="col-6">
                    <label for="editorLng" class="form-label small">Longitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm" id="editorLng"
                           <%= canManage ? '' : 'readonly' %> />
                </div>
                <% if (canManage) { %>
                    <div class="col-12">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" id="geotagUpdateBtn">
                            <i class="fa-solid fa-location-crosshairs me-1"></i>Update to my location
                        </button>
                    </div>
                <% } %>
                <div class="form-text small" id="editorCoordsHint">Drag the marker on the map to reposition.</div>
            </div>

            <%# Mount type %>
            <div class="mb-3">
                <label for="editorMountType" class="form-label">Mounted on</label>
                <select class="form-select" id="editorMountType">
                    <option value="">Not specified</option>
                    <option value="cone">Cone</option>
                    <option value="a-frame">A-frame</option>
                    <option value="existing-structure">Existing structure (pole, wall, etc.)</option>
                </select>
            </div>

            <%# Status %>
            <div class="mb-3">
                <label class="form-label">Status</label>
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="editorStatus" id="editorStatusPlanned" value="planned" checked />
                    <label class="btn btn-outline-secondary" for="editorStatusPlanned">Planned</label>

                    <input type="radio" class="btn-check" name="editorStatus" id="editorStatusInstalled" value="installed" />
                    <label class="btn btn-outline-success" for="editorStatusInstalled">Installed</label>

                    <input type="radio" class="btn-check" name="editorStatus" id="editorStatusRemoved" value="removed" />
                    <label class="btn btn-outline-danger" for="editorStatusRemoved">Removed</label>
                </div>
            </div>

            <%# Marker colour %>
            <% if (canManage) { %>
                <div class="mb-3">
                    <label class="form-label">Marker colour</label>
                    <div class="signs-color-swatches" id="editorColorSwatches">
                        <button type="button" class="signs-color-swatch signs-color-swatch-default active"
                                data-color="" title="Default (status)">
                            <i class="fa-solid fa-ban" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-red"
                                data-color="red" title="Red"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-orange"
                                data-color="orange" title="Orange"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-yellow"
                                data-color="yellow" title="Yellow"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-green"
                                data-color="green" title="Green"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-teal"
                                data-color="teal" title="Teal"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-blue"
                                data-color="blue" title="Blue"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-purple"
                                data-color="purple" title="Purple"></button>
                        <button type="button" class="signs-color-swatch signs-color-swatch-pink"
                                data-color="pink" title="Pink"></button>
                    </div>
                    <button type="button" class="btn btn-link btn-sm p-0 mt-1" id="editorBulkColorBtn" hidden>
                        Apply to all placements of this sign
                    </button>
                </div>
            <% } %>

            <%# Direction of travel (bearing drivers travel toward this sign) %>
            <div class="mb-3">
                <label for="editorHeading" class="form-label">
                    Direction of travel <span class="text-muted small">(0–360°, optional)</span>
                </label>
                <input type="number" min="0" max="360" step="1" class="form-control" id="editorHeading"
                       placeholder="e.g. 90 = eastbound traffic" />
                <div class="form-text">
                    The bearing drivers travel <em>toward</em> this sign. Shown as a direction arrow
                    on the map marker and used to position Street View. Leave blank if unknown.
                    Drag the arrow handle on the map marker to set visually.
                </div>
            </div>

            <%# Location notes %>
            <div class="mb-3">
                <label for="editorNotes" class="form-label">Location notes</label>
                <textarea class="form-control" id="editorNotes" rows="3" maxlength="500"
                          placeholder="e.g. On telephone pole, NE corner of Central & Madison"></textarea>
            </div>

            <%# Photo section %>
            <div class="mb-3 signs-photo-section" id="editorPhotoSection">
                <label class="form-label d-flex align-items-center justify-content-between">
                    <span>Photo of installed sign</span>
                    <span class="small text-muted" id="editorPhotoHint">(optional)</span>
                </label>

                <%# No-photo state: drop zone %>
                <div class="signs-photo-dropzone" id="editorPhotoDropzone" hidden>
                    <input type="file"
                           class="d-none"
                           id="editorPhotoInput"
                           accept="image/*" />
                    <% if (canManage) { %>
                        <button type="button" class="signs-photo-dropzone-button" id="editorPhotoChooseBtn">
                            <i class="fa-solid fa-camera fa-2x mb-2"></i>
                            <div class="fw-semibold">Add photo</div>
                            <div class="small text-muted">Drop an image or click to choose</div>
                        </button>
                    <% } else { %>
                        <div class="text-center text-muted py-3 small">
                            <i class="fa-regular fa-image me-1"></i>No photo for this placement.
                        </div>
                    <% } %>
                </div>

                <%# Has-photo state: thumbnail + actions %>
                <div class="signs-photo-display" id="editorPhotoDisplay" hidden>
                    <img class="signs-photo-thumb" id="editorPhotoThumb" alt="Sign placement photo" />
                    <% if (canManage) { %>
                        <div class="signs-photo-actions">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="editorPhotoReplaceBtn">
                                <i class="fa-solid fa-arrows-rotate me-1"></i>Replace
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="editorPhotoDeleteBtn">
                                <i class="fa-solid fa-trash me-1"></i>Remove
                            </button>
                        </div>
                    <% } %>
                </div>

                <%# Uploading state %>
                <div class="signs-photo-uploading" id="editorPhotoUploading" hidden>
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Uploading…</span>
                        </div>
                        <span class="small">Uploading and processing…</span>
                    </div>
                </div>

                <p class="small text-danger mt-1 mb-0" id="editorPhotoError" hidden></p>
            </div>

            <%# Audit info (read-only) %>
            <div class="signs-editor-meta small text-muted mb-3" id="editorMeta" hidden>
                <%# JS populates created_by / installed_by etc. %>
            </div>

            <%# Actions %>
            <% if (canManage) { %>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-primary" id="editorSaveBtn">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="editorStreetViewBtn" hidden>
                        <i class="fa-solid fa-street-view me-1"></i>Street View
                    </button>
                    <button type="button" class="btn btn-outline-danger ms-auto" id="editorDeleteBtn" hidden>
                        <i class="fa-solid fa-trash me-1"></i>Delete
                    </button>
                </div>
                <p class="small mt-2" id="editorFeedback"></p>
            <% } else { %>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-outline-secondary" id="editorStreetViewBtn" hidden>
                        <i class="fa-solid fa-street-view me-1"></i>Street View
                    </button>
                </div>
                <p class="small text-muted mt-2 mb-0">
                    <i class="fa-solid fa-eye me-1"></i>View only. OVERSEER+ can edit placements.
                </p>
            <% } %>

        </div>
    </div>

    <%# ──────────────────────────────────────────────────────────
        STREET VIEW OVERLAY
        Fixed full-screen modal; shown/hidden entirely by JS.
        z-index 1095: above offcanvas (1080) and tooltip (1085),
        below photo lightbox (1100).
    ────────────────────────────────────────────────────────── %>
    <div class="signs-sv-overlay d-none" id="streetViewOverlay" aria-modal="true" role="dialog" aria-label="Street View">
        <div class="signs-sv-header">
            <div class="signs-sv-header-info">
                <span class="signs-sv-title" id="svTitle"></span>
                <span class="signs-sv-heading-badge d-none" id="svHeadingBadge"></span>
                <span class="signs-sv-heading-hint d-none" id="svHeadingHint">
                    <i class="fa-solid fa-compass me-1"></i>Rotate to face the sign
                </span>
            </div>
            <button type="button" class="signs-sv-close" id="streetViewCloseBtn" aria-label="Close Street View">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="signs-sv-pane" id="streetViewPane"></div>
        <div class="signs-sv-footer d-none" id="svNoImageryMsg">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            No Street View imagery available for this location.
            <a id="svGoogleMapsLink" href="#" target="_blank" rel="noopener noreferrer" class="ms-2">
                Open in Google Maps
            </a>
        </div>
    </div>

    <%# Inline JSON bootstrap — read by signsMap.js, no inline behavior. %>
    <script id="signsMapBootstrap" type="application/json"><%-
        JSON.stringify({ signs, placements })
    %></script>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/signsMap.js"></script>
</body>
</html>