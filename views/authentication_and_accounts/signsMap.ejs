<!DOCTYPE html>
<html lang="en">
<head>
    <title>Sign Map — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/signs.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary signs-map-body" data-authed="true">
    <%- include('../partials/header') %>

    <%
        const _role     = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
        const _perms    = typeof userPermissions !== 'undefined' ? userPermissions : {};
        const can       = (permission) => !!(_perms[_role] && _perms[_role][permission]);
        const canManage = can('manageSigns');
    %>

    <main class="container-fluid py-3">
        <div class="row g-3 signs-map-row"
             id="signsMapRoot"
             data-can-manage="<%= canManage ? '1' : '0' %>"
             data-api-key="<%= googleMapsApiKey %>"
             data-center-lat="<%= defaultMapCenter.lat %>"
             data-center-lng="<%= defaultMapCenter.lng %>"
             data-center-zoom="<%= defaultMapCenter.zoom %>">

            <%# ──────────────────────────────────────────────────────────
                LEFT COLUMN: filters + location list
            ────────────────────────────────────────────────────────── %>
            <aside class="col-12 col-lg-4 col-xl-3">
                <section class="card shadow-sm admin-console-card signs-map-side">
                    <header class="card-header d-flex align-items-center justify-content-between">
                        <h1 class="h5 mb-0">
                            <i class="fa-solid fa-map-location-dot me-2"></i>Sign Map
                        </h1>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-link btn-sm p-0 text-muted d-lg-none"
                                    id="sidebarFiltersToggle"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#sidebarFiltersBody"
                                    aria-expanded="false"
                                    aria-controls="sidebarFiltersBody"
                                    aria-label="Toggle filters">
                                <i class="fa-solid fa-filter me-1"></i>Filters
                                <i class="fa-solid fa-chevron-down signs-sidebar-chevron ms-1"></i>
                            </button>
                            <a href="/signs/map/print"
                               target="_blank"
                               class="btn btn-link btn-sm p-0 text-muted"
                               title="Printable map">
                                <i class="fa-solid fa-print"></i>
                            </a>
                            <a href="/signs" class="btn btn-link btn-sm p-0">
                                <i class="fa-solid fa-arrow-left me-1"></i>Library
                            </a>
                        </div>
                    </header>

<div class="collapse show" id="sidebarFiltersBody">
                    <div class="card-body signs-sidebar-body">

                        <%# ── Filters & Layers ────────────────────────────────── %>
                        <div class="signs-sidebar-section">
                            <h6 class="signs-sidebar-section-title">
                                <i class="fa-solid fa-sliders me-2"></i>Filters & Layers
                            </h6>

                            <div class="mb-2">
                                <label class="form-label small text-uppercase text-muted mb-1">
                                    Status
                                </label>
                                <div class="btn-group btn-group-sm w-100" role="group" aria-label="Status filter">
                                    <input type="radio" class="btn-check" name="statusFilter" id="statusAll" value="" checked />
                                    <label class="btn btn-outline-secondary" for="statusAll">All</label>

                                    <input type="radio" class="btn-check" name="statusFilter" id="statusPlanned" value="planned" />
                                    <label class="btn btn-outline-secondary" for="statusPlanned">Planned</label>

                                    <input type="radio" class="btn-check" name="statusFilter" id="statusInstalled" value="installed" />
                                    <label class="btn btn-outline-secondary" for="statusInstalled">Installed</label>

                                    <input type="radio" class="btn-check" name="statusFilter" id="statusRemoved" value="removed" />
                                    <label class="btn btn-outline-secondary" for="statusRemoved">Removed</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="signTemplateFilter" class="form-label small text-uppercase text-muted mb-1">
                                    Sign template
                                </label>
                                <select class="form-select form-select-sm" id="signTemplateFilter">
                                    <option value="">All templates</option>
                                    <% signs.forEach(s => { %>
                                        <option value="<%= s.sign_id %>"><%= s.sign_text %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <hr class="my-2" />

                            <div class="signs-layers-list">
                                <div class="form-check form-switch signs-layer-switch">
                                    <input class="form-check-input" type="checkbox"
                                           role="switch" id="layerTrafficArrows" checked />
                                    <label class="form-check-label" for="layerTrafficArrows">
                                        <i class="fa-solid fa-diamond-turn-right signs-layer-icon signs-layer-icon-arrows"></i>
                                        Traffic arrows
                                    </label>
                                </div>
                                <div class="form-check form-switch signs-layer-switch">
                                    <input class="form-check-input" type="checkbox"
                                           role="switch" id="layerSignFacing" />
                                    <label class="form-check-label" for="layerSignFacing">
                                        <i class="fa-solid fa-compass signs-layer-icon signs-layer-icon-facing"></i>
                                        Sign facing
                                    </label>
                                </div>
                            </div>
                        </div>

                        <%# ── Add to Map ───────────────────────────────────────── %>
                        <% if (canManage) { %>
                            <div class="signs-sidebar-section">
                                <h6 class="signs-sidebar-section-title">
                                    <i class="fa-solid fa-map-pin me-2"></i>Add to Map
                                </h6>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm flex-fill" id="addLocationBtn">
                                        <i class="fa-solid fa-plus me-1"></i>Add location
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm flex-fill" id="addArrowBtn">
                                        <i class="fa-solid fa-diamond-turn-right me-1"></i>Add arrow
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="geotagNewBtn"
                                            title="Place at my current GPS location">
                                        <i class="fa-solid fa-location-crosshairs"></i>
                                    </button>
                                </div>
                                <p class="small text-muted mb-0 mt-2" id="addLocationHelp" hidden>
                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    Click anywhere on the map to drop a location.
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" id="cancelAddBtn">Cancel</button>
                                </p>
                                <p class="small text-muted mb-0 mt-2" id="addArrowHelp" hidden>
                                    <i class="fa-solid fa-circle-info me-1"></i>
                                    Click on the road to place a traffic arrow.
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1" id="cancelAddArrowBtn">Cancel</button>
                                </p>
                            </div>
                        <% } %>

                        <%# ── Location list (always visible) ───────────────────── %>
                        <div class="signs-location-list" id="locationList">
                            <%# Filled by JS %>
                        </div>

                    </div>
                    </div>
                </section>
            </aside>

            <%# ──────────────────────────────────────────────────────────
                RIGHT COLUMN: the map
            ────────────────────────────────────────────────────────── %>
            <div class="col-12 col-lg-8 col-xl-9">
                <section class="card shadow-sm admin-console-card signs-map-wrapper">
                    <% if (!googleMapsApiKey) { %>
                        <div class="signs-map-missing-key p-5 text-center">
                            <i class="fa-solid fa-key fa-2x mb-3 text-warning"></i>
                            <h2 class="h5">Google Maps API key not configured</h2>
                            <p class="text-muted mb-0">
                                Set <code>GOOGLE_MAPS_API_KEY</code> in the environment
                                (or <code>GoogleMapsApiKey</code> in Key Vault) and restart.
                            </p>
                        </div>
                    <% } else { %>
                        <div id="googleMap" class="signs-map-canvas">
                            <div class="signs-map-loading">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading…</span>
                                </div>
                            </div>
                        </div>

                        <%# ── Map legend overlay (left edge) ───────────────────── %>
                        <button type="button" class="signs-map-legend-tab" id="mapLegendTab"
                                aria-label="Toggle legend" title="Legend">
                            <i class="fa-solid fa-grip-lines-vertical" aria-hidden="true"></i>
                        </button>
                        <div class="signs-map-legend-panel" id="mapLegendPanel">
                            <div class="signs-map-legend-header">
                                <span class="fw-semibold">Legend</span>
                            </div>

                            <p class="small text-muted mb-1 fw-semibold">Status</p>
                            <ul class="signs-legend-list mb-2">
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-planned signs-legend-dot"></span>
                                    Planned
                                </li>
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-installed signs-legend-dot"></span>
                                    Installed
                                </li>
                                <li>
                                    <span class="signs-placement-dot signs-placement-dot-removed signs-legend-dot"></span>
                                    Removed
                                </li>
                            </ul>

                            <p class="small text-muted mb-1 fw-semibold">Sign types</p>
                            <ul class="signs-legend-list mb-2">
                                <li>
                                    <span class="sign-preview signs-legend-category-pill sign-preview-category-parking">
                                        <span class="sign-category-icon sign-category-icon-parking">P</span>
                                    </span>
                                    Parking
                                </li>
                                <li>
                                    <span class="sign-preview signs-legend-category-pill sign-preview-category-accessible">
                                        <i class="fa-solid fa-wheelchair sign-category-icon" aria-hidden="true"></i>
                                    </span>
                                    Accessible
                                </li>
                                <li>
                                    <span class="sign-preview signs-legend-category-pill">
                                        <i class="fa-solid fa-person-walking-luggage sign-category-icon" aria-hidden="true"></i>
                                    </span>
                                    Drop-off / Pick-up
                                </li>
                                <li>
                                    <span class="sign-preview signs-legend-category-pill sign-preview-category-info">
                                        <i class="fa-solid fa-circle-info sign-category-icon" aria-hidden="true"></i>
                                    </span>
                                    Info
                                </li>
                                <li>
                                    <span class="sign-preview signs-legend-category-pill sign-preview-category-warning">
                                        <i class="fa-solid fa-triangle-exclamation sign-category-icon" aria-hidden="true"></i>
                                    </span>
                                    Warning / Hazard
                                </li>
                            </ul>

                            <p class="small text-muted mb-1 fw-semibold">Traffic arrows</p>
                            <ul class="signs-legend-list mb-2">
                                <li>
                                    <i class="fa-solid fa-diamond-turn-right me-2 signs-legend-arrow-icon"></i>
                                    Direction of travel
                                </li>
                            </ul>

                            <p class="small text-muted mb-1 fw-semibold">Mount types</p>
                            <ul class="signs-legend-list mb-0">
                                <li><i class="fa-solid fa-signs-post me-2 text-muted signs-legend-mount-icon"></i>Pole</li>
                                <li><i class="fa-solid fa-triangle-exclamation me-2 text-muted signs-legend-mount-icon"></i>Cone</li>
                                <li><i class="fa-solid fa-tent me-2 text-muted signs-legend-mount-icon"></i>A-frame</li>
                                <li><i class="fa-solid fa-building me-2 text-muted signs-legend-mount-icon"></i>Existing structure</li>
                            </ul>
                        </div>
                    <% } %>
                    <div class="signs-zoom-indicator" id="zoomIndicator">
                        <span class="signs-zoom-badge" id="zoomLevelBadge">Z 17</span>
                        <input type="number" class="signs-zoom-input" id="zoomLevelInput"
                               min="1" max="22" step="0.1" title="Set zoom level" />
                    </div>
                </section>
            </div>

        </div>
    </main>

    <%# ──────────────────────────────────────────────────────────
        INFO SHEET: tap-to-peek card (slides up from bottom)
    ────────────────────────────────────────────────────────── %>
    <div class="signs-info-sheet d-none" id="signsInfoSheet" aria-modal="true" role="dialog" aria-label="Location details">
        <div class="signs-info-sheet-handle" id="signsInfoSheetHandle" aria-hidden="true"></div>
        <div class="signs-info-sheet-header" id="signsInfoSheetHeader">
            <%# JS populates %>
        </div>
        <div class="signs-info-sheet-body" id="signsInfoSheetBody">
            <%# JS populates %>
        </div>
    </div>
    <div class="signs-info-sheet-backdrop d-none" id="signsInfoSheetBackdrop"></div>

    <%# ──────────────────────────────────────────────────────────
        GEOFENCING: FAB + proximity bar (signsGeofence.js)
    ────────────────────────────────────────────────────────── %>
    <% if (canManage) { %>
        <button type="button" class="signs-geofence-fab d-none" id="signsGeofenceFab"
                aria-label="Track my location" aria-pressed="false">
            <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
        </button>

        <div class="signs-proximity-bar d-none" id="signsProximityBar">
            <div class="signs-proximity-bar-inner">
                <div class="signs-proximity-bar-info" id="signsProximityInfo">
                    <%# JS populates %>
                </div>
                <div class="signs-proximity-bar-photo d-none" id="signsProximityPhoto">
                    <%# JS populates %>
                </div>
                <div class="signs-proximity-bar-actions" id="signsProximityActions">
                    <%# JS populates %>
                </div>
            </div>
            <button type="button" class="signs-proximity-bar-dismiss" id="signsProximityDismiss"
                    aria-label="Dismiss">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
    <% } %>

    <%# ──────────────────────────────────────────────────────────
        OFFCANVAS: location editor (slides in from the right)
    ────────────────────────────────────────────────────────── %>
    <div class="offcanvas offcanvas-end signs-placement-offcanvas"
         tabindex="-1"
         id="locationEditor"
         aria-labelledby="locationEditorTitle">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5 mb-0" id="locationEditorTitle">Location</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">

            <%# ── Coordinates ────────────────────────────────── %>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="editorLat" class="form-label small">Latitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm" id="editorLat"
                           <%= canManage ? '' : 'readonly' %> />
                </div>
                <div class="col-6">
                    <label for="editorLng" class="form-label small">Longitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm" id="editorLng"
                           <%= canManage ? '' : 'readonly' %> />
                </div>
                <% if (canManage) { %>
                    <div class="col-12">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" id="geotagUpdateBtn">
                            <i class="fa-solid fa-location-crosshairs me-1"></i>Update to my location
                        </button>
                    </div>
                <% } %>
            </div>

            <%# ── Mount type ─────────────────────────────────── %>
            <div class="mb-3">
                <label for="editorMountType" class="form-label">Mount type</label>
                <select class="form-select" id="editorMountType" <%= canManage ? '' : 'disabled' %>>
                    <option value="">Not specified</option>
                    <option value="pole">Pole</option>
                    <option value="cone">Cone</option>
                    <option value="a-frame">A-frame</option>
                    <option value="existing-structure">Existing structure</option>
                </select>
            </div>

            <%# ── A-frame bearing (shown only when mount_type = a-frame) ── %>
            <div class="mb-3" id="editorBearingRow" hidden>
                <label for="editorFrontBearing" class="form-label">
                    Front face bearing <span class="text-muted small">(0–360°)</span>
                </label>
                <input type="number" min="0" max="360" step="1" class="form-control" id="editorFrontBearing"
                       placeholder="e.g. 90 = front faces east" <%= canManage ? '' : 'readonly' %> />
                <div class="form-text">Compass direction the front face points toward. Back = front + 180°.</div>
            </div>

            <%# ── Location notes ─────────────────────────────── %>
            <div class="mb-3">
                <label for="editorNotes" class="form-label">Location notes</label>
                <textarea class="form-control" id="editorNotes" rows="2" maxlength="500"
                          placeholder="e.g. On telephone pole, NE corner of Central & Madison"
                          <%= canManage ? '' : 'readonly' %>></textarea>
            </div>

            <%# ── Photo section ──────────────────────────────── %>
            <div class="mb-3 signs-photo-section" id="editorPhotoSection">
                <label class="form-label d-flex align-items-center justify-content-between">
                    <span>Photo</span>
                    <span class="small text-muted" id="editorPhotoHint">(optional)</span>
                </label>
                <p class="small text-muted mb-2" id="editorPhotoCredit" hidden></p>

                <div class="signs-photo-dropzone" id="editorPhotoDropzone" hidden>
                    <input type="file" class="d-none" id="editorPhotoCaptureInput" accept="image/*" capture="environment" />
                    <input type="file" class="d-none" id="editorPhotoUploadInput" accept="image/*" />
                    <% if (canManage) { %>
                        <div class="signs-photo-dropzone-buttons">
                            <button type="button" class="signs-photo-dropzone-button" id="editorPhotoCaptureBtn">
                                <i class="fa-solid fa-camera fa-lg"></i>
                                <span class="fw-semibold">Take Photo</span>
                            </button>
                            <button type="button" class="signs-photo-dropzone-button" id="editorPhotoUploadBtn">
                                <i class="fa-solid fa-upload fa-lg"></i>
                                <span class="fw-semibold">Upload</span>
                            </button>
                        </div>
                    <% } else { %>
                        <div class="text-center text-muted py-3 small">
                            <i class="fa-regular fa-image me-1"></i>No photo for this location.
                        </div>
                    <% } %>
                </div>

                <div class="signs-photo-display" id="editorPhotoDisplay" hidden>
                    <img class="signs-photo-thumb" id="editorPhotoThumb" alt="Location photo" />
                    <% if (canManage) { %>
                        <div class="signs-photo-actions">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="editorPhotoCaptureReplaceBtn">
                                <i class="fa-solid fa-camera me-1"></i>Retake
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="editorPhotoReplaceBtn">
                                <i class="fa-solid fa-upload me-1"></i>Replace
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" id="editorPhotoDeleteBtn">
                                <i class="fa-solid fa-trash me-1"></i>Remove
                            </button>
                        </div>
                    <% } %>
                </div>

                <div class="signs-photo-uploading" id="editorPhotoUploading" hidden>
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Uploading…</span>
                        </div>
                        <span class="small">Uploading and processing…</span>
                    </div>
                </div>
                <p class="small text-danger mt-1 mb-0" id="editorPhotoError" hidden></p>
            </div>

            <%# ══════════════════════════════════════════════════
                ATTACHED SIGNS — drag-to-reorder list
            ══════════════════════════════════════════════════ %>
            <div class="mb-3 border-top pt-3" id="editorAttachmentsSection" hidden>
                <label class="form-label fw-semibold d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-layer-group me-1"></i>Attached Signs</span>
                    <span class="badge bg-secondary" id="editorAttachmentCount">0</span>
                </label>

                <%# Attachment list — populated and reorderable via JS %>
                <div class="signs-attachment-list" id="editorAttachmentList">
                    <%# JS builds rows here %>
                </div>

                <% if (canManage) { %>
                    <%# Add attachment form (collapsed by default) %>
                    <div class="mt-2" id="addAttachmentWrap">
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" id="addAttachmentToggle">
                            <i class="fa-solid fa-plus me-1"></i>Add sign to this location
                        </button>

                        <div class="collapse mt-2" id="addAttachmentForm">
                            <div class="card card-body p-2">
                                <div class="mb-2">
                                    <label for="addAttSignTemplate" class="form-label small mb-1">Sign template</label>
                                    <select class="form-select form-select-sm" id="addAttSignTemplate">
                                        <option value="">Pick a sign…</option>
                                        <% signs.forEach(s => { %>
                                            <option value="<%= s.sign_id %>"
                                                    data-text="<%= s.sign_text %>"
                                                    data-arrow="<%= s.arrow_direction || '' %>">
                                                <%= s.sign_text %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label small mb-1">Arrow on sign</label>
                                    <div class="arrow-picker arrow-picker-sm" role="radiogroup" aria-label="Arrow direction">
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-left" aria-label="Up-left">↖</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up" aria-label="Up">↑</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-right" aria-label="Up-right">↗</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="left" aria-label="Left">←</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm arrow-btn-none active" data-arrow="" aria-label="No arrow">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="right" aria-label="Right">→</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down-left" aria-label="Down-left">↙</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down" aria-label="Down">↓</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="down-right" aria-label="Down-right">↘</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-then-left" aria-label="Up then left">↰</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="up-then-right" aria-label="Up then right">↱</button>
                                        <button type="button" class="arrow-btn arrow-btn-sm" data-arrow="destination" aria-label="Destination pin">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </button>
                                    </div>
                                    <input type="hidden" id="addAttArrowDirection" value="" />
                                </div>

                                <%# Face selector (shown only for a-frame locations) %>
                                <div class="mb-2" id="addAttFaceRow" hidden>
                                    <label class="form-label small mb-1">Face</label>
                                    <select class="form-select form-select-sm" id="addAttFace">
                                        <option value="">Not specified</option>
                                        <option value="front">Front</option>
                                        <option value="back">Back</option>
                                    </select>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm flex-fill" id="addAttSaveBtn">
                                        <i class="fa-solid fa-plus me-1"></i>Add
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="addAttCancelBtn">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

            <%# ── Audit info ─────────────────────────────────── %>
            <div class="signs-editor-meta small text-muted mb-3" id="editorMeta" hidden>
                <%# JS populates %>
            </div>

            <%# ── Actions ────────────────────────────────────── %>
            <% if (canManage) { %>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-primary" id="editorSaveBtn">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-danger ms-auto" id="editorDeleteBtn" hidden>
                        <i class="fa-solid fa-trash me-1"></i>Delete
                    </button>
                </div>
                <p class="small mt-2" id="editorFeedback"></p>
            <% } else { %>
                <p class="small text-muted mt-2 mb-0">
                    <i class="fa-solid fa-eye me-1"></i>View only. OVERSEER+ can edit locations.
                </p>
            <% } %>

        </div>
    </div>

    <%# ──────────────────────────────────────────────────────────
        OFFCANVAS: traffic arrow editor
    ────────────────────────────────────────────────────────── %>
    <div class="offcanvas offcanvas-end signs-placement-offcanvas"
         tabindex="-1"
         id="arrowEditor"
         aria-labelledby="arrowEditorTitle">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5 mb-0" id="arrowEditorTitle">
                <i class="fa-solid fa-diamond-turn-right me-2"></i>Traffic Arrow
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">

            

            <%# ── Label ──────────────────────────────────────── %>
            <div class="mb-3">
                <label for="arrowEditorLabel" class="form-label">Label</label>
                <input type="text" class="form-control" id="arrowEditorLabel"
                       maxlength="100" placeholder="e.g. Northbound on Main St"
                       <%= canManage ? '' : 'readonly' %> />
            </div>

            <%# ── Coordinates ────────────────────────────────── %>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="arrowEditorLat" class="form-label small">Latitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm"
                           id="arrowEditorLat" <%= canManage ? '' : 'readonly' %> />
                </div>
                <div class="col-6">
                    <label for="arrowEditorLng" class="form-label small">Longitude</label>
                    <input type="number" step="0.0000001" class="form-control form-control-sm"
                           id="arrowEditorLng" <%= canManage ? '' : 'readonly' %> />
                </div>
            </div>

            <%# ── Linked signs ───────────────────────────────── %>
            <div class="mb-3 border-top pt-3">
                <label class="form-label fw-semibold d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-link me-1"></i>Linked Signs</span>
                    <span class="badge bg-secondary" id="arrowLinkCount">0</span>
                </label>
                <div id="arrowLinkList">
                    <%# JS populates %>
                </div>
                <% if (canManage) { %>
                    <div class="mt-2" id="addArrowLinkWrap">
                        <div class="dropdown mt-2" id="addArrowLinkWrap">
                            <button type="button" class="btn btn-outline-primary btn-sm w-100 dropdown-toggle"
                                    id="addArrowLinkToggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-plus me-1"></i>Link a sign
                            </button>
                            <ul class="dropdown-menu signs-arrow-link-picker" id="addArrowLinkMenu">
                                <li><span class="dropdown-item-text text-muted small">No signs available.</span></li>
                            </ul>
                        </div>
                    </div>
                <% } %>
            </div>

            <%# ── Actions ────────────────────────────────────── %>
            <% if (canManage) { %>
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <button type="button" class="btn btn-primary" id="arrowEditorSaveBtn">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-danger ms-auto" id="arrowEditorDeleteBtn">
                        <i class="fa-solid fa-trash me-1"></i>Delete
                    </button>
                </div>
                <p class="small mt-2" id="arrowEditorFeedback"></p>
            <% } else { %>
                <p class="small text-muted mt-2 mb-0">
                    <i class="fa-solid fa-eye me-1"></i>View only. OVERSEER+ can edit arrows.
                </p>
            <% } %>

        </div>
    </div>

    <%# ── Street View overlay ──────────────────────────────── %>
    <div class="signs-sv-overlay d-none" id="streetViewOverlay">
        <div class="signs-sv-header">
            <div class="signs-sv-header-info">
                <span class="signs-sv-title" id="svTitle"></span>
                <span class="signs-sv-heading-badge d-none" id="svBearingBadge"></span>
                <span class="signs-sv-heading-hint d-none" id="svBearingHint">No bearing set — rotate manually</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <% if (canManage) { %>
                    <button type="button" class="btn btn-sm btn-warning signs-sv-save-photo-btn d-none" id="svSavePhotoBtn">
                        <i class="fa-solid fa-camera me-1"></i>Save as Photo
                    </button>
                    <button type="button" class="btn btn-sm btn-info signs-sv-save-photo-btn d-none" id="svSaveViewBtn">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save View
                    </button>
                <% } %>
                <button type="button" class="signs-sv-close" id="svCloseBtn" aria-label="Close Street View">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="signs-sv-pane" id="streetViewPane"></div>
        <div class="signs-sv-footer d-none" id="svNoImageryMsg">
            No Street View imagery available here.
            <a id="svGoogleMapsLink" href="#" target="_blank" rel="noopener">Open in Google Maps</a>
        </div>
    </div>

    <%# Inline JSON bootstrap %>
    <script id="signsMapBootstrap" type="application/json"><%- 
        JSON.stringify({ signs, locations, arrows, mapOverlays: mapOverlays || [] })
    %></script>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/signsMap.js"></script>
        <script src="/js/signsMapOverlays.js"></script>

    <% if (canManage) { %>
        <script src="/js/signsGeofence.js"></script>
    <% } %>
</body>
</html>