<!DOCTYPE html>
<html lang="en">

<head>
    <title>Your invitation — <%= brand.siteName %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include('../partials/metaDescription') %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/inviteRespond.css" />
    <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/georama-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/fonts.css" />
</head>

<body class="min-vh-100 bg-body-tertiary">
    <%- include('../partials/header') %>

    <%
        /**
         * Format a TIME value to h:MM AM/PM.
         * mssql TIME columns come back as epoch-anchored Date objects —
         * always use UTC hours/minutes.
         * @param {Date|string|null} val
         * @returns {string}
         */
        function fmtTime(val) {
            if (!val) return '';
            const d = new Date(val);
            if (isNaN(d.valueOf())) return String(val).slice(0, 5);
            const h  = d.getUTCHours();
            const m  = String(d.getUTCMinutes()).padStart(2, '0');
            const ap = h >= 12 ? 'PM' : 'AM';
            return `${h % 12 || 12}:${m} ${ap}`;
        }

        const hasEvent  = !!invitation.convention_day_id;
        const hasShift  = !!invitation.shift_id;
        const isSms     = invitation.channel === 'sms' || invitation.channel === 'both';
        const eventDate = hasEvent
            ? new Date(invitation.convention_date).toLocaleDateString('en-US', {
                weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC'
              })
            : null;
        const cfg = answer.config;
        const isRecruitment = !!invitation.is_recruitment;
        const saidYes = invitation.response === 'yes';
        const registrationIncomplete = invitation.registration_status === 'draft';

        // Display for the standard answers
        const standardDisplay = {
            yes:   { btn: 'btn-success',        icon: 'fa-circle-check',    label: "Yes, I'll be there" },
            no:    { btn: 'btn-outline-danger', icon: 'fa-circle-xmark',    label: "No, I can't make it" },
            maybe: { btn: 'btn-warning',        icon: 'fa-circle-question', label: "Maybe — not sure yet" },
        };
    %>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">
                <div class="card shadow-lg">

                    <%# ── Card header ─────────────────────────────────────── %>
                    <div class="card-header text-center py-3">
                        <h1 class="h4 mb-0"><%= brand.siteName %></h1>
                        <p class="text-muted small mb-0"><%= departmentName %> · <%= invitation.batch_name || 'Invitation' %></p>
                    </div>

                    <div class="card-body p-4">

                    <% if (invitation.revoked) { %>
                        <%# ── Revoked ────────────────────────────────────── %>
                        <div class="text-center py-3">
                            <i class="fa-solid fa-ban fa-3x text-danger mb-3" aria-hidden="true"></i>
                            <h2 class="h5">This invitation is no longer active</h2>
                            <p class="text-muted">
                                Hi <%= invitation.firstName %>, this invite link has been
                                turned off by the <%= departmentName %> team.
                            </p>
                            <p class="text-muted small mb-0">
                                If you think this is a mistake, please contact your
                                <%= departmentName %> overseer.
                            </p>
                        </div>

                    <% } else { %>

                        <%# ── Just answered / changed ─────────────────────── %>
                        <% if (responded || changed) { %>
                            <div class="alert alert-success d-flex align-items-start gap-2" role="status">
                                <i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i>
                                <div>
                                    <strong><%= changed ? 'Answer changed.' : 'Answer saved.' %></strong>
                                    Thanks, <%= invitation.firstName %> — the <%= departmentName %> team can see it now.
                                </div>
                            </div>
                        <% } %>
                        <% if (error === 'closed') { %>
                            <div class="alert alert-warning small" role="alert">
                                Answers to this invitation can't be changed any more. Please contact your
                                <%= departmentName %> overseer.
                            </div>
                        <% } %>

                        <% if (!answer.showForm) { %>
                            <%# ── Answer on file ──────────────────────────── %>
                            <h2 class="h5 mb-1">Hi <%= invitation.firstName %>,</h2>
                            <p class="mb-3">
                                Your answer:
                                <span class="ir-answer ir-answer--<%= ['yes','no','maybe'].includes(invitation.response) ? invitation.response : 'other' %>"><%= answer.label %></span>
                            </p>

                            <% if (answer.canChange) { %>
                                <a class="btn btn-outline-primary w-100 mb-2"
                                    href="/invite/respond/<%= encodeURIComponent(invitation.token) %>?change=1">
                                    <i class="fa-solid fa-pen me-2" aria-hidden="true"></i>Change my answer
                                </a>
                                <% if (answer.changeUntilText) { %>
                                    <p class="text-muted small text-center mb-0">You can change it until <%= answer.changeUntilText %>.</p>
                                <% } %>
                            <% } else { %>
                                <p class="text-muted small mb-0">
                                    To change it now, please contact your <%= departmentName %> overseer.
                                </p>
                            <% } %>

                            <% if (saidYes) { %>
                                <%# ── Next steps after a Yes ───────────────── %>
                                <section class="ir-next-steps mt-4" aria-labelledby="irNextTitle">
                                    <h3 class="h6" id="irNextTitle">What happens next</h3>
                                    <ul class="ir-next-list">
                                        <% if (hasEvent) { %>
                                            <li>
                                                <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                                                <span><%= invitation.day_label %>, <%= eventDate %><% if (hasShift) { %>, <%= fmtTime(invitation.shift_start) %> – <%= fmtTime(invitation.shift_end) %><% } %><% if (invitation.location_name) { %> · <%= invitation.location_name %><% } %></span>
                                            </li>
                                        <% } %>
                                        <li>
                                            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
                                            <span>We'll send you your schedule by email<%= isSms ? ' and text' : '' %> when it's published.</span>
                                        </li>
                                        <% if (isRecruitment && registrationIncomplete) { %>
                                            <li>
                                                <i class="fa-solid fa-user-pen" aria-hidden="true"></i>
                                                <span><a href="/continue-registration">Finish your registration</a> so you can be scheduled.</span>
                                            </li>
                                        <% } else { %>
                                            <li>
                                                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                                                <span><a href="/login">Sign in</a> any time to see your schedule.</span>
                                            </li>
                                        <% } %>
                                    </ul>
                                </section>
                            <% } %>

                        <% } else { %>
                            <%# ── Answer form ─────────────────────────────── %>
                            <h2 class="h5 mb-1">Hi <%= invitation.firstName %>,</h2>
                            <p class="text-muted small mb-3">
                                <% if (answer.answered) { %>
                                    Your answer now: <strong><%= answer.label %></strong>. Pick a new one below.
                                <% } else { %>
                                    You received this from the <%= departmentName %> team.
                                <% } %>
                            </p>

                            <% if (hasEvent) { %>
                                <div class="ir-event-block mb-4">
                                    <div class="ir-event-header">
                                        <i class="fa-regular fa-calendar-days me-2 text-primary" aria-hidden="true"></i>
                                        <span class="fw-semibold"><%= invitation.day_label %></span>
                                    </div>
                                    <div class="ir-event-date"><%= eventDate %></div>
                                    <% if (hasShift) { %>
                                        <div class="ir-event-details mt-2">
                                            <div class="ir-event-detail-row">
                                                <span class="ir-detail-label"><i class="fa-regular fa-clock me-1" aria-hidden="true"></i>Time</span>
                                                <span class="ir-detail-value"><%= fmtTime(invitation.shift_start) %> – <%= fmtTime(invitation.shift_end) %></span>
                                            </div>
                                            <% if (invitation.event_type_name) { %>
                                                <div class="ir-event-detail-row">
                                                    <span class="ir-detail-label"><i class="fa-solid fa-tag me-1" aria-hidden="true"></i>Type</span>
                                                    <span class="ir-detail-value">
                                                        <% if (invitation.event_type_color) { %>
                                                            <span class="ir-type-dot" data-color="<%= invitation.event_type_color %>"></span>
                                                        <% } %>
                                                        <%= invitation.event_type_name %>
                                                        <% if (invitation.shift_label) { %>
                                                            <span class="text-muted">(<%= invitation.shift_label %>)</span>
                                                        <% } %>
                                                    </span>
                                                </div>
                                            <% } %>
                                            <% if (invitation.location_name) { %>
                                                <div class="ir-event-detail-row">
                                                    <span class="ir-detail-label"><i class="fa-solid fa-map-pin me-1" aria-hidden="true"></i>Location</span>
                                                    <span class="ir-detail-value"><%= invitation.location_name %></span>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <div class="ir-event-detail-row mt-2">
                                            <span class="ir-detail-label"><i class="fa-regular fa-clock me-1" aria-hidden="true"></i>Program</span>
                                            <span class="ir-detail-value"><%= fmtTime(invitation.program_start) %> – <%= fmtTime(invitation.program_end) %></span>
                                        </div>
                                    <% } %>
                                </div>
                            <% } %>

                            <%# ── Message (escaped; line breaks kept by CSS) ── %>
                            <% if (!answer.answered) { %>
                                <% if (invitation.message_subject) { %>
                                    <p class="fw-semibold mb-2"><%= invitation.message_subject %></p>
                                <% } %>
                                <% if (invitation.message_body) { %>
                                    <div class="ir-message mb-4"><%= invitation.message_body %></div>
                                <% } %>
                            <% } %>

                            <% if (answer.respondBy) { %>
                                <p class="small mb-3 <%= answer.pastRespondBy ? 'text-warning-emphasis' : 'text-muted' %>">
                                    <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>
                                    <% if (answer.pastRespondBy) { %>
                                        The answer date was <%= answer.respondByText %>, but you can still answer.
                                    <% } else { %>
                                        Please answer by <%= answer.respondByText %>.
                                    <% } %>
                                </p>
                            <% } %>

                            <% if (error === 'invalid') { %>
                                <div class="alert alert-danger py-2 small" role="alert">
                                    Please choose an answer before submitting.
                                </div>
                            <% } %>

                            <hr class="my-3" />

                            <p class="fw-semibold mb-3" id="rsvpQuestion">
                                <% if (cfg.type === 'poll' && cfg.question) { %>
                                    <%= cfg.question %>
                                <% } else { %>
                                    Will you be volunteering<% if (hasShift) { %> for this shift<% } %>?
                                <% } %>
                            </p>

                            <form id="rsvpForm" action="/invite/respond/<%= encodeURIComponent(invitation.token) %>" method="POST"
                                aria-labelledby="rsvpQuestion">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <input type="hidden" id="rsvpResponse" name="response" value="" />

                                <div class="d-grid gap-2">
                                    <% cfg.options.forEach(function(opt) {
                                        const display = standardDisplay[opt];
                                        const current = answer.answered && invitation.response === opt;
                                    %>
                                        <% if (display) { %>
                                            <button type="button" class="btn <%= display.btn %> btn-lg rsvp-btn<%= current ? ' ir-current' : '' %>"
                                                data-response="<%= opt %>" <%= current ? 'aria-current=true' : '' %>>
                                                <i class="fa-solid <%= display.icon %> me-2" aria-hidden="true"></i><%= display.label %>
                                            </button>
                                        <% } else { %>
                                            <button type="button" class="btn btn-outline-primary btn-lg rsvp-btn<%= current ? ' ir-current' : '' %>"
                                                data-response="<%= opt %>" <%= current ? 'aria-current=true' : '' %>>
                                                <%= opt %>
                                            </button>
                                        <% } %>
                                    <% }); %>

                                    <% if (cfg.allowOther) { %>
                                        <button type="button" class="btn btn-outline-secondary btn-lg rsvp-btn" id="rsvpOtherBtn" data-response="other">
                                            <i class="fa-solid fa-pen me-2" aria-hidden="true"></i>Other
                                        </button>
                                        <div id="rsvpOtherWrap" class="d-none mt-1">
                                            <label class="visually-hidden" for="rsvpOtherInput">Your answer</label>
                                            <input type="text" id="rsvpOtherInput" name="response_other" class="form-control"
                                                placeholder="Please specify..." maxlength="500" />
                                            <button type="submit" class="btn btn-primary mt-2 w-100">Submit</button>
                                        </div>
                                    <% } %>
                                </div>

                                <% if (answer.answered) { %>
                                    <a class="btn btn-link w-100 mt-2" href="/invite/respond/<%= encodeURIComponent(invitation.token) %>">Keep my answer</a>
                                <% } %>

                                <% if (isSms) { %>
                                    <p class="text-muted mt-3 mb-0 ir-sms-consent">
                                        <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>
                                        By answering, you agree to receive text messages from the <%= departmentName %>
                                        team about your volunteer assignment. Reply STOP at any time to opt out.
                                    </p>
                                <% } %>
                            </form>
                        <% } %>
                    <% } %>
                    </div>

                    <div class="card-footer text-center text-muted small py-2">
                        <%= brand.conventionShortName %> · <%= departmentName %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/inviteRespond.js"></script>
</body>

</html>
