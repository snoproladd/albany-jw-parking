<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Confirm Your Identity</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary entry-body">
    <main class="container body-container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 form-entry">

          <section id="upgrade-name" class="card shadow-lg entry-card">
            <header class="card-header text-center">
              <h1 class="text-center mb-1">Confirm Your Identity</h1>
              <p class="footnote mt-2 mb-0">
                Please enter your name exactly as it appears on your volunteer record.
              </p>
            </header>

            <div class="card-body">
              <form action="/upgrade/name" method="POST" id="upgradeName-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="id" value="<%= volunteer.id %>" />

                <div class="mb-3">
                  <label class="form-label" for="firstName">
                    First Name<span class="asterix">*</span>
                  </label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    class="form-control"
                    required
                  />
                  <div id="firstName-status" class="status"></div>
                </div>

                <div class="mb-3">
                  <label class="form-label" for="lastName">
                    Last Name<span class="asterix">*</span>
                  </label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    class="form-control"
                    required
                  />
                  <div id="lastName-status" class="status"></div>
                </div>

                <div class="mb-3">
                  <label class="form-label" for="suffix">
                    Suffix (optional)
                  </label>
                  <input
                    type="text"
                    id="suffix"
                    name="suffix"
                    class="form-control"
                  />
                  <div id="suffix-status" class="status"></div>
                </div>

                <button
                  type="submit"
                  id="upgradeName-submit"
                  class="btn btn-primary w-100"
                >
                  Continue
                </button>

                <div id="submitStatus" class="mt-2" role="status"></div>
              </form>
            </div>
          </section>

        </div>
      </div>
    </main>

    <script src="/js/formListeners.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>