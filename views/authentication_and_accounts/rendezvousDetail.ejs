<%#
  Public meet-up details page (GET /rv/:saId, token-gated, no sign-in).
  Linked from shift reminder and meet-up change texts. The Open Graph tags
  let phones that preview links show the meet-up photo under the link.
  Styles: public/styles/rendezvousDetail.css.
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Meet-up Point — <%= brand.siteName %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include('../partials/metaDescription') %>
    <meta name="robots" content="noindex, nofollow" />
    <% if (typeof og !== 'undefined' && og) { %>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="<%= brand.siteName %>" />
      <meta property="og:title" content="<%= og.title %>" />
      <meta property="og:description" content="<%= og.description %>" />
      <meta property="og:url" content="<%= og.url %>" />
      <% if (og.image) { %>
        <meta property="og:image" content="<%= og.image %>" />
        <meta property="og:image:alt" content="Photo of the meet-up point" />
        <meta name="twitter:card" content="summary_large_image" />
      <% } %>
    <% } %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/rendezvousDetail.css" />
  </head>

  <body class="bg-body-tertiary">
    <div class="container py-4">
      <div class="rv-detail card shadow-sm">
        <div class="card-header">
          <h1 class="h6 mb-0">
            <i class="fa-solid fa-location-dot me-2 text-primary"></i>
            Meet-up Point
          </h1>
        </div>
        <div class="card-body">

          <h2 class="h6 mb-1"><%= shiftLabel %></h2>
          <p class="text-muted small mb-3"><%= locationName %></p>

          <% if (rv.photo_blob_name) { %>
            <div class="rv-detail-field">
              <img
                src="/rv/photo/<%= encodeURIComponent(rv.photo_blob_name) %>?a=<%= rv.schedule_assignment_id %>&t=<%= token %>"
                alt="Rendezvous photo"
                class="rv-detail-photo" />
            </div>
          <% } %>

          <% if (rv.description) { %>
            <div class="rv-detail-field">
              <div class="rv-detail-label">Description</div>
              <div><%= rv.description %></div>
            </div>
          <% } %>

          <% if (rv.floor_number) { %>
            <div class="rv-detail-field">
              <div class="rv-detail-label">Floor</div>
              <div><%= rv.floor_number %></div>
            </div>
          <% } %>

          <% if (rv.address) { %>
            <div class="rv-detail-field">
              <div class="rv-detail-label">Address</div>
              <div><%= rv.address %></div>
            </div>
          <% } %>

          <% if (rv.latitude != null && rv.longitude != null) { %>
            <div class="rv-detail-field">
              <a href="https://www.google.com/maps?q=<%= rv.latitude %>,<%= rv.longitude %>"
                target="_blank" rel="noopener"
                class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-map-location-dot me-1"></i> Open in Maps
              </a>
            </div>
          <% } %>

        </div>
        <div class="card-footer text-muted text-center small">
          <%= brand.siteName %>
        </div>
      </div>
    </div>
  </body>
</html>