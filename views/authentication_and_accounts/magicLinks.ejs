<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Magic Links — <%= brand.siteName %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include('../partials/metaDescription') %>
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/georama-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/fonts.css" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('../partials/header') %>

    <main class="container-fluid py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header">
              <div class="text-center">
                <h1 class="h2 my-2">
                  <i class="fa-solid fa-qrcode me-2"></i>Magic Links
                </h1>
                <p class="mb-0">
                  Passwordless sign-in links, such as printed QR codes for shared
                  counting stations. Anyone with a link is signed in as that
                  person. Revoking here takes effect immediately.
                </p>
              </div>
            </header>

            <div class="card-body py-4">

              <%# ── Create a link (phase 3d-8g) ── %>
              <section class="mb-4" aria-labelledby="mlCreateHeading">
                <h2 class="h5" id="mlCreateHeading">Create a link</h2>
                <form id="mlCreateForm" class="row g-3 align-items-end" novalidate>
                  <div class="col-12 col-md-5">
                    <label for="mlPerson" class="form-label">Person</label>
                    <select id="mlPerson" name="volunteerId" class="form-select" required>
                      <option value="">Choose a person…</option>
                      <% (locals.candidates || []).forEach(function (c) { %>
                        <option value="<%= c.id %>"><%= c.lastName %>, <%= c.firstName %><%= c.email ? ` (${c.email})` : '' %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="mlLabel" class="form-label">Label <span class="text-muted small">(optional)</span></label>
                    <input type="text" id="mlLabel" name="label" class="form-control" maxlength="100"
                           placeholder="e.g. Lot A Count Station" autocomplete="off" />
                  </div>
                  <div class="col-12 col-md-3">
                    <label for="mlExpires" class="form-label">Expires <span class="text-muted small">(blank = never)</span></label>
                    <input type="date" id="mlExpires" name="expiresOn" class="form-control" min="<%= locals.minExpiry || '' %>" />
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-primary" id="mlCreateBtn">
                      <i class="fa-solid fa-qrcode me-1" aria-hidden="true"></i>Create link
                    </button>
                  </div>
                </form>
                <div id="mlCreateError" class="alert alert-danger mt-3 d-none" role="alert" tabindex="-1"></div>
                <p id="mlRevokedNote" class="alert alert-secondary mt-3 mb-0 d-none" role="status">That link was revoked.</p>

                <div id="mlResult" class="magic-link-result border rounded p-3 mt-3 d-none" tabindex="-1" aria-live="polite">
                  <p class="alert alert-warning py-2 mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                    Copy or download this now. The link won't be shown again.
                  </p>
                  <div class="row g-3 align-items-start">
                    <div class="col-12 col-md-auto text-center">
                      <img id="mlQr" class="magic-link-qr border rounded" alt="" width="256" height="256" />
                      <div class="mt-2">
                        <a id="mlQrDownload" class="btn btn-outline-secondary btn-sm" href="#" download="magic-link.png">
                          <i class="fa-solid fa-download me-1" aria-hidden="true"></i>Download QR (PNG)
                        </a>
                      </div>
                    </div>
                    <div class="col-12 col-md">
                      <label for="mlUrl" class="form-label">Sign-in link for <span id="mlResultName"></span></label>
                      <div class="input-group">
                        <input type="text" id="mlUrl" class="form-control font-monospace" readonly />
                        <button type="button" class="btn btn-outline-primary" id="mlCopyBtn">
                          <i class="fa-solid fa-copy me-1" aria-hidden="true"></i>Copy
                        </button>
                      </div>
                      <p id="mlCopyStatus" class="small text-success mt-1 mb-0" aria-live="polite"></p>
                    </div>
                  </div>
                </div>
              </section>

              <h2 class="h5">Links</h2>
              <p id="mlEmpty" class="text-muted text-center my-4<%= tokens.length ? ' d-none' : '' %>">No magic links have been created yet.</p>
                <div class="table-responsive<%= tokens.length ? '' : ' d-none' %>" id="mlTableWrap">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th>Account</th>
                        <th>Label</th>
                        <th>Created</th>
                        <th>Last Used</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody id="mlTableBody">
                      <% tokens.forEach((t) => { %>
                        <tr data-id="<%= t.id %>">
                          <td>
                            <div class="fw-semibold"><%= t.firstName %> <%= t.lastName %></div>
                            <div class="small text-muted"><%= t.email || '—' %></div>
                          </td>
                          <td><%= t.label || '—' %></td>
                          <td class="small"><%- momentTag(t.created_at) %></td>
                          <td class="small">
                            <% if (t.last_used_at) { %><%- momentTag(t.last_used_at) %><% } else { %>Never<% } %>
                          </td>
                          <td>
                            <% if (t.revoked_at) { %>
                              <span class="badge bg-secondary">Revoked</span>
                            <% } else if (t.expires_at && new Date(t.expires_at) < new Date()) { %>
                              <span class="badge bg-warning text-dark">Expired</span>
                            <% } else { %>
                              <span class="badge bg-success">Active</span>
                            <% } %>
                          </td>
                          <td class="text-end">
                            <% if (!t.revoked_at) { %>
                              <button type="button" class="btn btn-outline-danger btn-sm revoke-btn" data-id="<%= t.id %>">
                                <i class="fa-solid fa-ban me-1"></i>Revoke
                              </button>
                            <% } else { %>
                              <span class="text-muted small">—</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>

              <div class="mt-3">
                <a href="/oversight/tools" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i>Back to Tools
                </a>
              </div>
            </div><%# /.card-body %>
          </section>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/magicLinks.js"></script>
  </body>
</html>
