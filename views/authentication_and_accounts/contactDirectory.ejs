<!DOCTYPE html>
<html lang="en">
<head>
  <title>Contact Directory — Albany JW Parking</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
  <link rel="stylesheet" type="text/css" href="/styles/contactDirectory.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
</head>

<body class="min-vh-100 bg-body-tertiary" data-authed="true">
  <%- include('../partials/header') %>

  <%
    const _cdPerms  = userPermissions && userRole && userPermissions[userRole];
    const canPrint  = !!(_cdPerms && _cdPerms.printUserData);
  %>

  <main class="container-fluid py-4 px-4" id="contactDirectoryRoot" data-can-print="<%= canPrint ? '1' : '0' %>">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-10 col-xxl-9">

        <section class="card shadow-lg admin-console-card">
          <header class="card-header">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="text-center flex-grow-1">
                <h1 class="h2 my-2">
                  <i class="fa-solid fa-address-book me-2"></i>Contact Directory
                </h1>
                <p class="mb-0">
                  Email and phone number for every volunteer with a completed registration.
                </p>
              </div>
            </div>
          </header>

          <div class="card-body py-4 px-4">

            <%# ── Toolbar ── %>
            <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-4">
              <input
                type="search"
                id="cdSearch"
                class="form-control form-control-sm cd-search-input"
                placeholder="Search name, email, or phone…"
                autocomplete="off"
                aria-label="Search volunteers"
              />
              <div class="d-flex align-items-center gap-3">
                <span class="small text-muted" id="cdVisibleCount"></span>
                <% if (canPrint) { %>
                  <button type="button" id="cdPrintBtn" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-print me-1"></i>Print
                  </button>
                <% } %>
              </div>
            </div>

            <div class="table-responsive">
              <table class="table table-hover table-sm mb-0" id="cdTable">
                <thead class="table-light sticky-top">
                  <tr>
                    <th class="ps-3 cd-sortable" data-col="name" aria-sort="ascending">
                      Name <i class="fa-solid fa-sort ms-1 cd-sort-icon"></i>
                    </th>
                    <th class="cd-sortable" data-col="email">
                      Email <i class="fa-solid fa-sort ms-1 cd-sort-icon"></i>
                    </th>
                    <th class="cd-sortable" data-col="phone">
                      Phone <i class="fa-solid fa-sort ms-1 cd-sort-icon"></i>
                    </th>
                    <th class="cd-sortable" data-col="role">
                      Role <i class="fa-solid fa-sort ms-1 cd-sort-icon"></i>
                    </th>
                  </tr>
                </thead>
                <tbody id="cdTableBody">
                  <!-- Populated by contactDirectory.js -->
                </tbody>
              </table>
            </div>

            <div id="cdEmpty" class="text-center py-5 text-muted d-none">
              <i class="fa-solid fa-magnifying-glass fa-2x mb-2 d-block"></i>
              No volunteers match your search.
            </div>

          </div>
        </section>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script id="contact-directory-data" type="application/json"><%- JSON.stringify(volunteers) %></script>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/js/contactDirectory.js"></script>
</body>
</html>
