<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Role Management — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('../partials/header') %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-11 col-xl-10">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header text-center">
              <h1 class="h2 my-2">
                <i class="fa-solid fa-user-shield me-2"></i>Role Management
              </h1>
              <p class="mb-0">Assign roles to volunteers. You can only assign roles below your own level.</p>
            </header>

            <div class="card-body">

              <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  <i class="fa-solid fa-circle-check me-2"></i>Role updated successfully.
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% } %>

              <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% } %>

              <%
                // Build the list of roles this actor is allowed to assign
                const actorLevel = roleHierarchy.indexOf(actorRole);
                const assignableRoles = roleHierarchy.filter((r, i) => i < actorLevel);
              %>

              <!-- Search filter -->
              <div class="mb-3">
                <input
                  type="text"
                  id="roleSearch"
                  class="form-control"
                  placeholder="Search by name or email..."
                  autocomplete="off"
                />
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle" id="rolesTable">
                  <thead class="table-light">
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>Current Role</th>
                      <th>Change To</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% volunteers.forEach(v => { %>
                      <%
                        const volunteerLevel = roleHierarchy.indexOf(v.role);
                        // Can only change roles strictly below actor's own level
                        const canChange = volunteerLevel < actorLevel;
                      %>
                      <tr class="role-row">
                        <td>
                          <%= v.lastName %><%= v.suffix ? ' ' + v.suffix : '' %>, <%= v.firstName %>
                        </td>
                        <td class="text-muted small"><%= v.email || '—' %></td>
                        <td>
                          <span class="badge <%=
                            v.role === 'ADMIN'           ? 'bg-danger'  :
                            v.role === 'ASSISTANT_ADMIN' ? 'bg-warning text-dark' :
                            v.role === 'OVERSEER'        ? 'bg-primary' :
                            v.role === 'KEYMAN'          ? 'bg-info text-dark'    :
                            v.role === 'REGISTERED'      ? 'bg-success' :
                                                           'bg-secondary'
                          %>">
                            <%= v.role %>
                          </span>
                        </td>
                        <td>
                          <% if (canChange && assignableRoles.length > 0) { %>
                            <select class="form-select form-select-sm role-select">
                              <option value="">Select role…</option>
                              <% assignableRoles.forEach(r => { %>
                                <option value="<%= r %>" <%= v.role === r ? 'selected' : '' %>>
                                  <%= r %>
                                </option>
                              <% }) %>
                            </select>
                          <% } else { %>
                            <span class="text-muted small">—</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (canChange && assignableRoles.length > 0) { %>
                            <form action="/oversight/roles" method="POST" class="role-form">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                              <input type="hidden" name="targetId" value="<%= v.id %>" />
                              <input type="hidden" name="newRole" class="role-input" value="" />
                              <button
                                type="submit"
                                class="btn btn-sm btn-outline-primary role-save-btn"
                                disabled>
                                Save
                              </button>
                            </form>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <% if (volunteers.length === 0) { %>
                <p class="text-center text-muted mt-3">No volunteers found.</p>
              <% } %>

              <% if (unapprovedVolunteers.length > 0) { %>
                <div class="mt-4">
                  <button
                    class="btn btn-outline-warning btn-sm w-100 text-start d-flex align-items-center justify-content-between"
                    type="button"
                    id="unapprovedToggle"
                    aria-expanded="false"
                    aria-controls="unapprovedSection">
                    <span>
                      <i class="fa-solid fa-user-clock me-2"></i>
                      Unapproved Volunteers
                      <span class="badge bg-warning text-dark ms-2"><%= unapprovedVolunteers.length %></span>
                    </span>
                    <i class="fa-solid fa-chevron-down unapproved-chevron"></i>
                  </button>

                  <div id="unapprovedSection" class="d-none mt-2">
                    <p class="text-muted small mb-2">
                      These volunteers have not completed their registration.
                      They can only be granted <strong>DESK</strong> access,
                      which also marks their registration as complete so they can log in.
                    </p>

                    <div class="mb-2">
                      <input
                        type="text"
                        id="unapprovedSearch"
                        class="form-control form-control-sm"
                        placeholder="Search unapproved volunteers…"
                        autocomplete="off" />
                    </div>

                    <div class="table-responsive">
                      <table class="table table-hover align-middle table-sm" id="unapprovedTable">
                        <thead class="table-warning">
                          <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Current Role</th>
                            <th></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% unapprovedVolunteers.forEach(v => { %>
                            <tr class="unapproved-row">
                              <td>
                                <%= v.lastName %><%= v.suffix ? ' ' + v.suffix : '' %>, <%= v.firstName %>
                              </td>
                              <td class="text-muted small"><%= v.email || '—' %></td>
                              <td>
                                <span class="badge bg-secondary"><%= v.role %></span>
                              </td>
                              <td>
                                <form action="/oversight/roles/desk" method="POST" class="d-inline">
                                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                  <input type="hidden" name="targetId" value="<%= v.id %>" />
                                  <button type="submit" class="btn btn-sm btn-warning">
                                    <i class="fa-solid fa-user-check me-1"></i>Approve as DESK
                                  </button>
                                </form>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              <% } %>

              <div class="mt-3">
                <a href="/oversight/tools" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i>Back to Oversight Tools
                </a>
              </div>

            </div>
          </section>

            </div>
          </section>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/adminRoles.js"></script>
  </body>
</html>