<!DOCTYPE html>
<html lang="en">
<head>
  <title>Schedule Report — Albany JW Parking</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
  <link rel="stylesheet" type="text/css" href="/styles/schedulerReport.css" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
</head>

<body data-authed="true" class="bg-body-tertiary report-body">

  <%- include('../partials/header') %>

  <div class="report-toolbar">
    <a href="/oversight/tools/scheduler" class="btn btn-sm btn-outline-secondary">
      <i class="fa-solid fa-chevron-left me-1"></i>Back to Scheduler
    </a>

    <span class="report-toolbar-title">
      <i class="fa-solid fa-print me-1 text-secondary"></i>
      Schedule Report
      <% if (reportData.day) { %>
        &mdash; <%= reportData.day.label %>
        <% if (reportData.day.convention_date) { %>
          <span class="text-muted fw-normal">
            (<%= new Date(reportData.day.convention_date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %>)
          </span>
        <% } %>
      <% } %>
    </span>

    <form method="GET" action="/oversight/tools/scheduler/report" class="d-flex align-items-center gap-2">
      <select name="dayId" id="report-day-picker" class="form-select form-select-sm report-day-select">
        <% conventionDays.forEach(day => { %>
          <option value="<%= day.id %>" <%= day.id === selectedDayId ? 'selected' : '' %>>
            <%= day.label %>
          </option>
        <% }) %>
      </select>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    </form>

    <%# Department visibility filters %>
    <div class="report-dept-filters">
      <span class="report-filter-label">Departments:</span>
      <% [
        { key: 'lots_and_garages', label: 'L&G' },
        { key: 'signs',            label: 'Signs' },
        { key: 'security',         label: 'Security' },
        { key: 'dropoff_pickup',   label: 'D/P' },
        { key: 'mobile_support',   label: 'MS' },
      ].forEach(d => {
        const present = reportData.departments.some(dep => dep.key === d.key);
      %>
        <label class="report-filter-chip <%= present ? '' : 'is-empty' %>">
          <input type="checkbox" class="dept-filter-cb"
                 data-dept="<%= d.key %>"
                 <%= present ? 'checked' : 'disabled' %> />
          <%= d.label %>
        </label>
      <% }) %>
    </div>

    <button type="button" id="report-print-btn" class="btn btn-sm btn-primary">
      <i class="fa-solid fa-print me-1"></i>Print / Save PDF
    </button>
  </div>

  <div class="report-container">

    <% if (!reportData.day || reportData.departments.length === 0) { %>

      <div class="report-empty">
        <i class="fa-solid fa-circle-info fa-2x text-muted d-block mb-3"></i>
        <p class="text-muted mb-1">No schedule data found for this day.</p>
        <p class="text-muted small">
          Assign volunteers in the <a href="/oversight/tools/scheduler">Scheduler</a> first.
        </p>
      </div>

    <% } else { %>

      <div class="report-page-header">
        <h1>Albany JW Parking — <%= reportData.day.label %></h1>
        <p class="report-subtitle">
          <% if (reportData.day.convention_date) { %>
            <%= new Date(reportData.day.convention_date + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %>
            &nbsp;&middot;&nbsp;
          <% } %>
          Generated <%= new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
        </p>
      </div>

      <% reportData.departments.forEach(dept => { %>

        <section class="report-dept" data-dept="<%= dept.key %>">

          <div class="report-dept-header">
            <h2><%= dept.name %></h2>
            <span class="dept-badge"><%= dept.shifts.length %> shift<%= dept.shifts.length !== 1 ? 's' : '' %></span>
          </div>

          <% dept.shifts.forEach(shift => { %>

            <div class="report-shift">
              <div class="report-shift-header">
                <h3><%= shift.label %></h3>
                <% if (shift.start_time || shift.end_time) { %>
                  <span class="report-shift-time">
                    <%= shift.start_time || '' %><% if (shift.start_time && shift.end_time) { %> &ndash; <% } %><%= shift.end_time || '' %>
                  </span>
                <% } %>
              </div>

              <div class="report-locations">
                <% shift.locations.forEach(loc => { %>

                  <div class="report-location">
                    <div class="report-location-header"><%= loc.name %></div>
                    <div class="report-location-body">

                      <% if (loc.keyman) { %>
                        <div class="report-vol-row is-keyman">
                          <span class="report-vol-role-badge role-km">KM</span>
                          <span class="report-vol-name"><%= loc.keyman.lastName %>, <%= loc.keyman.firstName %></span>
                          <% if (loc.keyman.phone) { %><span class="report-vol-phone"><%= loc.keyman.phone %></span><% } %>
                        </div>
                      <% } %>

                      <% if (loc.keyman_asst) { %>
                        <div class="report-vol-row is-keyman-asst">
                          <span class="report-vol-role-badge role-ka">KA</span>
                          <span class="report-vol-name"><%= loc.keyman_asst.lastName %>, <%= loc.keyman_asst.firstName %></span>
                          <% if (loc.keyman_asst.phone) { %><span class="report-vol-phone"><%= loc.keyman_asst.phone %></span><% } %>
                        </div>
                      <% } %>

                      <% loc.volunteers.forEach(vol => { %>
                        <div class="report-vol-row">
                          <span class="report-vol-role-badge"></span>
                          <%= vol.lastName %>, <%= vol.firstName %>
                        </div>
                      <% }) %>

                      <% if (!loc.keyman && !loc.keyman_asst && loc.volunteers.length === 0) { %>
                        <div class="report-vol-empty">No volunteers assigned</div>
                      <% } %>

                    </div>
                  </div>

                <% }) %>
              </div>
            </div>

          <% }) %>

        </section>

      <% }) %>

    <% } %>

  </div>

  <%- include('../partials/footer') %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/js/schedulerReport.js"></script>
</body>
</html>