<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Review & Confirm</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Print / PDF styles -->
  <style nonce="<%= nonce %>">
    @media print {
      body { background: #fff !important; }

      .btn,
      .card-header button,
      a {
        display: none !important;
      }

      .collapse {
        display: block !important;
      }

      .card {
        border: 1px solid #000 !important;
        break-inside: avoid;
      }
    }
  </style>
</head>

<body>
<div class="container my-4">

  <h2 class="mb-4 text-center">Review Your Information</h2>

  <!-- Action buttons -->
  <div class="d-flex justify-content-end gap-2 mb-3">
    <button id="printBtn" class="btn btn-outline-secondary">
      Print / Save PDF
    </button>
  </div>

  <!-- ================= CONTACT ================= -->
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Contact</strong>
      <button class="btn btn-sm btn-outline-primary"
              data-bs-toggle="collapse"
              data-bs-target="#contactEdit">
        EDIT
      </button>
    </div>

    <div class="card-body row g-3">
      <div class="col-md-4"><strong>First Name:</strong> <span data-field="firstName"></span></div>
      <div class="col-md-4"><strong>Last Name:</strong> <span data-field="lastName"></span></div>
      <div class="col-md-4"><strong>Suffix:</strong> <span data-field="suffix"></span></div>
      <div class="col-md-6"><strong>Email:</strong> <span data-field="email"></span></div>
      <div class="col-md-6"><strong>Phone:</strong> <span data-field="phone"></span></div>
    </div>

    <div class="collapse" id="contactEdit">
      <div class="card-body bg-light border-top">
        <a href="/volunteerIn?disable=true">Go to Contact Page</a>
      </div>
    </div>
  </div>

  <!-- ================= PERSONAL ================= -->
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Personal Info</strong>
      <button class="btn btn-sm btn-outline-primary"
              data-bs-toggle="collapse"
              data-bs-target="#personalEdit">
        EDIT
      </button>
    </div>

    <div class="card-body row g-3">
      <div class="col-md-4"><strong>Date of Birth:</strong> <span data-field="dobirth"></span></div>
      <div class="col-md-4"><strong>Gender:</strong> <span data-field="gender"></span></div>
      <div class="col-md-4"><strong>Stamina:</strong> <span data-field="stamina"></span></div>
    </div>

    <div class="collapse" id="personalEdit">
      <div class="card-body bg-light border-top">
        <a href="/personalInfo">Go to Personal Info</a>
      </div>
    </div>
  </div>

  <!-- ================= CONGREGATION ================= -->
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Congregation Info</strong>
      <button class="btn btn-sm btn-outline-primary"
              data-bs-toggle="collapse"
              data-bs-target="#congEdit">
        EDIT
      </button>
    </div>

    <div class="card-body row g-3">
      <div class="col-md-4"><strong>Assigned:</strong> <span data-field="assignedToConv"></span></div>
      <div class="col-md-8"><strong>Congregation:</strong> <span data-field="congregation"></span></div>
      <div class="col-md-4"><strong>Attending Another:</strong> <span data-field="attendExtra"></span></div>
    </div>

    <div class="collapse" id="congEdit">
      <div class="card-body bg-light border-top">
        <a href="/congregationInfo">Go to Congregation Info</a>
      </div>
    </div>
  </div>

  <!-- ================= SPIRITUAL ================= -->
  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <strong>Spiritual & Privileges</strong>
      <button class="btn btn-sm btn-outline-primary"
              data-bs-toggle="collapse"
              data-bs-target="#spiritualEdit">
        EDIT
      </button>
    </div>

    <div class="card-body">
      <ul class="list-group" id="privilegeList"></ul>
    </div>

    <div class="collapse" id="spiritualEdit">
      <div class="card-body bg-light border-top">
        <a href="/spiritualInfo">Go to Spiritual Info</a>
      </div>
    </div>
  </div>

  <!-- ================= FINAL SUBMIT ================= -->
  <form method="POST" action="/submitNotes">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="card">
      <div class="card-header">Final Notes (optional)</div>
      <div class="card-body">
        <textarea name="note" class="form-control" rows="4"></textarea>

        <div class="text-center mt-4">
          <button type="button"
                  class="btn btn-success btn-lg"
                  data-bs-toggle="modal"
                  data-bs-target="#confirmModal">
            Submit Registration
          </button>
        </div>
      </div>
    </div>
  </form>

</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Submission</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Please confirm that all information is correct before submitting.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="submit" class="btn btn-success">
          Yes, Submit
        </button>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= nonce %>">
  window.__VOLUNTEER__ = <%- JSON.stringify(volunteer || {}) %>;
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/formSummary.js"></script>
</body>
</html>