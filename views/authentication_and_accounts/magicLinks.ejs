<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Magic Links — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('../partials/header') %>

    <main class="container-fluid py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header">
              <div class="text-center">
                <h1 class="h2 my-2">
                  <i class="fa-solid fa-qrcode me-2"></i>Magic Links
                </h1>
                <p class="mb-0">
                  Passwordless login tokens for shared accounts (e.g. COUNTER
                  stations). Generate new links with
                  <code>node scripts/generateMagicLink.js &lt;email&gt; [label]</code>.
                  Revoking here takes effect immediately.
                </p>
              </div>
            </header>

            <div class="card-body py-4">
              <% if (!tokens.length) { %>
                <p class="text-muted text-center my-4">No magic links have been generated yet.</p>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th>Account</th>
                        <th>Label</th>
                        <th>Created</th>
                        <th>Last Used</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% tokens.forEach((t) => { %>
                        <tr data-id="<%= t.id %>">
                          <td>
                            <div class="fw-semibold"><%= t.firstName %> <%= t.lastName %></div>
                            <div class="small text-muted"><%= t.email || '—' %></div>
                          </td>
                          <td><%= t.label || '—' %></td>
                          <td class="small"><%= new Date(t.created_at).toLocaleString() %></td>
                          <td class="small">
                            <%= t.last_used_at ? new Date(t.last_used_at).toLocaleString() : 'Never' %>
                          </td>
                          <td>
                            <% if (t.revoked_at) { %>
                              <span class="badge bg-secondary">Revoked</span>
                            <% } else if (t.expires_at && new Date(t.expires_at) < new Date()) { %>
                              <span class="badge bg-warning text-dark">Expired</span>
                            <% } else { %>
                              <span class="badge bg-success">Active</span>
                            <% } %>
                          </td>
                          <td class="text-end">
                            <% if (!t.revoked_at) { %>
                              <button type="button" class="btn btn-outline-danger btn-sm revoke-btn" data-id="<%= t.id %>">
                                <i class="fa-solid fa-ban me-1"></i>Revoke
                              </button>
                            <% } else { %>
                              <span class="text-muted small">—</span>
                            <% } %>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>

              <div class="mt-3">
                <a href="/oversight/tools" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i>Back to Oversight Tools
                </a>
              </div>
            </div><%# /.card-body %>
          </section>

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/magicLinks.js"></script>
  </body>
</html>
