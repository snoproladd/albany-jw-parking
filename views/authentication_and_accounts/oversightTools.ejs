<!DOCTYPE html>
<html lang="en">
<head>
  <title>Operations — Albany JW Parking</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shepherd.js@15.2.2/dist/css/shepherd.css" />
  <link rel="stylesheet" href="/css/tours.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="min-vh-100 bg-body-tertiary" data-authed="true">
  <%- include('../partials/header') %>

  <%
    const _ROLE_ORDER = ['NON_REGISTERED','REGISTERED', 'DESK', 'KEYMAN','OVERSEER','ASSISTANT_ADMIN','ADMIN'];
    const _role       = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
    const _perms      = typeof userPermissions !== 'undefined' ? userPermissions : {};
    const roleLevel   = _ROLE_ORDER.indexOf(_role);
    const isAtLeast   = (r) => roleLevel >= _ROLE_ORDER.indexOf(r);
    const can         = (permission) => !!(_perms[_role] && _perms[_role][permission]);
  %>

  <main class="container-fluid py-4 px-4">
    <div class="row justify-content-center">
      <div class="col-12 col-xl-10 col-xxl-9">

        <%# ── Mobile section jump dropdown ───────────────────────────── %>
        <div class="d-lg-none mb-3">
          <select class="form-select" id="otMobileNav" aria-label="Jump to section">
            <option value="">Jump to section…</option>
            <% if (can('manageRoles') || can('editVolunteerInfo') || can('createVolunteerAccounts') || isAtLeast('OVERSEER')) { %>
              <option value="volunteer-management">👥 Volunteer Management</option>
            <% } %>
            <% if (isAtLeast('OVERSEER')) { %>
              <option value="reports">📊 Reports</option>
            <% } %>
            <% if (can('viewSigns') || can('manageSigns')) { %>
              <option value="signs">🪧 Signs</option>
            <% } %>
            <% if (can('manageShifts') || can('accessAdminConsole')) { %>
              <option value="scheduling">📅 Scheduling</option>
            <% } %>
            <% if (can('logAttendance') || can('viewAttendance')) { %>
              <option value="attendance">✅ Attendance</option>
            <% } %>
            <% if (can('accessAdminConsole')) { %>
              <option value="decently-sync">🔄 Decently Sync</option>
            <% } %>
            <% if (can('manageRoles') && isAtLeast('ADMIN')) { %>
              <option value="administration">⚙️ Administration</option>
            <% } %>
            <a class="ot-sidebar-link" href="#site-map">
                <i class="fa-solid fa-sitemap"></i> Site Map
              </a>
          </nav>
          </select>
        </div>

        <div class="d-flex gap-4 align-items-start">

          <%# ── Desktop sidebar ─────────────────────────────────────── %>
          <nav class="d-none d-lg-flex flex-column gap-1 ot-sidebar flex-shrink-0" aria-label="Section navigation">
            <div class="ot-sidebar-label">Sections</div>
             <% if (can('manageRoles') || can('editVolunteerInfo') || can('createVolunteerAccounts') || isAtLeast('OVERSEER')) { %>
              <a class="ot-sidebar-link" href="#volunteer-management">
                <i class="fa-solid fa-users"></i> Volunteer Management
              </a>
            <% } %>
            <% if (isAtLeast('OVERSEER')) { %>
              <a class="ot-sidebar-link" href="#reports">
                <i class="fa-solid fa-chart-bar"></i> Reports
              </a>
            <% } %>
            <% if (can('viewSigns') || can('manageSigns')) { %>
              <a class="ot-sidebar-link" href="#signs">
                <i class="fa-solid fa-signs-post"></i> Signs
              </a>
            <% } %>
            <% if (can('manageShifts') || can('accessAdminConsole')) { %>
              <a class="ot-sidebar-link" href="#scheduling">
                <i class="fa-regular fa-calendar-days"></i> Scheduling
              </a>
            <% } %>
            <% if (can('logAttendance') || can('viewAttendance')) { %>
              <a class="ot-sidebar-link" href="#attendance">
                <i class="fa-solid fa-clipboard-check"></i> Attendance
              </a>
            <% } %>
            <% if (can('accessAdminConsole')) { %>
              <a class="ot-sidebar-link" href="#decently-sync">
                <i class="fa-solid fa-rotate"></i> Decently Sync
              </a>
            <% } %>
            <% if (can('manageRoles') && isAtLeast('ADMIN')) { %>
              <a class="ot-sidebar-link" href="#administration">
                <i class="fa-solid fa-gear"></i> Administration
              </a>
            <% } %>
              <a class="ot-sidebar-link" href="#site-map">
                <i class="fa-solid fa-sitemap"></i> Site Map
              </a>
          </nav>

          <div class="flex-grow-1 min-w-0">
        <section class="card shadow-lg admin-console-card">
          <header class="card-header">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="text-center flex-grow-1">
                <h1 class="h2 my-2">
                  <i class="fa-solid fa-screwdriver-wrench me-2"></i>Operations
                </h1>
                <p class="mb-0">Available tools are based on your role.</p>
              </div>            </div>
          </header>

          <div class="card-body py-4 px-4">

            <%# ══════════════════════════════════════════════
                1. COMMUNICATIONS
            ══════════════════════════════════════════════ %>
            <% if (can('accessAdminConsole')) { %>
              <h2 class="tools-group-heading" id="communications">
                <i class="fa-solid fa-paper-plane me-2"></i>Communications
              </h2>
              <div class="row g-4 mb-5">

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-primary">
                      <i class="fa-solid fa-envelope-open-text"></i>
                    </div>
                    <h3 class="admin-tool-title">Campaign Center</h3>
                    <p class="admin-tool-desc">Send convention invites via email or SMS. Manage campaigns, templates, and track RSVP responses.</p>
                    <a href="/oversight/tools/campaigns" class="btn btn-primary admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-success">
                      <i class="fa-solid fa-chart-gantt"></i>
                    </div>
                    <h3 class="admin-tool-title">Invitation Tracker</h3>
                    <p class="admin-tool-desc">View sent invitations, filter by campaign or response, and identify volunteers who haven't responded.</p>
                    <a href="/oversight/tools/campaigns/tracker" class="btn btn-success admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-warning">
                      <i class="fa-solid fa-link"></i>
                    </div>
                    <h3 class="admin-tool-title">Send Reset Link</h3>
                    <p class="admin-tool-desc">Send password reset or account completion links to volunteers with incomplete registrations.</p>
                    <a href="/oversight/tools/send-reset" class="btn btn-warning admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

              <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-danger">
                      <i class="fa-solid fa-bug"></i>
                    </div>
                    <h3 class="admin-tool-title">Bug Reports</h3>
                    <p class="admin-tool-desc">Review bugs submitted by volunteers. Update status, log the solution, and record which files were touched.</p>
                    <a href="/oversight/tools/bug-reports" class="btn btn-danger admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

              </div>
            <% } %>

            <%# ══════════════════════════════════════════════
                2. VOLUNTEER MANAGEMENT
            ══════════════════════════════════════════════ %>
            <% if (can('manageRoles') || can('editVolunteerInfo') || can('createVolunteerAccounts') || isAtLeast('OVERSEER')) { %>
              <h2 class="tools-group-heading" id="volunteer-management">
                <i class="fa-solid fa-users me-2"></i>Volunteer Management
              </h2>
              <div class="row g-4 mb-5">

                <% if (can('editVolunteerInfo')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-success">
                        <i class="fa-solid fa-id-card"></i>
                      </div>
                      <h3 class="admin-tool-title">Edit Volunteer</h3>
                      <p class="admin-tool-desc">View and edit volunteer account information including contact, congregation, and spiritual details.</p>
                      <a href="/editVolunteer" class="btn btn-success admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('createVolunteerAccounts')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-info">
                        <i class="fa-solid fa-user-plus"></i>
                      </div>
                      <h3 class="admin-tool-title">Create Volunteer</h3>
                      <p class="admin-tool-desc">Manually create a new volunteer account. A temporary password is set automatically.</p>
                      <a href="/oversight/tools/create-volunteer" class="btn btn-info admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

               <% if (can('manageRoles') || isAtLeast('OVERSEER')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-user-shield"></i>
                      </div>
                      <h3 class="admin-tool-title">Role Management</h3>
                      <p class="admin-tool-desc">Assign and update volunteer roles. Roles control what each user can see and do across the site.</p>
                      <a href="/oversight/roles" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (isAtLeast('OVERSEER')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-warning">
                        <i class="fa-solid fa-note-sticky"></i>
                      </div>
                      <h3 class="admin-tool-title">Notes Report</h3>
                      <p class="admin-tool-desc">Review intake notes from volunteer registration. Acknowledge notes, create action items, and track resolutions.</p>
                      <a href="/oversight/tools/notes-report" class="btn btn-warning admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('deleteVolunteer')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-comment-sms"></i>
                      </div>
                      <h3 class="admin-tool-title">SMS Management</h3>
                      <p class="admin-tool-desc">View and manage volunteer SMS opt-in and opt-out status. Manually toggle opt-in for volunteers who request it verbally.</p>
                      <a href="/editVolunteer?tab=sms" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

              </div>
            <% } %>
            <%# ══════════════════════════════════════════════
                3. REPORTS
            ══════════════════════════════════════════════ %>
            <% if (isAtLeast('OVERSEER')) { %>
              <h2 class="tools-group-heading" id="reports">
                <i class="fa-solid fa-chart-bar me-2"></i>Reports
              </h2>

              <%# ── Volunteer reports ──────────────────────── %>
              <p class="tools-sub-heading">
                <i class="fa-solid fa-users" aria-hidden="true"></i>Volunteers
              </p>
              <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-info">
                      <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <h3 class="admin-tool-title">Application Status</h3>
                    <p class="admin-tool-desc">All volunteers with their registration status and any missing required information.</p>
                    <a href="/oversight/tools/reports?tab=app-status" class="btn btn-info admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-primary">
                      <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <h3 class="admin-tool-title">Demographics</h3>
                    <p class="admin-tool-desc">Age distribution, gender split, and spiritual privilege breakdown across active volunteers.</p>
                    <a href="/oversight/tools/reports?tab=demographics" class="btn btn-primary admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-warning">
                      <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <h3 class="admin-tool-title">Target Levels</h3>
                    <p class="admin-tool-desc">Slot fill rate vs. volunteer-need targets per convention day — see where you're short.</p>
                    <a href="/oversight/tools/reports?tab=target-levels" class="btn btn-warning admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
              </div>

              <%# ── Crew reports ───────────────────────────── %>
              <p class="tools-sub-heading">
                <i class="fa-solid fa-people-group" aria-hidden="true"></i>Crews
              </p>
              <div class="row g-4 mb-4">
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-success">
                      <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <h3 class="admin-tool-title">Staff Usage</h3>
                    <p class="admin-tool-desc">Roster size and scheduling activity per crew — compare assigned volunteers to actual shifts filled.</p>
                    <a href="/oversight/tools/reports?tab=staff-usage" class="btn btn-success admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
              </div>

              <%# ── Event day reports ──────────────────────── %>
              <p class="tools-sub-heading">
                <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>Event Day
              </p>
              <div class="row g-4 mb-5">
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-danger">
                      <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <h3 class="admin-tool-title">Crew Attendance</h3>
                    <p class="admin-tool-desc">Attended vs. no-show counts per convention day, rolled up from shift invitation and check-in records.</p>
                    <a href="/oversight/tools/reports?tab=crew-attendance" class="btn btn-danger admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-warning">
                      <i class="fa-solid fa-people-arrows"></i>
                    </div>
                    <h3 class="admin-tool-title">Day Staffing</h3>
                    <p class="admin-tool-desc">Pick a convention day and see each crew's need vs. scheduled vs. present — color-coded so you can spot where to redeploy volunteers instantly.</p>
                    <a href="/oversight/tools/reports?tab=day-staffing" class="btn btn-warning admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100 admin-tool-card--soon">
                    <div class="admin-tool-icon text-secondary">
                      <i class="fa-solid fa-warehouse"></i>
                    </div>
                    <h3 class="admin-tool-title">Garage Capacity</h3>
                    <p class="admin-tool-desc">Vehicle counts and capacity utilization per garage or lot across each convention day. <em>Coming soon.</em></p>
                    <span class="btn btn-secondary admin-tool-btn disabled" aria-disabled="true">Coming Soon</span>
                  </div>
                </div>
              </div>
            <% } %>
            <%# ══════════════════════════════════════════════
                3.5 SIGNS
            ══════════════════════════════════════════════ %>
            <% if (can('viewSigns') || can('manageSigns')) { %>
              <h2 class="tools-group-heading" id="signs">
                <i class="fa-solid fa-signs-post me-2"></i>Signs
              </h2>
              <div class="row g-4 mb-5">

                <% if (can('viewSigns')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-table-list"></i>
                      </div>
                      <h3 class="admin-tool-title">Sign Library</h3>
                      <p class="admin-tool-desc">Browse sign templates and the places they are deployed. Search by sign text or description.</p>
                      <a href="/signs" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('manageSigns')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-success">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </div>
                      <h3 class="admin-tool-title">Sign Builder</h3>
                      <p class="admin-tool-desc">Create reusable sign templates with text and arrow direction. Place each template in multiple locations.</p>
                      <a href="/signs/builder" class="btn btn-success admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('viewSigns')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-warning">
                        <i class="fa-solid fa-map-location-dot"></i>
                      </div>
                      <h3 class="admin-tool-title">Sign Map</h3>
                      <p class="admin-tool-desc">View all sign placements on a satellite map. Overseer and above can place, reposition, and manage signs directly on the map.</p>
                      <a href="/signs/map" class="btn btn-warning admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

              </div>
            <% } %>

            <%# ══════════════════════════════════════════════
                4. SCHEDULING
            ══════════════════════════════════════════════ %>
            <% if (can('manageShifts') || can('createAssignments') || can('accessAdminConsole')) { %>
              <h2 class="tools-group-heading" id="scheduling">
                <i class="fa-regular fa-calendar-days me-2"></i>Scheduling
              </h2>
              <div class="row g-4 mb-5">

                <% if (can('manageShifts')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-warning">
                        <i class="fa-regular fa-clock"></i>
                      </div>
                      <h3 class="admin-tool-title">Timelines</h3>
                      <p class="admin-tool-desc">Define convention days, sessions, and event shifts. Mark shifts as invitable and attach locations.</p>
                      <a href="/oversight/tools/timelines" class="btn btn-warning admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('manageShifts')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-map-pin"></i>
                      </div>
                      <h3 class="admin-tool-title">Locations</h3>
                      <p class="admin-tool-desc">Define parking locations and zones for the current year. Used to build shift assignments.</p>
                      <a href="/oversight/tools/locationsAndTasks" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('accessAdminConsole')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-secondary">
                        <i class="fa-solid fa-tags"></i>
                      </div>
                      <h3 class="admin-tool-title">Event Types</h3>
                      <p class="admin-tool-desc">Manage shift categories used in scheduling — Ingress, Egress, Security, and more.</p>
                      <a href="/oversight/tools/timelines/event-types" class="btn btn-secondary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('createAssignments')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-warning">
                        <i class="fa-solid fa-people-group"></i>
                      </div>
                      <h3 class="admin-tool-title">Crew Assignments</h3>
                      <p class="admin-tool-desc">Assign volunteers to parking crews. Controls which shifts each volunteer can be scheduled for in the Scheduler.</p>
                      <a href="/oversight/tools/crew-assignments" class="btn btn-warning admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('createAssignments')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-success">
                        <i class="fa-solid fa-calendar-days"></i>
                      </div>
                      <h3 class="admin-tool-title">Scheduler</h3>
                      <p class="admin-tool-desc">Drag and drop volunteers onto shift slots. Filter the pool by rank or department and enforce role eligibility automatically.</p>
                      <a href="/oversight/tools/scheduler" class="btn btn-success admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('createAssignments')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-warning">
                        <i class="fa-solid fa-table-cells"></i>
                      </div>
                      <h3 class="admin-tool-title">Master Conflict Grid</h3>
                      <p class="admin-tool-desc">View all volunteers against all shifts across every convention day. Highlights scheduling and personal conflicts at a glance.</p>
                      <a href="/oversight/tools/conflict-grid" class="btn btn-warning admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('deleteVolunteer')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-list-check"></i>
                      </div>
                      <h3 class="admin-tool-title">Schedule Analysis Rules</h3>
                      <p class="admin-tool-desc">Manage the standing policy rules injected into the AI schedule analysis. Rules influence how violations are assessed and suggested for resolution.</p>
                      <a href="/oversight/tools/schedule-rules" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('createAssignments')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-info">
                        <i class="fa-solid fa-calendar-check"></i>
                      </div>
                      <h3 class="admin-tool-title">Volunteer Schedule</h3>
                      <p class="admin-tool-desc">Look up any volunteer's shift assignments across all convention days. Print or send their schedule via SMS or email.</p>
                      <a href="/oversight/tools/volunteer-schedule" class="btn btn-info admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('accessAdminConsole')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-danger">
                        <i class="fa-solid fa-bell"></i>
                      </div>
                      <h3 class="admin-tool-title">Shift Alerts</h3>
                      <p class="admin-tool-desc">Schedule and send SMS shift reminders. Manage burst alerts and rolling T‑15 notifications, and review the full send log.</p>
                      <a href="/oversight/tools/shift-alerts" class="btn btn-danger admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

              </div>
            <% } %>

            <%# ══════════════════════════════════════════════
                4. ATTENDANCE
            ══════════════════════════════════════════════ %>
            <% if (can('logAttendance') || can('viewAttendance')) { %>
              <h2 class="tools-group-heading" id="attendance">
                <i class="fa-solid fa-clipboard-check me-2"></i>Attendance
              </h2>
              <div class="row g-4 mb-5">

                <% if (can('logAttendance')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-info">
                        <i class="fa-solid fa-clipboard-check"></i>
                      </div>
                      <h3 class="admin-tool-title">Check-In Tool</h3>
                      <p class="admin-tool-desc">Log volunteer attendance shift by shift. Mark arrivals, add walk-ins, and record notes in real time.</p>
                      <a href="/oversight/tools/attendance/checkin" class="btn btn-info admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('viewAttendance')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-chart-bar"></i>
                      </div>
                      <h3 class="admin-tool-title">Attendance Report</h3>
                      <p class="admin-tool-desc">View attendance across all shifts for a convention day. See invited, RSVP, attended, and no-show counts per shift.</p>
                      <a href="/oversight/tools/attendance/report" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

              </div>
            <% } %>

            <%# ══════════════════════════════════════════════
                5. DECENTLY SYNC
            ══════════════════════════════════════════════ %>
            <% if (can('accessAdminConsole')) { %>
              <h2 class="tools-group-heading" id="decently-sync">
                <i class="fa-solid fa-rotate me-2"></i>Decently Sync
              </h2>
              <div class="row g-4 mb-5">

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-secondary">
                      <i class="fa-solid fa-file-export"></i>
                    </div>
                    <h3 class="admin-tool-title">Export to Decently</h3>
                    <p class="admin-tool-desc">Download a CSV of volunteers not yet exported and mark them as exported in the system.</p>
                    <a href="/oversight/tools/decently-export" class="btn btn-secondary admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-success">
                      <i class="fa-solid fa-file-import"></i>
                    </div>
                    <h3 class="admin-tool-title">Import from Decently</h3>
                    <p class="admin-tool-desc">Upload an approved volunteer CSV from Decently. Matches records, sets active status, and flags new volunteers.</p>
                    <a href="/oversight/tools/decently-import" class="btn btn-success admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

              </div>
            <% } %>

            <%# ══════════════════════════════════════════════
                6. ADMINISTRATION
            ══════════════════════════════════════════════ %>
            <% if (can('manageRoles') && isAtLeast('ADMIN')) { %>
              <h2 class="tools-group-heading" id="administration">
                <i class="fa-solid fa-gear me-2"></i>Administration
              </h2>
              <div class="row g-4 mb-2">

                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-danger">
                      <i class="fa-solid fa-sliders"></i>
                    </div>
                    <h3 class="admin-tool-title">Permission Matrix</h3>
                    <p class="admin-tool-desc">Override default role permissions at runtime. Changes take effect on next login.</p>
                    <a href="/oversight/tools/permissions" class="btn btn-danger admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <% if (can('manageCampaigns')) { %>
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-primary">
                      <i class="fa-solid fa-diagram-project"></i>
                    </div>
                    <h3 class="admin-tool-title">Layers of Oversight</h3>
                    <p class="admin-tool-desc">Configure the reporting structure displayed on volunteer home pages.</p>
                    <a href="/oversight/tools/oversightstructure" class="btn btn-primary admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>
                <% } %>

              </div>
            <% } %>

          <%# ══════════════════════════════════════════════
                7. DOCS
            ══════════════════════════════════════════════ %>
            <% if (can('viewMaps') || can('viewSchedules')) { %>
              <h2 class="tools-group-heading" id="docs">
                <i class="fa-solid fa-folder-open me-2"></i>Docs
              </h2>
              <div class="row g-4 mb-5">

                <% if (can('viewMaps')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-primary">
                        <i class="fa-solid fa-map"></i>
                      </div>
                      <h3 class="admin-tool-title">Maps</h3>
                      <p class="admin-tool-desc">Convention parking maps, pedestrian routes, sign placement guides, and other reference materials.</p>
                      <a href="/maps" class="btn btn-primary admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

                <% if (can('viewSchedules')) { %>
                  <div class="col-12 col-sm-6 col-lg-4">
                    <div class="admin-tool-card h-100">
                      <div class="admin-tool-icon text-success">
                        <i class="fa-solid fa-calendar-check"></i>
                      </div>
                      <h3 class="admin-tool-title">Schedules</h3>
                      <p class="admin-tool-desc">Published convention day shift schedules for all departments.</p>
                      <a href="/schedules" class="btn btn-success admin-tool-btn">
                        Open <i class="fa-solid fa-arrow-right ms-1"></i>
                      </a>
                    </div>
                  </div>
                <% } %>

              </div>
            <% } %>

          <%# ══════════════════════════════════════════════
                8. SITE MAP
            ══════════════════════════════════════════════ %>
            <h2 class="tools-group-heading" id="site-map">
              <i class="fa-solid fa-sitemap me-2"></i>Site Map
            </h2>
            <div class="row g-4 mb-2">
              <div class="col-12 col-sm-6 col-lg-4">
                <div class="admin-tool-card h-100">
                  <div class="admin-tool-icon text-secondary">
                    <i class="fa-solid fa-sitemap"></i>
                  </div>
                  <h3 class="admin-tool-title">Site Map</h3>
                  <p class="admin-tool-desc">Browse all pages on this platform, filtered to your current access level.</p>
                  <a href="/sitemap" class="btn btn-outline-secondary admin-tool-btn">
                    Open <i class="fa-solid fa-arrow-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>

          </div><!-- /.card-body -->
        </section>

          </div><%# /.flex-grow-1 %>
        </div><%# /.d-flex sidebar wrapper %>

      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/oversightTools.js"></script>
  <script type="module" src="/js/tours/oversightToolsTour.js"></script>
</body>
</html>
