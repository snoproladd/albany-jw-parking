<head>
        <title>Extra Information</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Bootstrap CSS -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            crossorigin="anonymous"
        />

        <!-- FontAwesome -->
        <link rel="stylesheet" href="styles/fontawesome/css/fontawesome.min.css" />
        <link rel="stylesheet" href="styles/fontawesome/css/all.css" />

        <!-- Custom styles -->
        <link rel="stylesheet" type="text/css" href="styles/styles.css" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary">
        <main class="container body-container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8 form-entry">
                    <!-- Banner/Card replacement for jumbotron -->
                    <section id="email-pass" class="card shadow-lg">
                        <header class="card-header text-center">
                            <h1 class="text-center mb-4">
                                Use this page for comment or to add details
                            </h1>
                            <h5>
                                Please do not share confidential or sensitive information here
                            </h5>
                        </header>
                        <div class="card-body">
                            <form action="/submitNotes" method="POST" id="account-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                <div class = "row">
                                    <div class ="mb-3">
                                        <label for ="extraInfo" class ="form-label"></label>
                                        <textarea name="note" class="form-control" id="extraInfo" placeholder="Enter notes here" rows="5"></textarea>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">
                                    Submit
                                </button>

                                <div
                                    id="submit-status"
                                    class="status mt-2"
                                    role="status"
                                    aria-live="polite"
                                ></div>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </main>







        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    </body>
</html>