<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Create Volunteer — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('../partials/header') %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header text-center">
              <h1 class="h2 my-2">
                <i class="fa-solid fa-user-plus me-2"></i>Create Volunteer Account
              </h1>
              <p class="mb-0">
                Manually register a new volunteer. Temporary password will be
                <strong>LastName1914</strong> (case-sensitive).
              </p>
            </header>

            <div class="card-body">

              <!-- Server-rendered alerts (redirect path) -->
              <div id="pageAlert">
                <% if (success) { %>
                  <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i><%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                  </div>
                <% } %>
                <% if (error) { %>
                  <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                  </div>
                <% } %>
              </div>

              <!-- JS-rendered alert slot -->
              <div id="formAlert"></div>

              <form id="createVolForm" novalidate>
                <input type="hidden" name="_csrf"  id="csrfToken"  value="<%= csrfToken %>" />
                <input type="hidden" name="force"  id="forceCreate" value="false" />

                <!-- ── Name row ──────────────────────────────────────── -->
                <div class="row g-3 mb-3">
                  <div class="col-12 col-sm-5">
                    <label for="firstName" class="form-label">
                      First Name <span class="text-danger">*</span>
                    </label>
                    <input
                      type="text" id="firstName" name="firstName"
                      class="form-control"
                      value="<%= fields.firstName %>"
                      autocomplete="given-name" required
                    />
                  </div>
                  <div class="col-12 col-sm-5">
                    <label for="lastName" class="form-label">
                      Last Name <span class="text-danger">*</span>
                    </label>
                    <input
                      type="text" id="lastName" name="lastName"
                      class="form-control"
                      value="<%= fields.lastName %>"
                      autocomplete="family-name" required
                    />
                  </div>
                  <div class="col-12 col-sm-2">
                    <label for="suffix" class="form-label">Suffix</label>
                    <input
                      type="text" id="suffix" name="suffix"
                      class="form-control"
                      value="<%= fields.suffix %>"
                      placeholder="Jr." maxlength="20"
                    />
                  </div>
                </div>

                <!-- ── Email ─────────────────────────────────────────── -->
                <div class="mb-3">
                  <label for="email" class="form-label">
                    Email <span class="text-danger">*</span>
                  </label>
                  <input
                    type="email" id="email" name="email"
                    class="form-control"
                    value="<%= fields.email %>"
                    autocomplete="email" required
                  />
                  <div id="email-status" class="form-text mt-1" role="status" aria-live="polite"></div>
                </div>

                <!-- ── Phone ─────────────────────────────────────────── -->
                <div class="mb-4">
                  <label for="phone" class="form-label">
                    Phone <span class="text-danger">*</span>
                  </label>
                  <%# input[type=tel] — masking applied via JS %>
                  <input
                    type="tel" id="phone" name="phone"
                    class="form-control"
                    value="<%= fields.phone %>"
                    autocomplete="tel"
                    placeholder="(555) 555-5555"
                    maxlength="14"
                    required
                  />
                  <div id="phone-status" class="form-text mt-1" role="status" aria-live="polite"></div>
                </div>

                <!-- ── Congregation ───────────────────────────────────── -->
                <div class="mb-3">
                  <label for="congSelect" class="form-label">Congregation</label>
                  <select id="congSelect" name="congAssigned" class="form-select">
                    <option value="" disabled <%= !fields.congAssigned ? 'selected' : '' %>>
                      — Select an option —
                    </option>
                    <option value="unknown" <%= fields.congAssigned === 'unknown' ? 'selected' : '' %>>
                      Not known — volunteer will update later
                    </option>
                    <option value="no" <%= fields.congAssigned === 'no' ? 'selected' : '' %>>
                      Not assigned — visiting congregation
                    </option>
                    <optgroup label="Albany-area congregations">
                      <% congregations.forEach(cong => { %>
                        <%# congregations is an array of strings like "Name, State" %>
                        <option
                          value="yes|<%= cong %>"
                          <%= fields.congAssigned === 'yes' && fields.congregation === cong ? 'selected' : '' %>
                        >
                          <%= cong %>
                        </option>
                      <% }) %>
                    </optgroup>
                  </select>
                  <%# Hidden field carries the resolved congregation string for assigned rows %>
                  <input type="hidden" id="congregationHidden" name="congregation" value="<%= fields.congregation %>" />
                </div>

                <!-- ── Visiting fields (shown only when "Not assigned" chosen) ── -->
                <div id="visitingFields" class="<%= fields.congAssigned === 'no' ? '' : 'd-none' %> mb-4">
                  <div class="card border-secondary">
                    <div class="card-body py-3">
                      <p class="small text-muted mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Enter the volunteer's home congregation details.
                      </p>
                      <div class="row g-3">
                        <div class="col-12 col-sm-5">
                          <label for="congregationOtherCity" class="form-label">City</label>
                          <input
                            type="text" id="congregationOtherCity" name="congregationOtherCity"
                            class="form-control"
                            value="<%= fields.congregationOtherCity %>"
                            placeholder="City"
                          />
                        </div>
                        <div class="col-12 col-sm-3">
                          <label for="congregationOtherState" class="form-label">State</label>
                          <input
                            type="text" id="congregationOtherState" name="congregationOtherState"
                            class="form-control"
                            value="<%= fields.congregationOtherState %>"
                            placeholder="NY"
                            maxlength="2"
                          />
                        </div>
                        <div class="col-12 col-sm-4">
                          <label for="congregationOtherLang" class="form-label">Language</label>
                          <input
                            type="text" id="congregationOtherLang" name="congregationOtherLang"
                            class="form-control"
                            value="<%= fields.congregationOtherLang %>"
                            placeholder="e.g. Spanish"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="d-grid gap-2">
                  <button type="submit" id="submitBtn" class="btn btn-info text-white" disabled>
                    <i class="fa-solid fa-user-plus me-2"></i>Create Account
                  </button>
                </div>
              </form>

              <div class="mt-3">
                <a href="/oversight/tools" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-arrow-left me-1"></i>Back to Oversight Tools
                </a>
              </div>

            </div>
          </section>
        </div>
      </div>
    </main>

    <!-- ============================================================
         DUPLICATE MATCH MODAL
    ============================================================ -->
    <div
      class="modal fade"
      id="duplicateModal"
      tabindex="-1"
      aria-labelledby="duplicateModalLabel"
      aria-modal="true"
      role="dialog"
    >
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header bg-warning text-dark">
            <h2 class="modal-title h5" id="duplicateModalLabel">
              <i class="fa-solid fa-triangle-exclamation me-2"></i>Potential Matches Found
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="mb-3">
              The following existing volunteers closely match the information you entered.
              You can open an existing record to edit it, or create a new account anyway.
            </p>
            <div id="duplicateList"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
              <i class="fa-solid fa-pencil me-1"></i>Back to Edit Form
            </button>
            <button type="button" id="forceCreateBtn" class="btn btn-danger">
              <i class="fa-solid fa-user-plus me-1"></i>Create New Anyway
            </button>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/adminCreateVolunteer.js"></script>
  </body>
</html>
