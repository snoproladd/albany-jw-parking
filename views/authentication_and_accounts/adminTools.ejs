<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Admin Tools — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>

  <body class="min-vh-100 bg-body-tertiary">
    <%- include('../partials/header') %>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-12 admin-console-card">

          <section class="card shadow-lg admin-console-card">
            <header class="card-header text-center">
              <h1 class="h2 my-2">
                <i class="fa-solid fa-screwdriver-wrench me-2"></i>Admin Tools
              </h1>
              <p class="mb-0">Manage volunteers, roles, schedules, and communications.</p>
            </header>

            <div class="card-body py-4">
              <div class="row g-4">

                <!-- Role Management -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-primary">
                      <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <h2 class="admin-tool-title">Role Management</h2>
                    <p class="admin-tool-desc">Assign and update volunteer roles. Roles control what each user can see and do.</p>
                    <a href="/admin/roles" class="btn btn-primary admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <!-- Edit Volunteer -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-success">
                      <i class="fa-solid fa-id-card"></i>
                    </div>
                    <h2 class="admin-tool-title">Edit Volunteer</h2>
                    <p class="admin-tool-desc">View and edit volunteer account information including contact, congregation, and spiritual info.</p>
                    <a href="/editVolunteer" class="btn btn-success admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <!-- Send Reset Link -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card h-100">
                    <div class="admin-tool-icon text-warning">
                      <i class="fa-solid fa-paper-plane"></i>
                    </div>
                    <h2 class="admin-tool-title">Send Reset Link</h2>
                    <p class="admin-tool-desc">Send password reset or account completion links to volunteers with incomplete registrations.</p>
                    <a href="/admin/tools/send-reset" class="btn btn-warning admin-tool-btn">
                      Open <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                  </div>
                </div>

                <!-- Schedules -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card admin-tool-card--soon h-100">
                    <div class="admin-tool-icon text-secondary">
                      <i class="fa-regular fa-calendar-days"></i>
                    </div>
                    <h2 class="admin-tool-title">Schedules</h2>
                    <p class="admin-tool-desc">Create and manage volunteer parking schedules by session and assignment.</p>
                    <span class="badge bg-secondary admin-tool-soon">Coming soon</span>
                  </div>
                </div>

                <!-- Print Schedules -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card admin-tool-card--soon h-100">
                    <div class="admin-tool-icon text-secondary">
                      <i class="fa-solid fa-print"></i>
                    </div>
                    <h2 class="admin-tool-title">Print Schedules</h2>
                    <p class="admin-tool-desc">Generate printable schedule sheets for distribution at the convention.</p>
                    <span class="badge bg-secondary admin-tool-soon">Coming soon</span>
                  </div>
                </div>

                <!-- Maps -->
                <div class="col-12 col-sm-6 col-lg-4">
                  <div class="admin-tool-card admin-tool-card--soon h-100">
                    <div class="admin-tool-icon text-secondary">
                      <i class="fa-solid fa-map"></i>
                    </div>
                    <h2 class="admin-tool-title">Maps</h2>