<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Set Your New Password</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary entry-body">
    <main class="container body-container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 form-entry">

          <section id="reset-password" class="card shadow-lg entry-card">
            <header class="card-header text-center">
              <h1 class="text-center mb-1">Create a New Password</h1>
              <p class="footnote mt-2 mb-0">
                Enter and confirm your new password below.
              </p>
            </header>

            <div class="card-body">
              <form action="/reset-password/<%= hash %>" method="POST" id="resetPass-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <div class="mb-3">
                  <label for="password" class="form-label">
                    New Password <span class="asterix">*</span>
                  </label>
                  <div class="input-group password-group">
                    <span class="input-group-text">
                      <i class="fa-solid fa-lock"></i>
                    </span>
                    <input
                      type="password"
                      id="password"
                      name="password"
                      class="form-control"
                      required
                    />
                    <button
                      class="input-group-text togglePasswordBtn"
                      type="button"
                      id="togglePassword"
                    >
                      <i class="fa-solid fa-eye"></i>
                    </button>
                  </div>
                  <div id="password-status" class="status mt-2" role="status"></div>
                </div>

                <div class="mb-3">
                  <label for="confirmPasswordInput" class="form-label">
                    Confirm Password
                  </label>
                  <input
                    type="password"
                    id="confirmPasswordInput"
                    name="confirmPasswordInput"
                    class="form-control"
                    required
                  />
                  <div
                    id="passwordsMatchedStatus"
                    class="status mt-2"
                    role="status"
                  ></div>
                </div>

                <button
                  type="submit"
                  id="resetPass-submit"
                  class="btn btn-primary w-100"
                >
                  Save New Password
                </button>

                <div id="submitStatus" class="mt-2" role="status"></div>
              </form>
            </div>
          </section>

        </div>
      </div>
    </main>

    <script src="/js/passwords.js"></script>
    <script src="/js/formListeners.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
