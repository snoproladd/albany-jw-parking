
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Login</title>
   <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css">
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary">
    <main class="container body-container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 form-entry">
          <!-- Banner/Card replacement for jumbotron -->
          <section id="email-pass" class="card shadow-lg">
            <header class="card-header text-center">
              <h1 class="text-center mb-4">Start Creating Your Profile</h1>
            </header>
            <div class="card-body">
              <form action="/login" method="POST" id="account-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- Email Fields -->
                <div class="mb-3">
                  <label for="email" class="form-label">Email:<span class="asterix">*</span></label>
                  <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required aria-describedby="email-status">
                 </div>
                <!-- Password Fields -->
                <div class="mb-3 d-none" id="passwords" hidden aria-hidden="true">
                  <label for="password" class="form-label">Create a password:<span class="asterix">*</span></label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Your new password" required aria-describedby="password-status">
                    <button type="button" class="input-group-text" id="togglePassword" title="Show/Hide password">
                      <i class="far fa-eye"></i>
                    </button>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Submit</button>
                  <div id="submit-status" class = "status mt-2" role="status" aria-live="polite"></div>
              <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                    <div class="btn-group gap-5" role="group">
                      <button
                        type="button"
                        id="forgot-password"
                        class="btn btn-outline-secondary">
                        Forgot Password
                      </button>
                      <button
                        type="submit"
                        id="final-submit"
                        class="btn btn-success">
                        Submit
                      </button>
                    </div>
                  </div>
                </form>
            </div>
          </section>
        </div>
      </div>
    </main>

    <!-- Custom JS -->
    <script src="/js/email-validation.js"></script>
    <script src="/js/passwords.js"></script>
    <script src="/js/formListeners.js"></script>
        <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
