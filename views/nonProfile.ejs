
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Enter Information</title>
<meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css">
    <link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary">
    <main class="container body-container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 form-entry">
          <!-- Banner/Card replacement for jumbotron -->
          <section id="non-profile" class="card shadow-lg">
            <header class="card-header text-center">
              <h1 class="text-center mb-4">Enter Information</h1>
            </header>
            <div class="card-body">
              <form action="/submit-nonProfileInfo" method="POST" id="account-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- Name Fields -->
                <div class="mb-3">
                  <label for="firstName" class="form-label">First Name:<span class="asterix">*</span></label>
                  <input type="text" id="firstName" name="firstName" class="form-control" aria-describedby="firstName-status" class="form-control" required>
                  <label for="lastName" class="form-label">Last Name:<span class="asterix">*</span></label>
                  <input type="text" id="lastName" name="lastName" aria-describedby="lastName-status" class="form-control" placeholder="Enter your last name" required>
                  <label for="suffix" class="form-label">Suffix (if applicable)</label>
                  <input type="text" id="suffix" name="suffix" class="form-control" placeholder="Enter your suffix">
                </div>
                <!-- Email Fields -->
                <div class="mb-3">
                  <label for="email" class="form-label">Email:<span class="asterix">*</span></label>
                  <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required aria-describedby="email-status">
                  <div id="email-status" class="status mt-2" role="status" aria-live="polite"></div>
                  <label for="confirm-email" class="form-label">Confirm Email:<span class="asterix">*</span></label>
                  <input type="email" id="confirm-email" name="confirm-email" class="form-control" placeholder="Confirm your email" required aria-describedby="confirm-email-status">
                  <div id="confirm-email-status" class="status mt-2" role="status" aria-live="polite"></div>
                </div>
                            <div id="submit-status" class="status mt-2" role="status" aria-live="polite"></div>

                <button type="submit" class="btn btn-primary w-100" id="nonProfile-next">Next</button>
                <div
                    id="nonProfile-next-status"
                    class="form-text text-muted mt-1"
                    aria-live="polite"
                  >
                    Complete email validation to continue.
                  </div>
              </form>
              <p class="footnote mt-3"><span class="asterix">*</span> Indicates required fields</p>
            </div>
          </section>
        </div>
      </div>
    </main>

    <!-- Custom JS -->
     <script src="/js/formListeners.js"></script>
    <script src="/js/email-validation.js"></script>
        <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
