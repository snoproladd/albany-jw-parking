<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Lessons Learned — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="stylesheet" type="text/css" href="/styles/lessonsLearned.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('partials/header') %>

    <main class="container-fluid py-4 ll-page">

      <%# ── Page header ────────────────────────────────────────── %>
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-3">
          <a href="/oversight/tools" class="btn btn-sm btn-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Oversight Tools
          </a>
          <h1 class="h3 mb-0">
            <i class="fa-solid fa-book-open me-2 text-primary"></i>Lessons Learned
          </h1>
        </div>
        <button class="btn btn-primary" id="ll-new-btn" type="button">
          <i class="fa-solid fa-plus me-1"></i>New Lesson
        </button>
      </div>

      <div class="ll-panel">

      <%# ── Year filter + tab pills ────────────────────────────── %>
      <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
        <div class="d-flex align-items-center gap-2">
          <label class="form-label mb-0 fw-semibold" for="ll-year-filter">Year</label>
          <select class="form-select form-select-sm ll-year-select" id="ll-year-filter">
            <option value="">All years</option>
          </select>
        </div>
        <ul class="nav nav-pills ll-tabs" id="ll-tab-pills" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="ll-tab-proposed" type="button"
                    data-ll-tab="proposed">Proposed</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="ll-tab-accepted" type="button"
                    data-ll-tab="accepted">
              <i class="fa-solid fa-circle-check me-1"></i>Accepted
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="ll-tab-published" type="button"
                    data-ll-tab="published">
              <i class="fa-solid fa-file-arrow-up me-1"></i>Published
            </button>
          </li>
          <% if (isOverseer) { %>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="ll-tab-archived" type="button"
                    data-ll-tab="archived">
              <i class="fa-solid fa-box-archive me-1"></i>Archived
            </button>
          </li>
          <% } %>
        </ul>
        <div id="ll-report-link-wrap" class="ms-auto d-none"></div>
      </div>

      <%# ── Card list ──────────────────────────────────────────── %>
      <div id="ll-cards" class="ll-cards" aria-live="polite">
        <div class="ll-loading">
          <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
          Loading…
        </div>
      </div>

      </div><%# /.ll-panel %>

    </main>

    <%# ── New Lesson modal ───────────────────────────────────────── %>
    <div class="modal fade" id="ll-new-modal" tabindex="-1"
         aria-labelledby="ll-new-modal-title" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title h5" id="ll-new-modal-title">
              <i class="fa-solid fa-plus me-2"></i>New Lesson Learned
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-sm-4">
                <label class="form-label fw-semibold" for="ll-new-year">
                  Convention Year <span class="text-danger">*</span>
                </label>
                <select class="form-select" id="ll-new-year" required>
                  <option value="">Select year…</option>
                </select>
              </div>
              <div class="col-sm-8">
                <label class="form-label fw-semibold" for="ll-new-dept">Department</label>
                <select class="form-select" id="ll-new-dept">
                  <option value="">— Select department —</option>
                </select>
              </div>
              <div id="ll-new-dept-other-wrap" class="col-12 d-none">
                <label class="form-label fw-semibold" for="ll-new-dept-other">Specify Department</label>
                <input type="text" class="form-control" id="ll-new-dept-other"
                       maxlength="100" placeholder="Enter department name…">
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold" for="ll-new-notes">
                  Lesson / Observation <span class="text-danger">*</span>
                </label>
                <textarea class="form-control ll-notes-field" id="ll-new-notes" rows="6"
                          placeholder="Describe the lesson learned, what happened, and any recommendations…"
                          required></textarea>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold">
                  Photos <small class="text-muted fw-normal">(optional, multiple allowed)</small>
                </label>
                <input type="file" class="form-control" id="ll-new-photos" accept="image/*" multiple>
              </div>
            </div>
            <div class="alert alert-danger mt-3 d-none" id="ll-new-error" role="alert"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="ll-new-submit">
              <span class="ll-submit-label">Submit</span>
              <span class="ll-submit-spinner spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ── Edit modal ─────────────────────────────────────────────── %>
    <div class="modal fade" id="ll-edit-modal" tabindex="-1"
         aria-labelledby="ll-edit-modal-title" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title h5" id="ll-edit-modal-title">
              <i class="fa-solid fa-pencil me-2"></i>Edit Lesson
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="ll-edit-id">
            <div class="row g-3">
              <div class="col-sm-4">
                <label class="form-label fw-semibold" for="ll-edit-year">Convention Year</label>
                <select class="form-select" id="ll-edit-year"></select>
              </div>
              <div class="col-sm-8">
                <label class="form-label fw-semibold" for="ll-edit-dept">Department</label>
                <select class="form-select" id="ll-edit-dept">
                  <option value="">— Select department —</option>
                </select>
              </div>
              <div id="ll-edit-dept-other-wrap" class="col-12 d-none">
                <label class="form-label fw-semibold" for="ll-edit-dept-other">Specify Department</label>
                <input type="text" class="form-control" id="ll-edit-dept-other" maxlength="100">
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold" for="ll-edit-notes">Lesson / Observation</label>
                <textarea class="form-control ll-notes-field" id="ll-edit-notes" rows="6"></textarea>
              </div>
              <div id="ll-edit-comments-wrap" class="col-12 d-none">
                <label class="form-label fw-semibold" for="ll-edit-comments">Overseer Comments</label>
                <textarea class="form-control" id="ll-edit-comments" rows="3"
                          placeholder="Add notes or feedback for the submitter…"></textarea>
              </div>
            </div>
            <div class="alert alert-danger mt-3 d-none" id="ll-edit-error" role="alert"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="ll-edit-submit">
              <span class="ll-submit-label">Save Changes</span>
              <span class="ll-submit-spinner spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ── Publish confirm modal ──────────────────────────────────── %>
    <div class="modal fade" id="ll-publish-modal" tabindex="-1"
         aria-labelledby="ll-publish-modal-title" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title h5" id="ll-publish-modal-title">
              <i class="fa-solid fa-file-arrow-up me-2"></i>Publish Lesson
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p>Publishing this lesson will mark it as <strong>Accepted</strong> and regenerate
            the lessons-learned PDF report for its convention year.</p>
            <p class="mb-0 text-muted small">The updated report will be uploaded to blob storage
            and SharePoint.</p>
            <input type="hidden" id="ll-publish-id">
            <div class="alert alert-warning mt-3 d-none" id="ll-publish-error" role="alert"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-success" id="ll-publish-confirm">
              <span class="ll-submit-label">Publish &amp; Generate PDF</span>
              <span class="ll-submit-spinner spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ── Page data (read by lessonsLearned.js) ──────────────────── %>
    <script type="application/json" id="ll-meta">
    {
      "csrfToken":  "<%= csrfToken %>",
      "userId":     <%= userId !== null ? userId : 'null' %>,
      "isOverseer": <%= isOverseer %>
    }
    </script>

    <%- include('partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/js/lessonsLearned.js"></script>
  </body>
</html>
