<!DOCTYPE html>
<html lang="en">
<head>
    <title>Print Sign Map — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" href="/styles/styles.css" />
    <link rel="stylesheet" href="/styles/signs.css" />
    <link rel="stylesheet" href="/styles/signsPrint.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
</head>

<body class="signs-print-body" data-authed="true">
    <%- include('../partials/header') %>

    <%
        const _role     = typeof userRole        !== 'undefined' ? userRole        : 'NON_REGISTERED';
        const _perms    = typeof userPermissions !== 'undefined' ? userPermissions : {};
        const can       = (permission) => !!(_perms[_role] && _perms[_role][permission]);
        const canManage = can('manageSigns');
    %>

    <%# ── Toolbar (hidden in print) ────────────────────────────── %>
    <div class="signs-print-toolbar" id="printToolbar">
        <a href="/signs/map" class="btn btn-sm btn-outline-secondary signs-print-back-btn">
            <i class="fa-solid fa-chevron-left me-1"></i>Back to <%= canManage ? 'Map Editor' : 'Sign Map' %>
        </a>

        <div class="signs-print-toolbar-group">
            <span class="signs-print-toolbar-label">Type</span>
            <div class="btn-group btn-group-sm" role="group" aria-label="Map type">
                <input type="radio" class="btn-check" name="mapType" id="mapTypeRoadmap" value="roadmap" checked />
                <label class="btn btn-outline-secondary" for="mapTypeRoadmap">Road</label>
                <input type="radio" class="btn-check" name="mapType" id="mapTypeHybrid" value="hybrid" />
                <label class="btn btn-outline-secondary" for="mapTypeHybrid">Hybrid</label>
            </div>
        </div>

        <div class="signs-print-toolbar-group">
            <span class="signs-print-toolbar-label">Status</span>
            <div class="d-flex align-items-center gap-2">
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input signs-print-filter-cb"
                           id="filterPlanned" value="planned" checked />
                    <label class="form-check-label small" for="filterPlanned">Planned</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input signs-print-filter-cb"
                           id="filterInstalled" value="installed" checked />
                    <label class="form-check-label small" for="filterInstalled">Installed</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input type="checkbox" class="form-check-input signs-print-filter-cb"
                           id="filterRemoved" value="removed" />
                    <label class="form-check-label small" for="filterRemoved">Removed</label>
                </div>
            </div>
        </div>

        <div class="signs-print-toolbar-group">
            <select class="form-select form-select-sm signs-print-template-select" id="templateFilter">
                <option value="">All templates</option>
                <%
                    const arrowGlyphForOption = (dir) => {
                        switch (dir) {
                            case 'up':            return '↑';
                            case 'down':          return '↓';
                            case 'left':           return '←';
                            case 'right':          return '→';
                            case 'up-left':        return '↖';
                            case 'up-right':       return '↗';
                            case 'down-left':      return '↙';
                            case 'down-right':     return '↘';
                            case 'up-then-left':   return '↰';
                            case 'up-then-right':  return '↱';
                            case 'destination':    return '📍';
                            default:               return '';
                        }
                    };
                %>
                <% signs.forEach(s => { %>
                    <%
                        const glyph = arrowGlyphForOption(s.arrow_direction);
                        const arrowPart = glyph ? ` ${glyph}` : '';
                    %>
                    <p class="small text-muted mb-1 fw-semibold">Sign types</p>
                            <ul class="signs-legend-list mb-2">
                                <li>
                                    <span class="sign-category-icon sign-category-icon-parking signs-legend-category-icon">P</span>
                                    Parking
                                </li>
                                <li>
                                    <i class="fa-solid fa-wheelchair signs-legend-category-icon" aria-hidden="true"></i>
                                    Accessible
                                </li>
                                <li>
                                    <i class="fa-solid fa-person-walking-luggage signs-legend-category-icon" aria-hidden="true"></i>
                                    Drop-off / Pick-up
                                </li>
                            </ul>

                            <p class="small text-muted mb-1 fw-semibold">Traffic arrows</p>
                <% }); %>
            </select>
        </div>

        <div class="signs-print-toolbar-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary me-1" id="fitBtn" disabled
                    title="Fit map to visible markers">
                <i class="fa-solid fa-expand"></i>
            </button>
            <button type="button" class="btn btn-sm btn-primary" id="printBtn" disabled>
                <i class="fa-solid fa-print me-1"></i>Print
            </button>
        </div>
    </div>

    <%# ── Page preview (WYSIWYG — what you see is what prints) ── %>
    <div class="signs-print-page" id="printPage">

        <%# Title %>
        <div class="signs-print-title" id="printTitle">
            <h1 class="signs-print-title-text">
                Albany JW Parking — Sign Placement Map
            </h1>
            <div class="signs-print-title-meta">
                <span id="printDate"></span>
                <span class="signs-print-title-sep">&middot;</span>
                <span id="printCount">0 placements</span>
            </div>
        </div>

        <%# Map (square, matches 7in × 7in print area) %>
        <div class="signs-print-map-wrap"
             id="signsMapRoot"
             data-api-key="<%= googleMapsApiKey %>"
             data-center-lat="<%= defaultMapCenter.lat %>"
             data-center-lng="<%= defaultMapCenter.lng %>"
             data-center-zoom="<%= defaultMapCenter.zoom %>">

            <% if (!googleMapsApiKey) { %>
                <div class="signs-map-missing-key p-5 text-center">
                    <i class="fa-solid fa-key fa-2x mb-3 text-warning"></i>
                    <h2 class="h5">Google Maps API key not configured</h2>
                    <p class="text-muted mb-0">
                        Set <code>GOOGLE_MAPS_API_KEY</code> in the environment and restart.
                    </p>
                </div>
            <% } else { %>
                <div id="googleMap" class="signs-print-map">
                    <div class="signs-map-loading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading…</span>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

        <%# Legend (below map, always visible) %>
        <div class="signs-print-legend" id="printLegend">
            <%# Populated by signsMapPrint.js %>
        </div>

    </div>

    <%# ── Bootstrap JSON ───────────────────────────────────────── %>
    <script id="signsMapBootstrap" type="application/json"><%- JSON.stringify({ signs, locations, mapOverlays: mapOverlays || [] }) %></script>

    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/signsMapOverlays.js"></script>
    <script src="/js/signsMapPrint.js"></script>
</body>
</html>