<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Spiritual Information</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Bootstrap CSS -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            crossorigin="anonymous"
        />

        <!-- FontAwesome -->
        <link rel="stylesheet" href="styles/fontawesome/css/fontawesome.min.css" />
        <link rel="stylesheet" href="styles/fontawesome/css/all.css" />

        <!-- Custom styles -->
        <link rel="stylesheet" type="text/css" href="styles/styles.css" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
            rel="stylesheet"
        />

    </head>
    <body
        class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary"
    >
        <main class="container body-container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8 form-entry">
                    <!-- Banner/Card replacement for jumbotron -->
                    <section id="email-pass" class="card shadow-lg">
                        <header class="card-header text-center">
                            <h1 class="text-center mb-4">
                                Tell us about your organization privileges and roles.
                            </h1>
                        </header>

                        <div class="card-body">
                            <form action="/submitSpiritual" method="POST" id="account-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                                <!-- #region Congregation Membership and assignment to convention -->
                                <fieldset
                                    class="border-0 p-0 mt-3"
                                    aria-describedby="spiritualInfo-help"
                                    aria-labelledby="spiritualInfo-legend"
                                >
                                    <legend id="spiritualInfo-legend" class="form-label mb-3">
                                        Do you have any of the following privileges?<br>
                                        (Check all that apply)
                                        <span class="asterix">*</span>
                                    </legend>

                                    <!-- Ministry -->
                                    <div class="mb-3">
                                        <div class="form-label ms-2 mb-1">Ministry</div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="auxPioneer"
                                                value="auxPioneer"
                                                data-privilege = "auxPioneer"
                                                
                                            >
                                            <label class="form-check-label" for="auxPioneer">
                                                Auxilliary Pioneer (including continuous)
                                            </label>
                                        </div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="regPioneer"
                                                value="regPioneer"
                                                data-privilege = "regPioneer"
                                            >
                                            <label class="form-check-label" for="regPioneer">
                                                Regular Pioneer
                                            </label>
                                        </div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="specPioneer"
                                                value="specPioneer"
                                                data-privilege = "specPioneer"
                                            >
                                            <label class="form-check-label" for="specPioneer">
                                                Special Pioneer
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Congregation -->
                                    <div class="mb-3">
                                        <div class="form-label ms-2 mb-1">Congregation</div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="minServ"
                                                value="minServ"
                                                data-privilege="minServ"
                                            >
                                            <label class="form-check-label" for="minServ">
                                                Ministerial Servant
                                            </label>
                                        </div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="elder"
                                                value="elder"
                                                data-privilege="elder"
                                            >
                                            <label class="form-check-label" for="elder">
                                                Elder
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Other -->
                                    <div class="mb-4">
                                        <div class="form-label ms-2 mb-1">Other</div>

                                        <div class="form-check ms-5">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="privileges[]"
                                                id="sfs"
                                                value="sfs"
                                                data-privilege="sfs"
                                            >
                                            <label class="form-check-label" for="sfs">
                                                Special Full-Time Servant
                                            </label>
                                        </div>
                                    </div>
                                </fieldset>


                                    
                                <!-- submit button -->
                                <button type="submit" class="btn btn-primary w-100">
                                    Submit
                                </button>

                                <div
                                    id="submit-status"
                                    class="status mt-2"
                                    role="status"
                                    aria-live="polite"
                                ></div>
                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </main>

        <!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Custom JS -->
<script nonce="<%= nonce %>">
  window.USER_GENDER = "<%= gender %>";
  window.PRIVILEGE_RULES = 
  <%- privilegeRulesJSON %>;
</script>
<script nonce="<%= nonce %>" src="/js/privilegeEnforcer.js"></script>

    </body>
</html>
