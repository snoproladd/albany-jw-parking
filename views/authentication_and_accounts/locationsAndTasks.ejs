<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Locations — Albany JW Parking</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
  </head>

  <body class="min-vh-100 bg-body-tertiary" data-authed="true">
    <%- include('../partials/header') %>

    <main class="container-fluid py-4">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

          <section class="card shadow-lg admin-console-card loc-card-full">
            <header class="card-header text-center">
              <h1 class="h2 my-2">
                <i class="fa-solid fa-map-pin me-2"></i>Locations
              </h1>
              <p class="mb-0">
                Manage parking locations for
                <strong><%= year %></strong>.
              </p>
            </header>

            <div class="card-body py-4">

              <%# ── Toolbar ── %>
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                <%# Year picker %>
                <form method="GET" action="/oversight/tools/locationsAndTasks"
                  class="d-flex align-items-center gap-2">
                  <label for="yearPicker" class="form-label mb-0 small fw-semibold">Year</label>
                  <select id="yearPicker" name="year" class="form-select form-select-sm loc-year-picker-select">
                    <% for (let y = currentYear + 1; y >= currentYear - 2; y--) { %>
                      <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                  </select>
                </form>

                <button type="button" class="btn btn-primary btn-sm" id="addBtn">
                  <i class="fa-solid fa-plus me-1"></i>Add New
                </button>
              </div>

              <%# ── Add / Edit form (hidden until needed) ── %>
              <div id="formPanel" class="card border-primary mb-4 d-none">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                  <span id="formPanelTitle" class="fw-semibold">Add Location</span>
                  <button type="button" class="btn-close btn-close-white btn-sm" id="formCloseBtn"></button>
                </div>
                <div class="card-body">
                  <input type="hidden" id="editId" value="" />

                  <div class="row g-3">

                    <%# Name %>
                    <div class="col-12 col-md-5">
                      <label for="fieldName" class="form-label small">
                        Name <span class="text-danger">*</span>
                      </label>
                      <input type="text" id="fieldName" class="form-control" maxlength="100"
                        placeholder="e.g. Lot A, Mobile Security" />
                    </div>

                    <%# Type %>
                    <div class="col-12 col-md-3">
                      <!-- <label for="fieldType" class="form-label small">
                        Type <span class="text-danger">*</span>
                      </label> -->
                      <select id="fieldType" class="form-select" selected="location" hidden>
                        <option value="location">Location</option>
                        
                      </select>
                    </div>

                    <%# Capacity %>
                    <div class="col-12 col-md-2">
                      <label for="fieldCapacity" class="form-label small">Capacity</label>
                      <input type="number" id="fieldCapacity" class="form-control" min="1" max="999"
                        placeholder="—" />
                    </div>

                    <%# Active (edit mode only) %>
                    <div class="col-12 col-md-2 d-flex align-items-end" id="activeToggleWrap">
                      <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch"
                          id="fieldActive" checked />
                        <label class="form-check-label small" for="fieldActive">Active</label>
                      </div>
                    </div>

                    <%# Description %>
                    <div class="col-12">
                      <label for="fieldDescription" class="form-label small">Description</label>
                      <textarea id="fieldDescription" class="form-control" rows="2"
                        maxlength="500" placeholder="Optional notes"></textarea>
                    </div>

                    <%# Address (locations only) %>
                    <div class="col-12 col-md-6" id="addressWrap">
                      <label for="fieldAddress" class="form-label small">Address</label>
                      <input type="text" id="fieldAddress" class="form-control" maxlength="255"
                        placeholder="123 Main St, Albany NY" />
                    </div>

                    <%# Google Maps URL %>
                    <div class="col-12 col-md-6" id="mapsUrlWrap">
                      <label for="fieldMapsUrl" class="form-label small">Google Maps URL</label>
                      <div class="input-group">
                        <input type="url" id="fieldMapsUrl" class="form-control"
                          maxlength="500" placeholder="https://maps.google.com/…" />
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                          id="mapsPreviewBtn" title="Open in Google Maps" disabled>
                          <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </button>
                      </div>
                    </div>

                    <%# Lat / Lng %>
                    <div class="col-12 col-md-3" id="latWrap">
                      <label for="fieldLat" class="form-label small">Latitude</label>
                      <input type="number" id="fieldLat" class="form-control"
                        step="0.000001" placeholder="42.651813" />
                    </div>
                    <div class="col-12 col-md-3" id="lngWrap">
                      <label for="fieldLng" class="form-label small">Longitude</label>
                      <input type="number" id="fieldLng" class="form-control"
                        step="0.000001" placeholder="-73.754968" />
                    </div>

                  </div><%# /.row %>

                  <div id="formStatus" class="mt-3"></div>

                  <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-primary" id="saveBtn">
                      <i class="fa-solid fa-floppy-disk me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="cancelBtn">
                      Cancel
                    </button>
                  </div>
                </div>
              </div><%# /#formPanel %>

              <%# ── Locations table ── %>
              <% const locations = rows.filter(r => r.type === 'location'); %>
              <h2 class="tools-group-heading mt-2">
                <i class="fa-solid fa-location-dot me-2"></i>Locations
                <span class="badge bg-primary ms-2"><%= locations.length %></span>
              </h2>

              <% if (locations.length === 0) { %>
                <p class="text-muted small mb-4">No locations defined for <%= year %>.</p>
              <% } else { %>
                <div class="table-responsive mb-5">
                  <table class="table table-hover align-middle" id="locationsTable">
                    <thead class="table-light">
                      <tr>
                        <th>Name</th>
                        <th>Capacity</th>
                        <th>Address</th>
                        <th>Map</th>
                        <th>Status</th>
                        <th></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% locations.forEach(r => { %>
                        <tr data-id="<%= r.id %>"
                            data-type="location"
                            data-description="<%= r.description || '' %>"
                            data-capacity="<%= r.capacity != null ? r.capacity : '' %>"
                            data-address="<%= r.address || '' %>"
                            data-lat="<%= r.lat != null ? r.lat : '' %>"
                            data-lng="<%= r.lng != null ? r.lng : '' %>"
                            data-maps-url="<%= r.maps_url || '' %>"
                            data-active="<%= r.active ? 'true' : 'false' %>"
                            class="<%= !r.active ? 'table-secondary text-muted' : '' %>">
                          <td>
                            <strong><%= r.name %></strong>
                            <% if (r.description) { %>
                              <div class="text-muted small"><%= r.description %></div>
                            <% } %>
                          </td>
                          <td class="text-center">
                            <%= r.capacity != null ? r.capacity : '—' %>
                          </td>
                          <td class="small text-muted">
                            <%= r.address || '—' %>
                            <% if (r.lat && r.lng) { %>
                              <div class="text-muted loc-latlng-label">
                                <%= r.lat %>, <%= r.lng %>
                              </div>
                            <% } %>
                          </td>
                          <td>
                            <% if (r.maps_url) { %>
                              <a href="<%= r.maps_url %>" target="_blank" rel="noopener"
                                class="btn btn-outline-secondary btn-sm" title="Open in Google Maps">
                                <i class="fa-solid fa-map-location-dot"></i>
                              </a>
                            <% } else { %>
                              <span class="text-muted small">—</span>
                            <% } %>
                          </td>
                          <td>
                            <span class="badge <%= r.active ? 'bg-success' : 'bg-secondary' %>">
                              <%= r.active ? 'Active' : 'Inactive' %>
                            </span>
                          </td>
                          <td class="text-end">
                            <button type="button" class="btn btn-outline-primary btn-sm edit-btn"
                              data-id="<%= r.id %>">
                              <i class="fa-solid fa-pen"></i>
                            </button>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
              <div class="mt-3">
            <a href="/oversight/tools" class="btn btn-outline-secondary btn-sm">
              <i class="fa-solid fa-arrow-left me-1"></i>Back to Oversight Tools
            </a>
          </div>
              
            </div><%# /.card-body %>
          </section>

          

        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/locationsAndTasks.js"></script>
  </body>
</html>