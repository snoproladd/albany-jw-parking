<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Reset Link Sent</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/styles/fontawesome/css/all.css" />
    <link rel="stylesheet" type="text/css" href="/styles/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Georama:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-vh-100 d-flex justify-content-center align-items-center bg-body-tertiary entry-body">
    <main class="container body-container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 form-entry">

          <section id="upgrade-sent" class="card shadow-lg entry-card">
            <header class="card-header text-center">
              <h1 class="text-center mb-1">Reset Link Sent</h1>
            </header>

            <div class="card-body">
              <% if (message) { %>
                <div class="alert alert-success" role="alert">
                  <i class="fa-solid fa-check-circle me-2"></i>
                  <%= message %>
                </div>
              <% } %>

              <% if (errorMessage) { %>
                <div class="alert alert-danger" role="alert">
                  <i class="fa-solid fa-triangle-exclamation me-2"></i>
                  <%= errorMessage %>
                </div>
              <% } %>

              <p>
                We’ve sent a link to
                <% if (method === "email") { %>
                  your email address: <strong><%= maskedEmail %></strong>.
                <% } else if (method === "phone") { %>
                  your phone number: <strong><%= maskedPhone %></strong>.
                <% } else { %>
                  the contact information on file.
                <% } %>
              </p>

              <p class="mb-3">
                If you don’t see the message within a few minutes, please check your
                <strong>Junk</strong> or <strong>Spam</strong> folder. If you still
                don’t see it, you can resend the link below.
              </p>

              <form action="/upgrade/resend" method="POST" class="mt-3">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="id" value="<%= volunteer.id %>" />
                <input type="hidden" name="method" value="<%= method %>" />

                <button type="submit" class="btn btn-outline-primary w-100">
                  Resend Link
                </button>
              </form>
            </div>
          </section>

        </div>
      </div>
    </main>

    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
